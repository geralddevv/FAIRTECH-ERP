<% layout('/layout/boilerplate') -%>

<!-- ================= TABULATOR CSS ================= -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<!-- Form style (formStyle.md) for the Add / Edit Loan dialogs; href comes from FORM_STYLE_CSS via the route. -->
<link href="<%= formStyleHref %>" rel="stylesheet" />

<style>
  .loan-highlight {
    padding: 0.25rem 0.6rem;
    border-radius: 0.35rem;
    font-weight: 600;
    font-size: 1.15rem;

    /* IMPORTANT FIX */
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.12);
  }

  /* status variations — still subtle */
  .loan-highlight.active {
    background-color: rgba(255, 255, 255, 0.16);
  }

  .loan-highlight.closed {
    background-color: rgba(40, 167, 69, 0.25);
    border-color: rgba(40, 167, 69, 0.8);
  }

  .loan-highlight.overdue {
    background-color: rgba(220, 53, 69, 0.25);
    border-color: rgba(220, 53, 69, 0.8);
  }
  #master-table {
    width: 100%;
    flex: 1 1 auto;
    min-height: 0;
  }

</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <span style="display: flex; align-items: center; gap: 10px">
      <button
        id="backToSnapshot"
        style="
          display: none;
          background-color: transparent;
          padding: 2px 14px;
          border: 1px solid #f0f0f0;
          border-radius: 0.3rem;
          font-weight: 500;
          cursor: pointer;
        "
      >
        <i class="fa-solid fa-arrow-left" style="color: #ffffff"></i>
      </button>
      <h1 id="loanHeading">Loans</h1>
    </span>

    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <button
        type="button"
        onclick="openLoanCreateDialog()"
        class="header-action-btn"
        style="
          height: 30px;
          padding: 0 14px;
          background: #f0f0f0;
          color: #044a78;
          border-radius: 6px;
          border: none;
          cursor: pointer;
          font-size: 14px;
          font-weight: 500;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          transition: all 0.2s;
          box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        "
      >
        <i class="fa-solid fa-plus"></i>
        <span>Add Loan</span>
      </button>

      <button
        type="button"
        id="openDeductLoanDialog"
        class="header-action-btn"
        style="
          height: 30px;
          padding: 0 14px;
          background: #f0f0f0;
          color: #044a78;
          border: none;
          border-radius: 6px;
          font-size: 14px;
          font-weight: 500;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          transition: all 0.2s;
          box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
          cursor: pointer;
        "
      >
        <i class="fa-solid fa-minus"></i>
        <span>Deduct Loan</span>
      </button>

      <a
        href="/fairtech/loan/logs"
        style="
          height: 30px;
          padding: 0 14px;
          background: #044a78;
          color: white;
          border-radius: 6px;
          text-decoration: none;
          font-size: 14px;
          font-weight: 500;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          transition: opacity 0.2s;
        "
        onmouseover="this.style.opacity = '0.85'"
        onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>View Logs</span>
      </a>

      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger" style="height: 30px; display: flex; align-items: center; padding: 0 12px; border: 1.5px solid #e2e8f0; border-radius: 6px; background: #fff; font-size: 14px; font-weight: 500; cursor: pointer;">
          <span> <i class="fa-solid fa-file-arrow-down"></i> Download </span>
          <i class="fas fa-chevron-down" style="font-size: 12px; margin-left: 6px;"></i>
        </button>

        <div class="download-selector__menu">
          <div class="download-selector__option" id="download-pdf"><i class="fas fa-file-pdf"></i> PDF</div>
          <div class="download-selector__option" id="download-xlsx"><i class="fas fa-file-excel"></i> Excel</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table"></div>
</div>

<!-- ===== ADD LOAN DIALOG (formStyle.md, Dialogs; behaviour: /js/soFormDialog.js) ===== -->
<div id="loan-create-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="loan-create-form" class="so-dialog so-dialog--lg" method="post" action="/fairtech/loan/create" autocomplete="off" novalidate data-so-form role="dialog" aria-modal="true" aria-labelledby="loan-create-title">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-plus"></i></span>
      <div>
        <h3 class="so-dialog__title" id="loan-create-title">Add Loan</h3>
        <p class="so-dialog__desc">Issue a loan to an employee. An existing balance is topped up and the EMI replaced.</p>
      </div>
    </div>

    <div class="so-dialog__body">
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="loan-emp-id">Employee ID</label>
          <input type="text" id="loan-emp-id" placeholder="Auto from employee" readonly tabindex="-1" />
        </div>
        <div class="so-dialog__field">
          <label for="loan-employee">Employee Name <span class="so-req">*</span></label>
          <select id="loan-employee" name="employeeId" required>
            <option value="" disabled selected hidden>Select Employee</option>
            <% employees.forEach(emp => { %>
              <option value="<%= emp._id %>"><%= emp.empName %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="so-dialog__field">
        <label for="loan-balance">Current Balance</label>
        <input type="number" id="loan-balance" value="0" readonly tabindex="-1" />
      </div>

      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="loan-date">Date <span class="so-req">*</span></label>
          <input type="date" id="loan-date" name="loanDate" required />
        </div>
        <div class="so-dialog__field">
          <label for="loan-amount">Loan Amount (₹) <span class="so-req">*</span></label>
          <input type="number" id="loan-amount" name="loanAmount" min="1" step="any" placeholder="Enter Loan Amount" required />
        </div>
        <div class="so-dialog__field">
          <label for="loan-emi">EMI Amount (₹) <span class="so-req">*</span></label>
          <input type="number" id="loan-emi" name="emi" min="1" step="any" placeholder="Enter EMI Amount" required />
        </div>
      </div>

      <div class="so-dialog__field">
        <label for="loan-reason">Reason</label>
        <input type="text" id="loan-reason" name="reason" placeholder="Optional" />
      </div>
    </div>

    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('loan-create-dialog')">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Save Loan</button>
    </div>
  </form>
</div>

<!-- ===== EDIT LOAN ENTRY DIALOG (formStyle.md, Dialogs; opened/closed by /js/soFormDialog.js) ===== -->
<div id="loan-edit-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="loan-edit-form" class="so-dialog" autocomplete="off" novalidate role="dialog" aria-modal="true" aria-labelledby="loan-edit-title">
    <input type="hidden" id="loan-edit-id" />

    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-pen-to-square"></i></span>
      <div>
        <h3 class="so-dialog__title" id="loan-edit-title">Edit Loan Entry</h3>
        <p class="so-dialog__desc">Only manual issue and top-up entries are editable. EMI and payroll deductions stay unchanged.</p>
      </div>
    </div>

    <div class="so-dialog__body">
      <div class="so-dialog__field">
        <label for="loan-edit-amount">Amount (₹) <span class="so-req">*</span></label>
        <input type="number" id="loan-edit-amount" min="1" step="any" required />
      </div>
    </div>

    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="closeLoanEditDialog()">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary" id="loan-edit-save"><i class="fa-solid fa-check"></i> Save Changes</button>
    </div>
  </form>
</div>
<script src="/js/soFormDialog.js?v=1"></script>

<div
  id="loan-delete-dialog"
  style="
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  "
>
  <div style="background: #fff; width: 430px; max-width: 92vw; border-radius: 10px; padding: 18px 20px">
    <h3 style="margin: 0 0 10px; color: #b91c1c; font-size: 17px">
      <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px"></i>Delete Loan Entry
    </h3>
    <p style="margin: 0 0 14px; color: #374151">Are you sure you want to delete this manual loan entry?</p>
    <input type="hidden" id="loan-delete-id" />
    <div style="display: flex; justify-content: flex-end; gap: 10px">
      <button
        type="button"
        onclick="closeLoanDeleteDialog()"
        style="
          padding: 8px 16px;
          border: 1px solid #d1d5db;
          background: white;
          color: #374151;
          border-radius: 6px;
          cursor: pointer;
        "
      >
        Cancel
      </button>
      <button
        type="button"
        onclick="submitLoanDelete()"
        style="padding: 8px 16px; border: none; background: #ef4444; color: white; border-radius: 6px; cursor: pointer"
      >
        Yes, Delete
      </button>
    </div>
  </div>
</div>

<!-- ===== DEDUCT LOAN DIALOG (formStyle.md, Dialogs; opened/closed by /js/soFormDialog.js) ===== -->
<div id="loan-deduct-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="loan-deduct-form" class="so-dialog" autocomplete="off" novalidate role="dialog" aria-modal="true" aria-labelledby="loan-deduct-title">
    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-minus"></i></span>
      <div>
        <h3 class="so-dialog__title" id="loan-deduct-title">Deduct Loan</h3>
        <p class="so-dialog__desc">Record a missed EMI for a past payroll month.</p>
      </div>
    </div>

    <div class="so-dialog__body">
      <p style="margin-bottom: 14px">
        Use this when a payroll was run without deducting that month's loan EMI. It records the missed deduction
        against the month you pick and recalculates the pending balance &mdash; it shows in Loan Logs like a normal
        EMI deduction for that month.
      </p>

      <div class="so-dialog__field">
        <label for="deduct-loan-employee">Employee <span class="so-req">*</span></label>
        <select id="deduct-loan-employee" required></select>
      </div>

      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="deduct-loan-month">Month <span class="so-req">*</span></label>
          <select id="deduct-loan-month" required>
            <% const dlMonths = [
              { name: "Jan", value: 1 }, { name: "Feb", value: 2 }, { name: "Mar", value: 3 },
              { name: "Apr", value: 4 }, { name: "May", value: 5 }, { name: "Jun", value: 6 },
              { name: "Jul", value: 7 }, { name: "Aug", value: 8 }, { name: "Sep", value: 9 },
              { name: "Oct", value: 10 }, { name: "Nov", value: 11 }, { name: "Dec", value: 12 }
            ]; %>
            <% dlMonths.forEach(m => { %>
              <option value="<%= m.value %>"><%= m.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="so-dialog__field">
          <label for="deduct-loan-year">Year <span class="so-req">*</span></label>
          <select id="deduct-loan-year" required>
            <% const dlCurrentYear = new Date().getFullYear();
               const dlYearOptions = [];
               for (let y = dlCurrentYear - 5; y <= dlCurrentYear + 1; y++) dlYearOptions.push(y); %>
            <% dlYearOptions.forEach(y => { %>
              <option value="<%= y %>" <%= y === dlCurrentYear ? 'selected' : '' %>><%= y %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="so-dialog__field">
        <label for="deduct-loan-amount">Amount (₹) <span class="so-req">*</span></label>
        <input type="number" id="deduct-loan-amount" min="1" step="any" required />
        <div id="deduct-loan-balance-hint" style="font-size: 12px; color: #475569; margin-top: 6px"></div>
      </div>
    </div>

    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="closeDeductLoanDialog()">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary" id="deduct-loan-save"><i class="fa-solid fa-check"></i> Deduct</button>
    </div>
  </form>
</div>

<!-- ================= SCRIPTS ================= -->

<!-- Tabulator -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<!-- PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>

<!-- Excel -->
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script>
    /* ===== Dropdown ===== */
    const downloadSelector = document.getElementById("downloadSelector");
    const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");

    triggerBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      downloadSelector.classList.toggle("download-selector--active");
    });

    document.addEventListener("click", () => {
      downloadSelector.classList.remove("download-selector--active");
    });

    downloadSelector
      .querySelector(".download-selector__menu")
      .addEventListener("click", (e) => e.stopPropagation());

    /* ===== Table ===== */
    const tableData = <%- safeJson(jsonData) %>;
    const snapshotData = [...tableData];
    let currentEmployeeId = null;
    const loanHeadingEl = document.getElementById("loanHeading");

    function formatINRCurrency(value) {
      return new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      }).format(Number(value) || 0);
    }

    function getTotalLoanOutstanding() {
      return (snapshotData || []).reduce((sum, row) => sum + (Number(row.currentBalance) || 0), 0);
    }

    function setLoanSnapshotHeading() {
      const total = getTotalLoanOutstanding();
      loanHeadingEl.innerHTML = `Loans <span class="loan-highlight active" style="margin-left: 8px;">Total: ${formatINRCurrency(total)}</span>`;
    }

    const baseColumns = [
      srNoColumn(),
      { title: "Employee ID", field: "empId", headerFilter: "input", headerFilterPlaceholder: "Search" },
      {
        title: "Employee Name",
        field: "employeeName",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        formatter: function (cell) {
          const data = cell.getRow().getData();

          return `
            <div
              class="emp-link"
              data-id="${data.employeeId}"
              style="
                width:100%;
                height:100%;
                cursor:pointer;
                font-weight:600;
                text-decoration:underline;
                display:flex;
                align-items:center;
              "
              title="${data.employeeName}"
            >
              ${data.employeeName}
            </div>
          `;
        }
      },
      {
        title: "Outstanding",
        field: "currentBalance",
        formatter: (c) => formatINRCurrency(c.getValue()),
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
      },
      {
        title: "EMI",
        field: "emi",
        formatter: (c) => formatINRCurrency(c.getValue()),
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
      },
      { title: "Status", field: "status", headerFilter: "input", headerFilterPlaceholder: "Search" },
      { title: "Last Updated", field: "updatedAt", headerFilter: "input", headerFilterPlaceholder: "Search" },
    ];

    const logColumns = [
      srNoColumn(),
      { title: "Date", field: "date" },
      { title: "Employee ID", field: "empId" },
      { title: "Employee Name", field: "employeeName" },
      { title: "Type", field: "type" },
      { title: "Source", field: "source" },
      { title: "Opening Balance", field: "openingBalance", formatter: (c) => formatINRCurrency(c.getValue()) },

      {
        title: "Action",
        formatter: function (cell) {
          const row = cell.getRow().getData();

          if (row.type === "CREDIT" && row.source === "MANUAL") {
            return row.openingBalance === 0 ? "INITIAL LOAN" : "LOAN TOP-UP";
          }

          if (row.type === "DEBIT" && row.source === "MANUAL") {
            return "LOAN CLOSE";
          }

          if (row.type === "DEBIT" && row.source === "PAYROLL") {
            return "EMI DEDUCTION";
          }

          return "-";
        },
        width: 150,
      },

      {
        title: "Amount",
        field: "amount",
        formatter: function (cell) {
          const row = cell.getRow().getData();

          if (row.type === "DEBIT") {
            return `- ${formatINRCurrency(cell.getValue())}`;
          }

          return `+ ${formatINRCurrency(cell.getValue())}`;
        },
      },

      { title: "Closing Balance", field: "closingBalance", formatter: (c) => formatINRCurrency(c.getValue()) },
      {
        title: "Actions",
        width: 90,
        hozAlign: "center",
        headerHozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.canEdit) return "-";

          return `<button class="loan-log-btn loan-log-edit" title="Edit" style="height:20px; width:28px; padding:0; margin-right:6px; border:1px solid #d1d5db; background:#fff; border-radius:4px; cursor:pointer; line-height:1;">
              <i class="fa-solid fa-pen-to-square" style="font-size:11px; color:#044A78;"></i>
            </button>
            <button class="loan-log-btn loan-log-delete" title="Delete" style="height:20px; width:28px; padding:0; border:1px solid #fca5a5; background:#fee2e2; border-radius:4px; cursor:pointer; line-height:1;">
              <i class="fa-solid fa-trash" style="font-size:11px; color:#b91c1c;"></i>
            </button>`;
        },
        cellClick: (e, cell) => {
          const row = cell.getRow().getData();
          if (!row.canEdit) return;
          if (e.target.closest(".loan-log-edit")) openLoanEditDialog(row);
          if (e.target.closest(".loan-log-delete")) openLoanDeleteDialog(row);
        },
      },
    ];


    const table = new Tabulator("#master-table", {
      data: tableData,
      height: "100%",

      // layout: "fitColumns",
      columnMinWidth: 120,
      resizableColumns: true,
      movableColumns: true,

      columns: baseColumns,
    });

    document.addEventListener("click", async (e) => {
    if (!e.target.classList.contains("emp-link")) return;

    const employeeId = e.target.dataset.id;
    currentEmployeeId = employeeId;

    const res = await fetch(`/fairtech/loan/employee/${employeeId}/logs`);
    const { history, summary } = await res.json();

    if (!history.length) return;

    table.setColumns(logColumns);
    table.replaceData(history);

    const statusClass = summary.status.toLowerCase();

  loanHeadingEl.innerHTML =
    `Loans — Outstanding:
     <span class="loan-highlight ${statusClass}">
       ${formatINRCurrency(summary.currentBalance)} (${summary.status})
     </span>`;


    document.getElementById("backToSnapshot").style.display = "inline-flex";
  });

    document
    .getElementById("backToSnapshot")
    .addEventListener("click", () => {
      table.setColumns(baseColumns);
      table.replaceData(snapshotData);

      setLoanSnapshotHeading();
      document.getElementById("backToSnapshot").style.display = "none";
      currentEmployeeId = null;
    });

    /* ===== Downloads ===== */
    document.getElementById("download-pdf").addEventListener("click", () => {
      table.download("pdf", "loan-data.pdf", {
        orientation: "landscape",
        title: "Loan Data",
      });
      downloadSelector.classList.remove("download-selector--active");
    });

    document.getElementById("download-xlsx").addEventListener("click", () => {
      table.download("xlsx", "loan-data.xlsx", {
        sheetName: "Loans",
      });
      downloadSelector.classList.remove("download-selector--active");
    });

    const loanDeleteDialog = document.getElementById("loan-delete-dialog");

    function openLoanEditDialog(row) {
      document.getElementById("loan-edit-id").value = row._id;
      document.getElementById("loan-edit-amount").value = row.amount;
      document.getElementById("loan-edit-amount").classList.remove("so-invalid");
      soDialog.open("loan-edit-dialog");
    }

    function closeLoanEditDialog() {
      soDialog.close("loan-edit-dialog");
    }

    /* ===== Add Loan dialog ===== */
    const loanEmployeeSelect = document.getElementById("loan-employee");
    const loanEmpIdInput = document.getElementById("loan-emp-id");
    const loanBalanceInput = document.getElementById("loan-balance");

    function openLoanCreateDialog() {
      soDialog.open("loan-create-dialog"); // resets the form to its rendered defaults
      const now = new Date();
      const mm = String(now.getMonth() + 1).padStart(2, "0");
      const dd = String(now.getDate()).padStart(2, "0");
      document.getElementById("loan-date").value = `${now.getFullYear()}-${mm}-${dd}`;
    }

    loanEmployeeSelect.addEventListener("change", async (e) => {
      const empId = e.target.value;
      loanEmpIdInput.value = "";
      loanBalanceInput.value = 0;
      if (!empId) return;

      try {
        const [empRes, loanRes] = await Promise.all([
          fetch(`/fairtech/payroll/employee/${empId}`),
          fetch(`/fairtech/payroll/loan/${empId}`),
        ]);
        if (empRes.ok) loanEmpIdInput.value = (await empRes.json()).empId || "";
        if (loanRes.ok) loanBalanceInput.value = (await loanRes.json())?.currentBalance ?? 0;
      } catch (err) {
        console.error(err);
      }
    });

    // The old page's EMI check. Captured on the backdrop so it runs before
    // soFormDialog's own submit handler and can stop the send.
    document.getElementById("loan-create-dialog").addEventListener(
      "submit",
      (e) => {
        const loanEl = document.getElementById("loan-amount");
        const emiEl = document.getElementById("loan-emi");
        const loanAmount = Number(loanEl.value);
        const emiAmount = Number(emiEl.value);
        const fail = (el, message) => {
          e.preventDefault();
          e.stopPropagation();
          el.classList.add("so-invalid");
          el.focus();
          showToast(message, true);
        };
        if (!loanEl.value.trim() || !emiEl.value.trim()) return; // soFormDialog reports blanks
        if (loanAmount <= 0) return fail(loanEl, "Loan amount must be greater than 0.");
        if (emiAmount <= 0) return fail(emiEl, "EMI amount must be greater than 0.");
        if (emiAmount > loanAmount) return fail(emiEl, "EMI amount cannot be greater than loan amount.");
      },
      true,
    );

    function openLoanDeleteDialog(row) {
      document.getElementById("loan-delete-id").value = row._id;
      loanDeleteDialog.style.display = "flex";
    }

    function closeLoanDeleteDialog() {
      loanDeleteDialog.style.display = "none";
    }

    /* ===== Deduct Loan (missed EMI for a past month) ===== */

    function activeLoanEmployees() {
      return (snapshotData || []).filter((row) => row.status === "ACTIVE");
    }

    function updateDeductLoanHint() {
      const sel = document.getElementById("deduct-loan-employee");
      const opt = sel.options[sel.selectedIndex];
      const hintEl = document.getElementById("deduct-loan-balance-hint");

      // No employee picked yet (still on the placeholder option) — leave the
      // amount blank and the hint empty instead of showing whichever
      // employee happens to be first in the list, which read as a bogus
      // "everyone has this same outstanding balance" default.
      if (!opt || !opt.value) {
        document.getElementById("deduct-loan-amount").value = "";
        hintEl.textContent = "";
        return;
      }

      const emi = Number(opt.dataset.emi) || 0;
      const balance = Number(opt.dataset.balance) || 0;

      document.getElementById("deduct-loan-amount").value = emi || "";
      hintEl.textContent = `Outstanding balance: ${formatINRCurrency(balance)}`;
    }

    function openDeductLoanDialog() {
      const employees = activeLoanEmployees();
      if (!employees.length) {
        showToast("No employees with an active loan balance.", true);
        return;
      }

      const sel = document.getElementById("deduct-loan-employee");
      sel.innerHTML =
        `<option value="" disabled selected hidden>Select Employee</option>` +
        employees
          .map(
            (e) =>
              `<option value="${e.employeeId}" data-emi="${e.emi}" data-balance="${e.currentBalance}">${e.employeeName} (${e.empId})</option>`,
          )
          .join("");
      sel.onchange = updateDeductLoanHint;

      soDialog.open("loan-deduct-dialog"); // resets the form to its rendered defaults
      document.querySelectorAll("#loan-deduct-form .so-invalid").forEach((el) => el.classList.remove("so-invalid"));

      // Default to last month, matching the Payroll form's own convention.
      const lastMonthDate = new Date();
      lastMonthDate.setDate(1);
      lastMonthDate.setMonth(lastMonthDate.getMonth() - 1);
      document.getElementById("deduct-loan-month").value = String(lastMonthDate.getMonth() + 1);
      document.getElementById("deduct-loan-year").value = String(lastMonthDate.getFullYear());

      updateDeductLoanHint();
    }

    function closeDeductLoanDialog() {
      soDialog.close("loan-deduct-dialog");
    }

    // A POST that answers with a summary (not a redirect), so this form doesn't
    // use soFormDialog's data-so-form submit.
    const loanDeductForm = document.getElementById("loan-deduct-form");
    loanDeductForm.addEventListener("submit", (e) => {
      e.preventDefault();
      submitDeductLoan();
    });
    const loanDeductClearInvalid = (e) => e.target.classList.remove("so-invalid");
    loanDeductForm.addEventListener("input", loanDeductClearInvalid);
    loanDeductForm.addEventListener("change", loanDeductClearInvalid);

    async function submitDeductLoan() {
      const employeeEl = document.getElementById("deduct-loan-employee");
      const amountEl = document.getElementById("deduct-loan-amount");
      const employeeId = employeeEl.value;
      const month = Number(document.getElementById("deduct-loan-month").value);
      const year = Number(document.getElementById("deduct-loan-year").value);
      const amount = Number(amountEl.value);

      if (!employeeId) {
        employeeEl.classList.add("so-invalid");
        employeeEl.focus();
        showToast("Please select an employee.", true);
        return;
      }
      if (!(amount > 0)) {
        amountEl.classList.add("so-invalid");
        amountEl.focus();
        showToast("Please enter a valid amount.", true);
        return;
      }

      const saveBtn = document.getElementById("deduct-loan-save");
      const saveHtml = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
      try {
        const res = await fetch("/fairtech/loan/deduct-missed", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ employeeId, month, year, amount }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          showToast(data.message || "Failed to record loan deduction.", true);
          saveBtn.disabled = false;
          saveBtn.innerHTML = saveHtml;
          return;
        }

        const row = snapshotData.find((item) => String(item.employeeId) === String(employeeId));
        if (row) {
          row.currentBalance = data.summary.currentBalance;
          row.status = data.summary.status;
          row.updatedAt = new Date(data.summary.updatedAt || Date.now()).toLocaleDateString();
        }

        if (String(currentEmployeeId) === String(employeeId)) {
          await refreshLoanLogs();
        } else if (!currentEmployeeId) {
          table.replaceData(snapshotData);
          setLoanSnapshotHeading();
        }

        closeDeductLoanDialog();
      } catch (err) {
        console.error(err);
        showToast("Failed to record loan deduction.", true);
      }
      saveBtn.disabled = false;
      saveBtn.innerHTML = saveHtml;
    }

    document.getElementById("openDeductLoanDialog").addEventListener("click", openDeductLoanDialog);

    function updateLoanSnapshot(summary) {
      const row = snapshotData.find((item) => String(item.employeeId) === String(currentEmployeeId));
      if (!row) return;
      row.currentBalance = summary.currentBalance;
      row.status = summary.status;
      row.updatedAt = new Date(summary.updatedAt || Date.now()).toLocaleDateString();
    }

    async function refreshLoanLogs() {
      if (!currentEmployeeId) return;

      const res = await fetch(`/fairtech/loan/employee/${currentEmployeeId}/logs`);
      const data = await res.json();
      table.replaceData(data.history || []);

      const summary = data.summary || { currentBalance: 0, status: "CLOSED" };
      const statusClass = summary.status.toLowerCase();
      loanHeadingEl.innerHTML =
        `Loans - Outstanding:
         <span class="loan-highlight ${statusClass}">
           ${formatINRCurrency(summary.currentBalance)} (${summary.status})
         </span>`;
    }

    // PATCH, not a POST, so this form doesn't use soFormDialog's data-so-form submit.
    const loanEditForm = document.getElementById("loan-edit-form");
    loanEditForm.addEventListener("submit", (e) => {
      e.preventDefault();
      submitLoanEdit();
    });
    loanEditForm.addEventListener("input", (e) => e.target.classList.remove("so-invalid"));

    async function submitLoanEdit() {
      const id = document.getElementById("loan-edit-id").value;
      const amountEl = document.getElementById("loan-edit-amount");
      const amount = Number(amountEl.value);

      if (!id || !(amount > 0)) {
        amountEl.classList.add("so-invalid");
        amountEl.focus();
        showToast("Please enter a valid amount.", true);
        return;
      }

      const saveBtn = document.getElementById("loan-edit-save");
      const saveHtml = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
      try {
        const res = await fetch(`/fairtech/loan/logs/${id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ amount }),
        });
        const data = await res.json();
        if (!res.ok) {
          showToast(data.message || "Failed to update loan entry.", true);
        } else {
          updateLoanSnapshot(data.summary);
          await refreshLoanLogs();
          closeLoanEditDialog();
        }
      } catch (err) {
        console.error(err);
        showToast("Failed to update loan entry.", true);
      }
      saveBtn.disabled = false;
      saveBtn.innerHTML = saveHtml;
    }

    async function submitLoanDelete() {
      const id = document.getElementById("loan-delete-id").value;
      if (!id) return;

      try {
        const res = await fetch(`/fairtech/loan/logs/${id}`, {
          method: "DELETE",
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.message || "Failed to delete loan entry.");
          return;
        }

        updateLoanSnapshot(data.summary);
        await refreshLoanLogs();
        closeLoanDeleteDialog();
      } catch (err) {
        console.error(err);
        alert("Failed to delete loan entry.");
      }
    }
    setLoanSnapshotHeading();
</script>
