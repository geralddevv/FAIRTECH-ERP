<% layout('/layout/boilerplate') -%>
<%#
  Edit Vendor Coordinator -- the same card as the New Vendor dialog's
  Coordinator tab (_vendorForm.ejs), drawn as a page for anyone who lands on
  the URL (formStyle.md, "The same card as a page"). Vendor details are shown
  read-only (the route re-reads them from the Vendor Master on save).
  Behaviour: public/js/soFormDialog.js (validation + fetch submit) and
  public/js/vendorLocations.js (location repeater).
%>
<%
  const vendorSource = typeof vendor !== "undefined" && vendor ? vendor : user;
  const initialLocationDetails = typeof locals.initialLocationDetails !== "undefined" && Array.isArray(locals.initialLocationDetails) && locals.initialLocationDetails.length
    ? locals.initialLocationDetails
    : (Array.isArray(user.locationDetails) && user.locationDetails.length
      ? user.locationDetails
      : [{ userLocation: user.userLocation || "", dispatchAddress: user.dispatchAddress || "" }]);
  const statuses = ["ACTIVE", "INACTIVE", "BLACKLISTED", "OTHERS"];
%>
<%- include('./_vendorLocationStyles') %>

<div class="so-dialog-page">
  <form id="vendor-user-edit-form" class="so-dialog so-dialog--xl" action="/fairtech/form/edit/vendor-user/<%= user._id %>" method="post" autocomplete="off" novalidate data-so-form>
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-pen"></i></span>
      <div>
        <h3 class="so-dialog__title">Edit Vendor Coordinator</h3>
        <p class="so-dialog__desc">Vendor details come from the Vendor Master.</p>
      </div>
    </div>

    <div class="so-dialog__body">
      <div class="so-dialog__section">Vendor Information</div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="userform-vendor-name">Vendor Name</label>
          <input type="text" id="userform-vendor-name" value="<%= vendorSource.vendorName %>" readonly tabindex="-1" />
        </div>
        <div class="so-dialog__field">
          <label for="user-vendor-id">Vendor Id</label>
          <input type="text" id="user-vendor-id" value="<%= vendorSource.vendorId %>" readonly tabindex="-1" />
        </div>
        <div class="so-dialog__field">
          <label for="coordinator-vendor-status">Vendor Status</label>
          <select id="coordinator-vendor-status" disabled>
            <% statuses.forEach((st) => { %>
              <option value="<%= st %>" <%= vendorSource.vendorStatus === st ? "selected" : "" %>><%= st %></option>
            <% }) %>
            <% if (vendorSource.vendorStatus && !statuses.includes(vendorSource.vendorStatus)) { %>
              <option value="<%= vendorSource.vendorStatus %>" selected><%= vendorSource.vendorStatus %></option>
            <% } %>
          </select>
        </div>
        <div class="so-dialog__field">
          <label for="coordinator-ho-location">H/O Location</label>
          <input type="text" id="coordinator-ho-location" value="<%= vendorSource.hoLocation %>" readonly tabindex="-1" />
        </div>
        <div class="so-dialog__field">
          <label for="coordinator-warehouse-location">Warehouse Location</label>
          <input type="text" id="coordinator-warehouse-location" value="<%= vendorSource.warehouseLocation %>" readonly tabindex="-1" />
        </div>
      </div>

      <div class="so-dialog__section">Coordinator Information</div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="user-name">Coordinator Name <span class="so-req">*</span></label>
          <input type="text" id="user-name" name="userName" value="<%= user.userName %>" oninput="this.value = this.value.toUpperCase()" required data-so-autofocus />
        </div>
        <div class="so-dialog__field">
          <label for="user-location">Location <span class="so-req">*</span></label>
          <input type="text" id="user-location" name="userLocation" value="<%= user.userLocation %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
        <div class="so-dialog__field">
          <label for="user-department">Department <span class="so-req">*</span></label>
          <input type="text" id="user-department" name="userDepartment" value="<%= user.userDepartment %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
        <div class="so-dialog__field">
          <label for="user-contact-no">Contact No <span class="so-req">*</span></label>
          <input type="text" id="user-contact-no" name="userContact" value="<%= user.userContact %>" required />
        </div>
        <div class="so-dialog__field">
          <label for="user-email">Email <span class="so-req">*</span></label>
          <input type="email" id="user-email" name="userEmail" value="<%= user.userEmail %>" required />
        </div>
      </div>

      <div class="so-dialog__section so-dialog__section--row">
        <span>Location Details</span>
        <div class="loc-counter">
          <button type="button" id="locations-minus" aria-label="Remove a location">&minus;</button>
          <input type="text" id="locations-count" name="locationsCount" value="<%= initialLocationDetails.length %>" readonly />
          <button type="button" id="locations-plus" aria-label="Add a location">+</button>
        </div>
      </div>
      <div style="font-size: 12px; color: var(--so-faint); margin: -4px 0 10px;">
        Each location has its own pick up details. Choose Transport or Self Pick Up per location.
      </div>
      <div id="locations-details" class="locations-details">
        <% initialLocationDetails.forEach((loc, index) => { %>
          <%- include('./_vendorLocationRow', { index, loc }) %>
        <% }) %>
      </div>
    </div>

    <div class="so-dialog__foot">
      <a class="so-btn so-btn--ghost" href="/fairtech/vendor/coordinator/details/<%= user._id %>">Cancel</a>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update Coordinator Details</button>
    </div>
  </form>
</div>

<script src="/js/vendorLocations.js?v=1"></script>
<script>
  window.formatVendorMobileInput(document.getElementById("user-contact-no"));
  window.initVendorLocationRepeater({
    countInput: document.getElementById("locations-count"),
    container: document.getElementById("locations-details"),
    minusBtn: document.getElementById("locations-minus"),
    plusBtn: document.getElementById("locations-plus"),
  });
</script>
<script src="/js/soFormDialog.js?v=1"></script>
