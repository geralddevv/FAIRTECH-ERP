<!-- Link to boilerplate.ejs -->
<% layout('/layout/boilerplate') -%>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<!-- Form style (formStyle.md) for the New Client dialog. Linked here rather
     than through the route's CSS param, which already carries tableDisp.css;
     the href (with its ?v=) comes from FORM_STYLE_CSS in the route. -->
<link href="<%= formStyleHref %>" rel="stylesheet" />

<body>
  <div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
    <style>
      .header-action-btn {
        background-color: #f0f0f0;
        color: #044a78;
        padding: 2px 14px; /* Matches Download button padding exactly */
        font-size: 14px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .header-action-btn:hover {
        background-color: #e4e4e4;
      }
      .col-count-center .tabulator-col-content {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 3px;
        padding: 4px 2px 6px;
      }
      .tabulator .tabulator-header .tabulator-col.col-count-center {
        justify-content: center;
      }
      .col-count-center .tabulator-col-title-holder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: auto;
        width: 100%;
      }
      .col-count-center .tabulator-col-title {
        width: 100%;
        text-align: center;
        white-space: nowrap;
        line-height: 1.1;
      }
      .col-count-center .tabulator-header-filter {
        width: 100%;
        margin-top: 0;
      }
      .col-count-center .tabulator-header-filter input {
        width: 100%;
        box-sizing: border-box;
      }
      .tabulator-cell.col-count-center {
        text-align: center;
        vertical-align: middle;
      }
      #master-table {
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        scroll-behavior: auto !important; /* Prevent smooth scroll on init */
      }
      #master-table.tabulator .tabulator-tableholder {
        scroll-behavior: auto !important;
      }
      #master-table .tabulator-row.row-missing-details .tabulator-cell {
        background-color: #d9534f !important;
        color: #ffffff !important;
      }
      #master-table .tabulator-row.row-missing-details:hover .tabulator-cell {
        background-color: #c9302c !important;
        color: #ffffff !important;
      }
      /* Same expandable-row treatment as the Vendor Coordinator screen:
         clients with more than one user stay as one row until expanded. */
      .tabulator-data-tree-control {
        width: 20px !important;
        height: 20px !important;
        border: none !important;
        border-radius: 4px !important;
        background: rgba(4, 74, 120, 0.1) !important;
        box-shadow: none !important;
        outline: none !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
      }
      .tabulator-data-tree-control:hover {
        background: rgba(4, 74, 120, 0.18) !important;
      }
      .tabulator-data-tree-control-expand,
      .tabulator-data-tree-control-collapse {
        width: auto !important;
        height: auto !important;
        background: none !important;
        border: none !important;
      }
      .tabulator-data-tree-control-expand::before,
      .tabulator-data-tree-control-collapse::before {
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        content: "\f054";
        font-size: 11px;
        line-height: 1;
        color: #044a78;
        display: inline-block;
        transition: transform 0.2s ease;
      }
      .tabulator-data-tree-control-collapse::before {
        transform: rotate(90deg);
      }
      .tabulator-data-tree-control-expand::after,
      .tabulator-data-tree-control-collapse::after {
        content: none !important;
        display: none !important;
      }
      /* Child rows use the explicit ↳ marker in the toggle column below.
         Hide Tabulator's default L-shaped tree branch so it does not render
         as the ⎿-style connector beside it. */
      #master-table .tabulator-data-tree-branch,
      #master-table .tabulator-data-tree-branch-empty {
        display: none !important;
      }
    </style>

    <div class="indi-head">
      <h1>Client Details</h1>

      <div style="display: flex; gap: 10px; align-items: center">
        <% /* Sales (the restricted field-rep role) can view clients but not create them. */ %>
        <% if (!(authUser && authUser.role === "sales")) { %>
        <button type="button" class="header-action-btn" onclick="openClientFormDialog('user')">
          <i class="fa-solid fa-plus" style="margin-right: 4px"></i> User
        </button>
        <button type="button" class="header-action-btn" onclick="openClientFormDialog('client')">
          <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Client
        </button>
        <% } %>

        <div class="download-selector" id="downloadSelector">
          <button class="download-selector__trigger">
            <span>
              <i class="fa-solid fa-file-arrow-down"></i>
              <span class="download-typo">Download</span>
            </span>
            <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
          </button>
          <div class="download-selector__menu" id="downloads">
            <span class="download-selector__option" id="download-pdf">
              <i class="fas fa-file-pdf download-selector__option-icon"></i>
              <span>PDF</span>
            </span>
            <span class="download-selector__option" id="download-xlsx">
              <i class="fas fa-file-excel download-selector__option-icon"></i>
              <span>Excel</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="table-spinner"><div class="spinner-circle"></div></div>
    <div id="master-table" class="tabulator tabulator-modern"></div>
  </div>

  <!-- Tabulator JS -->
  <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

  <script>
    // ================= DOWNLOAD DROPDOWN UI =================

    const downloadSelector = document.getElementById("downloadSelector");
    const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");

    // Toggle dropdown
    triggerBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      downloadSelector.classList.toggle("download-selector--active");

      const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
      icon.style.transform = downloadSelector.classList.contains("download-selector--active")
        ? "rotate(180deg)"
        : "rotate(0deg)";
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", () => {
      downloadSelector.classList.remove("download-selector--active");
      const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
      icon.style.transform = "rotate(0deg)";
    });

    // Prevent close when clicking inside dropdown
    downloadSelector.querySelector(".download-selector__menu").addEventListener("click", (e) => {
      e.stopPropagation();
    });

    // ================= TABULATOR DATA =================

    // Render data from Express (passed into EJS)
    let tableData = [];
    try {
      tableData = <%- safeJson(jsonData || []) %>;
      console.log(tableData);
    } catch (err) {
      console.error("Master Disp JSON error", err);
    }

    // Mirrors utils/locations.js normalizeLocationName — a client's stored
    // location can carry a stray trailing comma/dot (e.g. pasted from
    // "Tarapur, Maharashtra") while item bindings are always saved comma-
    // stripped, so comparisons must normalize both sides or a genuinely
    // bound item silently disappears from the count/drill-through.
    const normalizeLocationName = (value) =>
      String(value || "")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, " ")
        .replace(/^[.,]+|[.,]+$/g, "");
    const sameLoc = (a, b) => normalizeLocationName(a) === normalizeLocationName(b);
    const countAtLoc = (items, loc) => (items || []).filter((i) => sameLoc(i?.location, loc)).length;

    const flatData = [];
    tableData.forEach((user) => {
      const locNames = (user.locationDetails || [])
        .map((loc) => normalizeLocationName(loc.userLocation))
        .filter(Boolean);
      const locs = locNames.length > 0 ? locNames : [normalizeLocationName(user.userLocation)];

      locs.forEach((loc) => {
        flatData.push({
          ...user,
          userLocation: loc,
          labelCount: countAtLoc(user.label, loc),
          colorLabelCount: countAtLoc(user.colorLabel, loc),
          ttrCount: countAtLoc(user.ttr, loc),
          tapeCount: countAtLoc(user.tape, loc),
          posRollCount: countAtLoc(user.posRoll, loc),
          tafetaCount: countAtLoc(user.tafeta, loc),
          dispatchType: user.SelfDispatch ? "Self Dispatch" : "Transport",
        });
      });
    });
    tableData = flatData;

    // Keep every client in exactly one parent row. Each individual
    // user/location row is revealed from the chevron, matching the Vendor
    // Coordinator view's dropdown-row behaviour. Group case-insensitively so
    // an accidental casing difference cannot create duplicate client rows.
    function buildClientTreeData(rows) {
      const groups = new Map();

      rows.forEach((row) => {
        const key = String(row.clientName || "").trim().toLowerCase();
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key).push(row);
      });

      return Array.from(groups.values()).flatMap((members) => {
        const userKeys = new Set(
          members.map((member) => String(member._id || member.userName || "").trim().toLowerCase()),
        );
        if (members.length === 1) return members;

        const sumField = (field) => members.reduce((total, member) => total + (Number(member[field]) || 0), 0);

        const first = members[0];
        const parent = { ...first };
        parent.isGroup = true;
        parent.userName = `${userKeys.size} ${userKeys.size === 1 ? "User" : "Users"}`;
        parent.userLocation = "";
        parent.userDepartment = "";
        // Collapsed group row shows the client's total across every one of
        // its users/locations, so the counts don't just vanish until the
        // dropdown is expanded -- each child keeps its own per-user figure.
        parent.labelCount = sumField("labelCount");
        parent.colorLabelCount = sumField("colorLabelCount");
        parent.ttrCount = sumField("ttrCount");
        parent.tapeCount = sumField("tapeCount");
        parent.posRollCount = sumField("posRollCount");
        parent.tafetaCount = sumField("tafetaCount");
        parent._children = members.map((member) => ({ ...member, isChild: true }));

        return [parent];
      });
    }

    // ================= TABULATOR INIT =================

    let table; // MUST be global for download to work
    const requiredFields = ["clientName", "clientType", "accountHead", "userName", "userLocation"];

    const withTextFilter = (column, placeholder = "Search") => ({
      headerFilter: "input",
      headerFilterPlaceholder: placeholder,
      minWidth: 100,
      ...column,
    });

    // Shared formatter for the Labels/Color Labels/TTR/Tape/POS Roll/Tafeta
    // count columns. A group row's count is the client's total across every
    // collapsed user/location (see buildClientTreeData's sumField) -- it has
    // no single target to drill into, so unlike a user row's count it isn't
    // styled as clickable (cellClick already no-ops for isGroup rows).
    function countCellFormatter(field) {
      return (cell) => {
        const row = cell.getRow().getData();
        const value = row[field];
        if (!value) return "";
        if (row.isGroup) return `<span>${value}</span>`;
        return `<span style="cursor:pointer;text-decoration:underline;">${value}</span>`;
      };
    }

    function hasMissingDetails(row) {
      return requiredFields.some((field) => {
        const value = row?.[field];
        return value === undefined || value === null || String(value).trim() === "";
      });
    }

    function initTable() {
      // Store current scroll position to restore after init
      const scrollPos = window.scrollY || window.pageYOffset;

      table = new Tabulator("#master-table", {
        data: buildClientTreeData(tableData),
        height: "100%",
        // layout: "fitColumns",
        virtualDom: true,
        responsiveLayout: false,
        initialSort: [{ column: "clientName", dir: "asc" }],
        movableColumns: true,
        placeholder: "No data to display",
        dataTree: true,
        dataTreeStartExpanded: false,
        dataTreeChildField: "_children",
        // Filter the client parent, then keep all of that client's users
        // together in its dropdown just like Vendor Coordinator commodities.
        dataTreeFilter: false,
        dataTreeElementColumn: "_toggle",
        rowFormatter: (row) => {
          const rowEl = row.getElement();
          if (!row.getData().isGroup && hasMissingDetails(row.getData())) {
            rowEl.classList.add("row-missing-details");
          } else {
            rowEl.classList.remove("row-missing-details");
          }
        },
        columns: [
          {
            title: "",
            field: "_toggle",
            width: 40,
            hozAlign: "center",
            headerSort: false,
            headerFilter: false,
            // The nested user row should have an arrow marker, not
            // Tabulator's default L-shaped branch connector.
            formatter: (cell) => (cell.getRow().getTreeParent?.() ? "↳" : ""),
          },
          srNoColumn(),
          withTextFilter({
            title: "Name",
            field: "clientName",
            headerSort: true,
            widthGrow: 2,
          }),
          withTextFilter({
            title: "Type",
            field: "clientType",
            headerSort: true,
            width: 100,
          }),
          withTextFilter({
            title: "Account Head",
            field: "accountHead",
            headerSort: true,
            widthGrow: 2,
          }),
          withTextFilter({
            title: "User Name",
            field: "userName",
            formatter: (cell) => {
              if (cell.getRow().getData().isGroup) return cell.getValue();
              return `
              <span style="cursor:pointer;font-weight:600;text-decoration:underline;">
                ${cell.getValue()}
              </span>
            `;
            },
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              const loc = row.userLocation ? `?location=${encodeURIComponent(row.userLocation)}` : "";
              window.location.href = `/fairtech/client/details/${row._id}${loc}`;
            },
            headerSort: true,
            widthGrow: 2,
          }),
          withTextFilter({
            title: "Location",
            field: "userLocation",
            headerSort: true,
            widthGrow: 2,
          }),
          withTextFilter({
            title: "Department",
            field: "userDepartment",
            headerSort: true,
            widthGrow: 2,
          }),
          withTextFilter({
            title: "Labels",
            field: "labelCount",
            width: 95,
            widthGrow: 0,
            widthShrink: 0,
            hozAlign: "center",
            headerSort: true,
            headerSortStartingDir: "desc",
            cssClass: "col-count-center",
            formatter: countCellFormatter("labelCount"),
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              const loc = row.userLocation ? `?location=${encodeURIComponent(row.userLocation)}` : "";
              window.location.href = `/fairtech/labels/view/${row._id}${loc}`;
            },
          }),
          withTextFilter({
            title: "Color Labels",
            field: "colorLabelCount",
            width: 110,
            widthGrow: 0,
            widthShrink: 0,
            hozAlign: "center",
            headerSort: true,
            headerSortStartingDir: "desc",
            cssClass: "col-count-center",
            formatter: countCellFormatter("colorLabelCount"),
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              const loc = row.userLocation ? `?location=${encodeURIComponent(row.userLocation)}` : "";
              window.location.href = `/fairtech/color-labels/view/${row._id}${loc}`;
            },
          }),
          withTextFilter({
            title: "TTR's",
            field: "ttrCount",
            width: 95,
            widthGrow: 0,
            widthShrink: 0,
            hozAlign: "center",
            headerSort: true,
            headerSortStartingDir: "desc",
            cssClass: "col-count-center",
            formatter: countCellFormatter("ttrCount"),
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              window.location.href = `/fairtech/ttr/view/${row._id}`;
            },
          }),
          withTextFilter({
            title: "Tapes",
            field: "tapeCount",
            width: 95,
            widthGrow: 0,
            widthShrink: 0,
            hozAlign: "center",
            headerSort: true,
            headerSortStartingDir: "desc",
            cssClass: "col-count-center",
            formatter: countCellFormatter("tapeCount"),
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              window.location.href = `/fairtech/tape/view/${row._id}`;
            },
          }),
          withTextFilter({
            title: "POS Rolls",
            field: "posRollCount",
            width: 95,
            widthGrow: 0,
            widthShrink: 0,
            hozAlign: "center",
            headerSort: true,
            headerSortStartingDir: "desc",
            cssClass: "col-count-center",
            formatter: countCellFormatter("posRollCount"),
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              window.location.href = `/fairtech/pos-roll/view/${row._id}`;
            },
          }),
          withTextFilter({
            title: "Tafeta",
            field: "tafetaCount",
            width: 95,
            widthGrow: 0,
            widthShrink: 0,
            hozAlign: "center",
            headerSort: true,
            headerSortStartingDir: "desc",
            cssClass: "col-count-center",
            formatter: countCellFormatter("tafetaCount"),
            cellClick: (e, cell) => {
              const row = cell.getRow().getData();
              if (row.isGroup) return;
              window.location.href = `/fairtech/tafeta/view/${row._id}`;
            },
          }),
        ],
      });

      // Restore scroll position after table finishes rendering
      setTimeout(() => {
        window.scrollTo(0, scrollPos);
      }, 0);
    }

    // Use DOMContentLoaded instead of load (fires earlier, prevents long wait)
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTable);
    } else {
      initTable();
    }

    // ================= DOWNLOAD ACTIONS =================

    // PDF
    document.getElementById("download-pdf").addEventListener("click", () => {
      if (!table) return;

      table.download("pdf", "master-data.pdf", {
        orientation: "landscape",
        title: "Master Data",
      });

      downloadSelector.classList.remove("download-selector--active");
    });

    // Excel
    document.getElementById("download-xlsx").addEventListener("click", () => {
      if (!table) return;

      table.download("xlsx", "master-data.xlsx", {
        sheetName: "Master Data",
      });

      downloadSelector.classList.remove("download-selector--active");
    });
  </script>

  <!-- ================= NEW CLIENT DIALOG =================
       Opened by the header's "+ Client" / "+ User" buttons. Markup/behaviour:
       _clientForm.ejs. Sales (view-only) never sees the buttons that open
       it, so the dialog itself is skipped for that role too. -->
  <% if (!(authUser && authUser.role === "sales")) { %>
  <%- include('./_clientForm', { clients, employees, previewClientId }) %>
  <% } %>
</body>
