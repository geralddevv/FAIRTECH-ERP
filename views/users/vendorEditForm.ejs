<% layout('/layout/boilerplate') -%>
<%#
  Edit Vendor -- the same card as the New Vendor dialog (_vendorForm.ejs),
  drawn as a page for anyone who lands on the URL (formStyle.md, "The same
  card as a page"). Style: formStyle.md. Behaviour: public/js/soFormDialog.js
  (validation + fetch submit; the route answers JSON { success, redirect }).
%>
<%
  const selectedCommodities = Array.isArray(vendor.commodities)
    ? vendor.commodities.map((c) => String(c).toUpperCase())
    : typeof vendor.commodities === "string" && vendor.commodities
      ? [String(vendor.commodities).toUpperCase()]
      : [];

  // Predefined lists
  const predefinedCommodities = ["FACE PAPER", "ADHESIVE", "RELEASE PAPER", "SL (PAPER)", "PACKAGING", "TTR", "TAPE", "POS ROLL", "TAFFETA", "OUTSOURCE", "PRINTERS", "SCANNERS", "SPARES", "CORE", "FOIL", "IT", "DIE", "BLOCK", "COLOR"];
  const predefinedStatuses = ["ACTIVE", "INACTIVE", "BLACKLISTED", "OTHERS"];

  // Extract 'Other' commodity logic
  const isOthersSelected = selectedCommodities.some((c) => c === "OTHERS" || c.startsWith("OTHERS - ") || !predefinedCommodities.includes(c));
  let otherCommodityValue = "";
  const otherCommRaw = selectedCommodities.find((c) => c.startsWith("OTHERS - ")) || selectedCommodities.find((c) => !predefinedCommodities.includes(c) && c !== "OTHERS");
  if (otherCommRaw) {
    otherCommodityValue = otherCommRaw.replace(/^(OTHERS - )+/, "");
  }

  // Extract 'Other' status logic
  let otherStatusValue = "";
  let currentStatus = vendor.vendorStatus || "";
  if (currentStatus.startsWith("OTHERS - ")) {
    otherStatusValue = currentStatus.replace(/^(OTHERS - )+/, "");
    currentStatus = "OTHERS";
  } else if (!predefinedStatuses.includes(currentStatus)) {
    otherStatusValue = currentStatus;
    currentStatus = "OTHERS";
  }
%>
<style>
  .so-dialog .choices__list--multiple .choices__item {
    background: var(--so-brand);
    border: 1px solid var(--so-brand-dark);
    color: #fff;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
  }

  .so-dialog .choices__list--multiple .choices__item.is-highlighted {
    background: var(--so-brand-dark);
  }

  .so-dialog .choices[data-type*="select-multiple"] .choices__inner {
    height: auto;
    min-height: 40px;
  }

  #vendor-other-status,
  #vendor-other-commodity {
    margin-top: 8px;
  }
</style>

<div class="so-dialog-page">
  <form id="vendor-edit-form" class="so-dialog so-dialog--xl" action="/fairtech/vendor/edit/<%= vendor._id %>" method="post" autocomplete="off" novalidate data-so-form>
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-pen"></i></span>
      <div>
        <h3 class="so-dialog__title">Edit Vendor</h3>
        <p class="so-dialog__desc">Changes also update this vendor's coordinators.</p>
      </div>
    </div>

    <div class="so-dialog__body">
      <div class="so-dialog__section">Vendor Details</div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="vendor-id">Vendor Id</label>
          <input type="text" value="<%= vendor.vendorId %>" id="vendor-id" name="vendorId" readonly tabindex="-1" required />
        </div>
        <div class="so-dialog__field">
          <label for="vendor-name">Vendor Name <span class="so-req">*</span></label>
          <input type="text" id="vendor-name" name="vendorName" value="<%= vendor.vendorName %>" oninput="this.value = this.value.toUpperCase()" required data-so-autofocus />
        </div>
        <div class="so-dialog__field">
          <label for="vendor-status">Vendor Status <span class="so-req">*</span></label>
          <select name="vendorStatus" id="vendor-status" required>
            <% predefinedStatuses.forEach((st) => { %>
              <option value="<%= st %>" <%= currentStatus === st ? "selected" : "" %>><%= st %></option>
            <% }) %>
          </select>
          <input type="text" name="otherStatus" id="vendor-other-status" placeholder="Please specify status" value="<%= otherStatusValue %>" oninput="this.value = this.value.toUpperCase()" style="display: <%= currentStatus === 'OTHERS' ? 'block' : 'none' %>;" <%= currentStatus === 'OTHERS' ? 'required' : 'disabled' %> />
        </div>
        <div class="so-dialog__field">
          <label for="ho-location">H/O Location <span class="so-req">*</span></label>
          <input type="text" id="ho-location" name="hoLocation" value="<%= vendor.hoLocation %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
        <div class="so-dialog__field">
          <label for="warehouse-location">Warehouse Location <span class="so-req">*</span></label>
          <input type="text" id="warehouse-location" name="warehouseLocation" value="<%= vendor.warehouseLocation %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
      </div>

      <div class="so-dialog__section">Commodities</div>
      <div class="so-dialog__field">
        <label for="commodities-select">Commodities</label>
        <select name="commodities" id="commodities-select" multiple>
          <% predefinedCommodities.forEach((p) => { %>
            <option value="<%= p %>" <%= selectedCommodities.includes(p) ? 'selected' : '' %>><%= p %></option>
          <% }) %>
          <option value="Others" <%= isOthersSelected ? 'selected' : '' %>>OTHERS</option>
        </select>
        <input type="text" name="commodities" id="vendor-other-commodity" placeholder="Please specify Others" value="<%= otherCommodityValue %>" oninput="this.value = this.value.toUpperCase()" style="display: <%= isOthersSelected ? 'block' : 'none' %>;" <%= isOthersSelected ? 'required' : 'disabled' %> />
      </div>

      <div class="so-dialog__section">Compliance</div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="vendor-gst">GST <span class="so-req">*</span></label>
          <input type="text" maxlength="15" id="vendor-gst" name="vendorGst" value="<%= vendor.vendorGst %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
        <div class="so-dialog__field">
          <label for="vendor-msme">MSME <span class="so-req">*</span></label>
          <input type="text" maxlength="15" id="vendor-msme" name="vendorMsme" value="<%= vendor.vendorMsme %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
        <div class="so-dialog__field">
          <label for="vendor-gumasta">Gumasta <span class="so-req">*</span></label>
          <input type="text" id="vendor-gumasta" name="vendorGumasta" value="<%= vendor.vendorGumasta %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
        <div class="so-dialog__field">
          <label for="vendor-pan">PAN <span class="so-req">*</span></label>
          <input type="text" maxlength="10" id="vendor-pan" name="vendorPan" value="<%= vendor.vendorPan %>" oninput="this.value = this.value.toUpperCase()" required />
        </div>
      </div>
    </div>

    <div class="so-dialog__foot">
      <a class="so-btn so-btn--ghost" href="/fairtech/vendor/view">Cancel</a>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update Vendor Details</button>
    </div>
  </form>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const commoditiesSelect = document.getElementById("commodities-select");
    const otherCommodityInput = document.getElementById("vendor-other-commodity");
    let commoditiesChoices = null;

    if (commoditiesSelect) {
      commoditiesChoices = new Choices(commoditiesSelect, {
        removeItemButton: true,
        searchEnabled: true,
        shouldSort: false,
        placeholder: true,
        placeholderValue: "Select Commodities",
        itemSelectText: "",
      });

      commoditiesSelect.addEventListener("change", () => {
        const isOthers = commoditiesChoices.getValue(true).includes("Others");
        otherCommodityInput.style.display = isOthers ? "block" : "none";
        otherCommodityInput.required = isOthers;
        otherCommodityInput.disabled = !isOthers;
        if (!isOthers) otherCommodityInput.value = "";
      });
    }

    const statusSelect = document.getElementById("vendor-status");
    const otherStatusInput = document.getElementById("vendor-other-status");
    statusSelect?.addEventListener("change", (e) => {
      const isOthers = e.target.value === "OTHERS";
      otherStatusInput.style.display = isOthers ? "block" : "none";
      otherStatusInput.disabled = !isOthers;
      otherStatusInput.required = isOthers;
      if (!isOthers) otherStatusInput.value = "";
    });

    const gstInput = document.getElementById("vendor-gst");
    const panInput = document.getElementById("vendor-pan");
    const syncPan = (gst) => {
      panInput.value = gst.length >= 12 ? gst.substring(2, 12) : "";
      panInput.dispatchEvent(new Event("input"));
    };

    // Auto-fill PAN on load if GST exists but PAN is missing
    if (gstInput.value && !panInput.value) syncPan(gstInput.value.toUpperCase());

    gstInput.addEventListener("input", function () {
      const gst = this.value.toUpperCase();
      this.value = gst;
      syncPan(gst);
      const gstRegex = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;
      this.setCustomValidity(gst.length > 0 && !gstRegex.test(gst) ? "Invalid GST format (e.g., 22AAAAA0000A1Z5)" : "");
    });

    panInput.addEventListener("input", function () {
      const pan = this.value.toUpperCase();
      this.value = pan;
      const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
      this.setCustomValidity(pan.length > 0 && !panRegex.test(pan) ? "Invalid PAN format (e.g., ABCDE1234F)" : "");
    });
  });
</script>
<script src="/js/soFormDialog.js?v=1"></script>
