<% layout('/layout/boilerplate') -%>
<style>
  /* Product ID badge beside the "Color Label Specifications" heading --
     shared look (.so-card__badge, formStyle.md) via salesOrderForm.css;
     only the resolved/error colour swap below is specific to this page. */
  #product-id.label-id-success {
    border-color: #059669;
    background-color: #f0fdf4;
    color: #065f46;
  }
  #product-id.label-id-error {
    border-color: var(--so-danger);
    background-color: #fff1f2;
    color: #9f1239;
  }

  /* Client type tag (DEALER / CLIENT) filled in once a client is picked.
     Class name "asterisk" kept as-is -- the script below selects it by that
     name regardless of how it's painted. */
  .client-type-badge {
    display: none;
    flex: none;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .client-type-badge.badge-dealer {
    display: inline-flex;
    color: var(--so-danger);
    background: #fff1f2;
  }
  .client-type-badge.badge-client {
    display: inline-flex;
    color: #059669;
    background: #f0fdf4;
  }

  /* A small annotation after a label's own text -- see "Badge in a label"
     in formStyle.md. */
  .so-label-hint {
    flex: none;
    font-size: 11px;
    font-weight: 600;
    color: var(--so-faint);
  }

  /* Widen only the open dropdown list for Client Name -- names here run
     long (e.g. "FLAIR WRITING EQUIPMENTS PVT LTD -FWEPL VALSAD") and get
     clipped at the select box's own width. The closed box stays as-is. */
  #client-name-div .choices__list--dropdown {
    width: max-content;
    min-width: 100%;
    max-width: 520px;
  }
</style>

<div class="main-content so-page">
  <form action="/fairtech/form/color-labels" method="post" onsubmit="return validateLabelBeforeSubmit()" class="needs-validation so-form" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1>Client Color Label</h1></div>
      </header>

      <!-- ================= USER INFORMATION =================
           Row: 8 + 8 + 8 + 8 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">User Information</h2></div>
        </div>
        <div class="so-grid">
          <div id="client-name-div" class="span-eight">
            <label for="client-name"><span class="so-label-text">Client Name</span> <span class="asterisk client-type-badge"></span></label>
            <select name="clientName" id="client-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% for (let client of clients) { %>
              <option value="<%= client %>"><%= client %></option>
              <% } %>
            </select>
          </div>
          <div id="user-name-div" class="span-eight">
            <label for="client-user-name"><span class="so-label-text">User Name</span></label>
            <select name="userName" id="client-user-name" class="form-control select-tag" required>
              <option value="" selected disabled hidden>Search</option>
            </select>
          </div>
          <div id="user-name-contact-div" class="span-eight">
            <label for="user-contact"><span class="so-label-text">User Contact</span></label>
            <input type="text" id="user-contact" class="form-control" name="userContact" placeholder="Enter User Contact" required />
          </div>
          <div id="client-location-div" class="span-eight">
            <label for="client-location"><span class="so-label-text">Location</span></label>
            <select name="location" id="client-location" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Select location</option>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= COLOR LABEL SPECIFICATIONS =================
           Single row: 4 + 3 + 3 + 3 + 3 + 4 + 4 + 4 + 4 = 32. -->
      <section class="so-card">
        <div class="so-card__head so-card__head--wrap">
          <span class="so-card__icon"><i class="fa-solid fa-swatchbook"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Color Label Specifications</h2></div>
          <!-- Product ID lives beside the heading, not in the field grid
               below -- it's the resolved identifier for whatever specs are
               picked, not one more spec to fill in, and keeping it out of
               .so-grid means the rows below keep their own clean
               32-column math regardless of how this badge is sized.
               Shared look: .so-card__badge (formStyle.md). -->
          <div class="so-card__badge" title="Resolves once Job Name, Front/Back Color, Varnish, Foil, First Out, Width, Height and Gap match one Color Label Master">
            <span class="so-card__badge-label">Product ID</span>
            <input type="text" id="product-id" name="productId" class="so-card__badge-input" placeholder="Will appear here" readonly required />
          </div>
          <div class="so-card__aside">
            <button type="button" id="reset-specs-btn" class="so-toggle"><i class="fa-solid fa-rotate-left"></i> Reset</button>
          </div>
        </div>
        <div class="so-grid">
          <div class="span-four">
            <label for="job-name"><span class="so-label-text">Job Name</span></label>
            <select id="job-name" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div class="span-three">
            <label for="front-color"><span class="so-label-text">Front Color</span></label>
            <select id="front-color" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div class="span-three">
            <label for="back-color"><span class="so-label-text">Back Color</span></label>
            <select id="back-color" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div class="span-three">
            <label for="varnish"><span class="so-label-text">Varnish</span></label>
            <select id="varnish" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div class="span-three">
            <label for="foil-no"><span class="so-label-text">No of Foil</span></label>
            <select id="foil-no" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div class="span-four">
            <label for="first-out"><span class="so-label-text">First Out</span></label>
            <select id="first-out" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div id="width-div" class="span-four">
            <label for="width"><span class="so-label-text">Width</span></label>
            <select id="width" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div id="height-div" class="span-four">
            <label for="height"><span class="so-label-text">Height</span></label>
            <select id="height" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div id="gap-div" class="span-four">
            <label for="gap"><span class="so-label-text">Gap</span></label>
            <select id="gap" class="form-control select-tag">
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= CLIENT SPECIFICATIONS =================
           Row: 10 + 10 + 12 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-list-check"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Client Specifications</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-penta">
            <label for="ups-input"><span class="so-label-text">Up's</span></label>
            <input type="text" id="ups-input" class="form-control" name="labelUps" placeholder="Enter Up's" required />
          </div>
          <div class="span-penta">
            <label for="core-input"><span class="so-label-text">Core</span></label>
            <select id="core-input" class="form-control" name="labelCore" required>
              <option value="" disabled selected hidden>Select</option>
              <option value="0.5">0.5</option>
              <option value="1">1</option>
              <option value="1.5">1.5</option>
              <option value="2">2</option>
              <option value="3">3</option>
            </select>
          </div>
          <div class="span-hexa">
            <label for="family-input"><span class="so-label-text">Family</span></label>
            <select id="family-input" class="form-control" name="labelFamily" required>
              <option value="" disabled selected hidden>Select</option>
              <option value="CHROMO">CHROMO</option>
              <option value="DT">DT</option>
              <option value="MAPLTIO">MAPLTIO</option>
              <option value="PP">PP</option>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= COST & PRICING =================
           Row 1: 11 + 11 + 10 = 32. Row 2: 11 + 11 + 10 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-indian-rupee-sign"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Cost &amp; Pricing</h2></div>
        </div>
        <!-- Single row: 6 + 5 + 5 + 5 + 5 + 6 = 32. -->
        <div class="so-grid">
          <div id="rate-per-k-div" class="span-six">
            <label for="rate-per-k"><span class="so-label-text">Rate Per 1000</span></label>
            <input type="text" id="rate-per-k" class="form-control" name="ratePerK" placeholder="Enter Rate Per 1000" required />
          </div>
          <div id="rate-per-label-div" class="span-five">
            <label for="rate-per-label"><span class="so-label-text">Rate Per Label</span></label>
            <input type="text" id="rate-per-label" class="form-control" name="ratePerLabel" placeholder="Auto-calculated" tabindex="-1" readonly required />
          </div>
          <div id="per-roll-qty-div" class="span-five">
            <label for="per-roll-qty"><span class="so-label-text">Per Roll QTY</span></label>
            <input type="text" id="per-roll-qty" class="form-control" name="perRollQty" placeholder="Enter Per Roll QTY" required />
          </div>
          <div class="span-five">
            <label for="labels-del"><span class="so-label-text">Labels Delivered</span></label>
            <input type="text" id="labels-del" class="form-control" name="labelsDel" placeholder="Enter Labels Delivered" />
          </div>
          <div id="per-roll-div" class="span-five">
            <label for="per-roll"><span class="so-label-text">Rate Per Roll</span></label>
            <input type="text" id="per-roll" class="form-control" name="perRoll" placeholder="Auto-calculated" tabindex="-1" readonly required />
          </div>
          <div id="sale-cost-div" class="span-six">
            <label for="sale-cost"><span class="so-label-text">Sale Cost</span></label>
            <input type="text" id="sale-cost" class="form-control" name="saleCost" placeholder="Auto-calculated" tabindex="-1" readonly required />
          </div>
        </div>
      </section>

      <!-- ================= ORDER INFORMATION =================
           Row: 8 + 8 + 8 + 8 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-cart-shopping"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Order Information</h2></div>
        </div>
        <div class="so-grid">
          <div id="order-qty-div" class="span-eight">
            <label for="order-qty"><span class="so-label-text">MOQ</span> <span class="so-label-hint">in labels (qty)</span></label>
            <input type="hidden" name="moqUnit" value="LABELS" />
            <input type="text" id="order-qty" class="form-control" name="minOrderQty" placeholder="Enter Our Order QTY" required />
          </div>
          <div id="total-order-qty-div" class="span-eight">
            <label for="total-order-qty"><span class="so-label-text">Order QTY</span></label>
            <input type="text" id="total-order-qty" class="form-control" name="orderQty" placeholder="Enter Total Order QTY" required />
          </div>
          <div id="rep-order-fq-div" class="span-eight">
            <label for="rep-order-fq"><span class="so-label-text">Repeat Order Frequency</span></label>
            <input type="text" id="rep-order-fq" class="form-control" name="repOrderFq" placeholder="Enter Repeat Order Frequency" required />
          </div>
          <div id="credit-term-div" class="span-eight">
            <label for="credit-term"><span class="so-label-text">CR</span></label>
            <input type="text" id="credit-term" class="form-control" name="creditTerm" placeholder="Enter Credit Term" required />
          </div>
          <!-- Hidden fields: resolved master + target user -->
          <input type="hidden" name="labelMasterId" id="label-master-id" />
          <input type="hidden" name="userObjId" id="user-obj-id" />
        </div>
      </section>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="so-actions">
      <span class="so-actions__hint">
        <i class="fa-regular fa-circle-check"></i>
        <span class="so-actions__hint-text">Specs resolve automatically once Job Name, colors, Width, Height and Gap match one Color Label Master.</span>
      </span>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Save Color Label</button>
    </div>
  </form>
</div>

<script id="masters-data" type="application/json">
  <%- safeJson(masters) %>
</script>
<script src="/js/choices.min.js"></script>
<script>
  // Full text on hover for anything this page cuts short with an ellipsis --
  // see formStyle.md's "Long text" section. Delegated from document, so it
  // also covers what Choices builds later (dropdown options).
  (function () {
    const TRUNCATING = [
      ".so-page .so-label-text",
      ".so-page .form-control",
      ".so-page #product-id",
      ".so-page .choices__list--single .choices__item",
      ".so-page .choices__list--dropdown .choices__item",
      ".so-page .choices__list[aria-expanded] .choices__item",
      ".so-page .so-actions__hint-text",
    ].join(",");

    document.addEventListener("mouseover", (e) => {
      const el = e.target instanceof Element ? e.target.closest(TRUNCATING) : null;
      if (!el) return;
      const full = (el.matches("input, textarea") ? el.value : el.textContent).replace(/\s+/g, " ").trim();
      const isCut = el.scrollWidth > el.clientWidth + 1;
      if (isCut && full) {
        el.title = full;
        el.dataset.soTip = "1";
      } else if (el.dataset.soTip) {
        el.removeAttribute("title");
        delete el.dataset.soTip;
      }
    });
  })();

  document.addEventListener("DOMContentLoaded", () => {
    const MASTERS = JSON.parse(document.getElementById("masters-data").textContent);

    // All spec selects — each drives the cascading smart filter against ColorLabelMaster fields
    const SPEC = [
      ["job-name",    "jobName"],
      ["front-color", "frontColor"],
      ["back-color",  "backColor"],
      ["varnish",     "varnish"],
      ["foil-no",     "foilNo"],
      ["first-out",   "firstOut"],
      ["width",       "labelWidth"],
      ["height",      "labelHeight"],
      ["gap",         "labelGap"],
    ];

    const submitBtn = document.querySelector("button[type='submit']");
    const productIdEl = document.getElementById("product-id");
    const masterIdEl = document.getElementById("label-master-id");
    const asteriskClientType = document.querySelector(".asterisk");

    const $ = (sel) => document.querySelector(sel);
    const getVal = (sel) => { const el = $(sel); return el ? String(el.value || "").trim() : ""; };
    const setVal = (sel, val) => { const el = $(sel); if (el) el.value = val ?? ""; };

    let resolvedMaster = null;
    let smartFilterBusy = false;
    let initMode = false;

    submitBtn.disabled = true;

    /* ================= CHOICES INIT ================= */
    const specChoices = {};
    SPEC.forEach(([id]) => {
      const el = document.getElementById(id);
      if (el) {
        specChoices[id] = new Choices(el, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      }
    });

    const coreInputEl = document.getElementById("core-input");

    /* ================= SMART FILTER ================= */
    const distinct = (list, key) =>
      [...new Set(list.map((m) => String(m[key] ?? "")).filter((v) => v !== ""))];

    function selections() {
      const sel = {};
      SPEC.forEach(([id, key]) => {
        const el = document.getElementById(id);
        if (el && el.value) sel[key] = el.value;
      });
      return sel;
    }

    function mastersMatching(sel, excludeKey) {
      return MASTERS.filter((m) =>
        Object.entries(sel).every(([k, v]) => k === excludeKey || String(m[k] ?? "") === String(v)),
      );
    }

    function repopulate() {
      const sel = selections();
      SPEC.forEach(([id, key]) => {
        const inst = specChoices[id];
        const el = document.getElementById(id);
        if (!inst || !el) return;

        const current = el.value;
        const options = distinct(mastersMatching(sel, key), key);
        const optionSet = new Set(options.map(String));

        const newChoices = options.map((v) => ({
          value: String(v),
          label: String(v),
          selected: String(v) === current,
        }));

        let autoVal = null;
        if (options.length === 1 && !current && !initMode) {
          newChoices[0].selected = true;
          autoVal = options[0];
        }

        inst.clearStore();
        inst.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
          "value", "label", true,
        );

        if (current && optionSet.has(String(current))) {
          inst.setChoiceByValue(String(current));
        } else if (autoVal) {
          inst.setChoiceByValue(String(autoVal));
        } else if (!options.length) {
          el.value = "";
        }
      });
    }

    function repopulateUntilStable() {
      for (let i = 0; i < SPEC.length + 1; i++) {
        const before = SPEC.map(([id]) => document.getElementById(id).value).join("|");
        repopulate();
        const after = SPEC.map(([id]) => document.getElementById(id).value).join("|");
        if (before === after) break;
      }
    }

    /* ================= RESOLVE MASTER ================= */
    function resolveMaster() {
      const sel = selections();
      resolvedMaster = null;
      masterIdEl.value = "";
      submitBtn.disabled = true;
      productIdEl.classList.remove("label-id-success", "label-id-error");

      if (Object.keys(sel).length === 0) {
        productIdEl.value = "";
        return;
      }

      const matches = mastersMatching(sel);
      if (matches.length === 1) {
        const m = matches[0];
        resolvedMaster = m;
        productIdEl.value = m.labelProductId;
        masterIdEl.value = m._id;
        productIdEl.classList.add("label-id-success");
        submitBtn.disabled = false;
        updateRates();
      } else if (matches.length === 0) {
        productIdEl.value = "No matching color label found";
        productIdEl.classList.add("label-id-error");
      } else {
        productIdEl.value = `${matches.length} matches — refine specs`;
      }
    }

    function handleSpecChange() {
      if (smartFilterBusy) return;
      smartFilterBusy = true;
      try {
        repopulateUntilStable();
        resolveMaster();
      } finally {
        smartFilterBusy = false;
      }
    }

    SPEC.forEach(([id]) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener("change", handleSpecChange);
    });

    /* ================= RESET ================= */
    document.getElementById("reset-specs-btn").addEventListener("click", () => {
      smartFilterBusy = true;
      SPEC.forEach(([id]) => {
        const el = document.getElementById(id);
        if (el) el.value = "";
        if (specChoices[id]) specChoices[id].setChoiceByValue("");
      });
      ["#rate-per-k", "#rate-per-label", "#per-roll", "#sale-cost",
       "#order-qty", "#total-order-qty", "#rep-order-fq", "#credit-term",
       "#ups-input"].forEach((s) => setVal(s, ""));
      coreInputEl.value = "";
      document.getElementById("family-input").value = "";
      repopulate();
      smartFilterBusy = false;
      resolveMaster();
    });

    /* ================= RATE / SALE COST ================= */
    function updateRates() {
      const ratePerK = Number(getVal("#rate-per-k")) || 0;
      const perRollQty = Number(getVal("#per-roll-qty")) || 0;
      const ratePerLabel = ratePerK / 1000;

      setVal("#rate-per-label", ratePerLabel ? ratePerLabel : "");
      setVal("#per-roll", ratePerLabel && perRollQty ? (ratePerLabel * perRollQty).toFixed(2) : "");
      computeSaleCost(ratePerLabel);
    }

    function computeSaleCost(ratePerLabel) {
      const w = Number(getVal("#width")) || 0;
      const h = Number(getVal("#height")) || 0;
      if (!w || !h || !ratePerLabel) { setVal("#sale-cost", "0.00"); return; }
      const clientType = (asteriskClientType?.textContent || "").trim();
      const divisor = clientType === "(DEALER)" ? 645 : 625;
      const area = (w * h) / divisor;
      setVal("#sale-cost", area ? (ratePerLabel / area).toFixed(4) : "0.00");
    }

    document.getElementById("rate-per-k").addEventListener("input", updateRates);
    document.getElementById("per-roll-qty").addEventListener("input", updateRates);

    /* ================= CLIENT -> USER ================= */
    const clientSelect = document.getElementById("client-name");
    const userSelect = document.getElementById("client-user-name");
    const userObjIdEl = document.getElementById("user-obj-id");
    let fetchedClientData = null;

    const clientChoices = new Choices(clientSelect, {
      searchEnabled: true,
      shouldSort: false,
      itemSelectText: "",
      // Default searchResultLimit (4) silently drops real matches when several
      // client names are near-identical -- widen it and tighten the fuzzy
      // threshold so every close match surfaces instead of being crowded
      // out by loose noise matches.
      searchResultLimit: 20,
      fuseOptions: { threshold: 0.3 },
    });
    const userChoices = new Choices(userSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    const locationSelect = document.getElementById("client-location");
    const locationChoices = new Choices(locationSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    function normalizeLocationName(value) {
      return String(value || "")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, " ")
        .replace(/^[.,]+|[.,]+$/g, "");
    }

    function getUserLocationEntries(user) {
      const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
      const entries = details
        .map((entry) => {
          const userLocation = normalizeLocationName(entry?.userLocation || entry?.location || "");
          if (!userLocation) return null;
          return { value: userLocation, label: userLocation };
        })
        .filter(Boolean);

      if (entries.length > 0) {
        const seen = new Set();
        return entries.filter((e) => (seen.has(e.value) ? false : seen.add(e.value)));
      }

      const fallbackLocation = normalizeLocationName(user?.userLocation || "");
      if (!fallbackLocation) return [];
      return [{ value: fallbackLocation, label: fallbackLocation }];
    }

    function clearLocationChoices() {
      locationChoices.clearStore();
      locationChoices.setChoices(
        [{ value: "", label: "Select location", disabled: true, selected: true }],
        "value", "label", true,
      );
    }

    function populateLocationChoices(user) {
      const entries = getUserLocationEntries(user);
      if (entries.length === 0) {
        clearLocationChoices();
        return;
      }
      const autoSelect = entries.length === 1;
      locationChoices.clearStore();
      locationChoices.setChoices(
        [
          { value: "", label: "Select location", disabled: true, selected: !autoSelect, placeholder: true },
          ...entries.map((e, i) => ({ value: e.value, label: e.label, selected: autoSelect && i === 0 })),
        ],
        "value", "label", true,
      );
    }

    function findRecord(clientName, userName) {
      return (
        fetchedClientData?.users?.find(
          (u) =>
            u.clientName?.toLowerCase() === clientName.toLowerCase() &&
            u.userName?.toLowerCase() === userName.toLowerCase(),
        ) || null
      );
    }

    clientSelect.addEventListener("change", async function () {
      const clientName = this.value;
      setVal("#user-contact", "");
      clearLocationChoices();
      userObjIdEl.value = "";
      userChoices.removeActiveItems();
      userChoices.clearStore();
      if (!clientName) return;

      try {
        const res = await fetch(`/fairtech/form/labels/${encodeURIComponent(clientName)}`);
        if (!res.ok) throw new Error("Network response not ok");
        fetchedClientData = await res.json();

        if (asteriskClientType) {
          asteriskClientType.textContent = `(${fetchedClientData.clientType})`;
          asteriskClientType.classList.remove("badge-dealer", "badge-client");
          if (asteriskClientType.textContent === "(DEALER)") {
            asteriskClientType.classList.add("badge-dealer");
          } else if (asteriskClientType.textContent === "(CLIENT)") {
            asteriskClientType.classList.add("badge-client");
          }
        }
        updateRates();

        const usernames = [...new Set(fetchedClientData.users.map((u) => u.userName))];
        userChoices.setChoices(
          usernames.map((name) => ({ value: name, label: name })),
          "value", "label", true,
        );

        if (usernames.length === 1) {
          userChoices.setChoiceByValue(usernames[0]);
          userSelect.value = usernames[0];
          handleUserChange();
        }
      } catch (err) {
        console.error("Fetch error:", err);
      }
    });

    function handleUserChange() {
      const record = findRecord(clientSelect.value, userSelect.value);
      if (record) {
        setVal("#user-contact", record.userContact || "");
        populateLocationChoices(record);
        userObjIdEl.value = record._id;
      }
    }
    userSelect.addEventListener("change", handleUserChange);

    /* ================= MOBILE FORMAT ================= */
    const userContact = document.getElementById("user-contact");
    userContact.addEventListener("keydown", (e) => {
      const allowed = ["Backspace", "ArrowLeft", "ArrowRight", "Tab"];
      if (!/^\d$/.test(e.key) && !allowed.includes(e.key)) e.preventDefault();
    });
    userContact.addEventListener("input", function () {
      const digits = this.value.replace(/\D/g, "").slice(0, 10);
      this.value = digits.length > 5 ? `${digits.slice(0, 5)} ${digits.slice(5)}` : digits;
    });

    /* ================= ORDER QTY COMMA FORMATTING ================= */
    const totalOrderQtyInput = document.getElementById("total-order-qty");
    if (totalOrderQtyInput) totalOrderQtyInput.addEventListener("input", applyQtyCommaFormatting);

    /* ================= INIT ================= */
    smartFilterBusy = true;
    initMode = true;
    repopulate();
    initMode = false;
    smartFilterBusy = false;
  });

  /* ================= ORDER QTY COMMA FORMATTING ================= */
  function formatQtyWithCommas(raw) {
    const digits = String(raw ?? "").replace(/[^\d]/g, "");
    return digits ? Number(digits).toLocaleString("en-US") : "";
  }
  function applyQtyCommaFormatting() {
    const el = document.getElementById("total-order-qty");
    if (!el) return;
    const prev = el.value;
    const formatted = formatQtyWithCommas(prev);
    if (formatted === prev) return;
    const caret = el.selectionStart ?? prev.length;
    const digitsBeforeCaret = prev.slice(0, caret).replace(/[^\d]/g, "").length;
    el.value = formatted;
    if (document.activeElement === el) {
      let pos = 0, seen = 0;
      while (pos < formatted.length && seen < digitsBeforeCaret) {
        if (/\d/.test(formatted[pos])) seen++;
        pos++;
      }
      el.setSelectionRange(pos, pos);
    }
  }

  /* ================= FORM GUARD ================= */
  function validateLabelBeforeSubmit() {
    const masterId = document.getElementById("label-master-id").value;
    if (!masterId) {
      if (window.showToast) window.showToast("Please select a valid color label specification.", true);
      return false;
    }
    // Strip the display commas so the stored value is a plain number.
    const totalOrderQtyInput = document.getElementById("total-order-qty");
    if (totalOrderQtyInput) totalOrderQtyInput.value = totalOrderQtyInput.value.replace(/,/g, "");
    return true;
  }
</script>
