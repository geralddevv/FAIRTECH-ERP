<% layout('/layout/boilerplate') %>
<%
  // GET /form/label-master (create) and GET /labels/edit/:id (edit): the same
  // Master Label card the dialogs use, as a page of its own -- for anyone who
  // lands on the URL directly. The list's "+ Label" and the profile's "Edit
  // Label" open it as a dialog instead. Markup: _labelMasterForm.ejs.
  const m = (typeof master !== 'undefined' && master) ? master : null;
%>
<div class="main-content">
  <%- include('./_labelMasterForm', { lm: {
    mode: m ? 'edit' : 'create',
    master: m,
    previewId: typeof previewLabelProductId !== 'undefined' ? previewLabelProductId : '',
    standalone: true,
    cancelHref: m ? `/fairtech/labels/profile/${m._id}` : '/fairtech/labels/view',
  } }) %>
</div>
