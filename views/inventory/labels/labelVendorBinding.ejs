<% layout('/layout/boilerplate') %>

<%
  const cfg = pageConfig || {};
%>

<style>
  .item-id-success {
    border: 2px solid #28a745 !important;
    background-color: #f3fff6;
    color: #155724;
    font-weight: 600;
  }

  .item-id-error {
    border: 2px solid #dc3545 !important;
    background-color: #fff5f5;
    color: #721c24;
    font-weight: 600;
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
  <form id="vendor-item-form" action="/fairtech/form/vendor-item-binding/<%= cfg.key %>" method="post" class="needs-validation" autocomplete="off" novalidate>
    <div class="span-full form-heading">
      <h1>Vendor Label</h1>
    </div>

    <div class="span-full form-subheading">
      <h1>FS Info</h1>
    </div>

    <div class="span-six">
      <label for="resolved-item-display">Item ID</label>
      <input type="text" id="resolved-item-display" class="form-control" placeholder="Will appear here" readonly required />
    </div>

    <div class="span-seven">
      <label for="vendor-name">Vendor Name</label>
      <select name="vendorName" id="vendor-name" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (vendors || []).forEach((vendor) => { %>
          <option value="<%= vendor %>"><%= vendor %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-seven">
      <label for="vendor-user-name">Vendor User</label>
      <select name="vendorUserId" id="vendor-user-name" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
      </select>
    </div>

    <div class="span-six">
      <label for="vendor-user-contact">Contact</label>
      <input type="text" id="vendor-user-contact" class="form-control" name="userContact" placeholder="Will appear here" readonly required />
    </div>

    <div class="span-six">
      <label for="vendor-binding-location">Location</label>
      <select name="location" id="vendor-binding-location" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select location</option>
      </select>
    </div>

    <div class="span-full form-subheading" style="display: flex; justify-content: space-between; align-items: center;">
      <h1>Label Specifications</h1>
      <button type="button" id="reset-specs-btn" style="padding: 4px 12px; border-radius: 4px; background-color: #dc3545; color: white; border: none; cursor: pointer; font-size: 14px;">
        Reset
      </button>
    </div>

    <div class="span-five">
      <label for="label-family">Family</label>
      <select name="labelFamily" id="label-family" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.labelFamily || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-five">
      <label for="label-paper-type">Paper Type</label>
      <select name="paperType" id="label-paper-type" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.paperType || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-four">
      <label for="label-paper-code">Paper Code</label>
      <select name="paperCode" id="label-paper-code" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.paperCode || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-four">
      <label for="label-width">Width</label>
      <select name="labelWidth" id="label-width" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.labelWidth || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-four">
      <label for="label-height">Height</label>
      <select name="labelHeight" id="label-height" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.labelHeight || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-five">
      <label for="label-gap">Gap</label>
      <select name="labelGap" id="label-gap" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.labelGap || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-five">
      <label for="label-ups">UPS</label>
      <select name="labelUps" id="label-ups" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.labelUps || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-five">
      <label for="label-core">Core</label>
      <select name="labelCore" id="label-core" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% (specOptions.labelCore || []).forEach((opt) => { %>
          <option value="<%= opt %>"><%= opt %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-full form-subheading">
      <h1>Vendor Overrides</h1>
    </div>

    <div class="span-seven">
      <label for="vendor-label-paper-code">Vendor Paper Code</label>
      <input type="text" id="vendor-label-paper-code" class="form-control" name="vendorLabelPaperCode" placeholder="Enter Vendor Paper Code" required />
    </div>

    <div class="span-seven">
      <label for="vendor-label-paper-type">Vendor Paper Type</label>
      <input type="text" id="vendor-label-paper-type" class="form-control" name="vendorLabelPaperType" placeholder="Enter Vendor Paper Type" required />
    </div>

    <div class="span-six">
      <label for="label-rate-per-k">Rate Per 1000</label>
      <input type="number" id="label-rate-per-k" class="form-control" name="labelRatePerK" placeholder="Enter rate" step="0.01" min="0" />
    </div>

    <div class="span-six">
      <label for="label-min-qty">MSQ</label>
      <input type="number" id="label-min-qty" class="form-control" name="labelMinQty" placeholder="Enter MSQ" min="0" required />
    </div>

    <input type="hidden" name="<%= cfg.bindingField %>" id="resolved-item-id" />

    <div class="btn-grp span-full">
      <button type="submit" id="vendor-item-submit">Save <%= cfg.heading %></button>
    </div>
  </form>
</div>

<script>
document.addEventListener("DOMContentLoaded", async () => {
  const pageConfig = <%- safeJson(cfg) %>;
  const prefillData = <%- safeJson(prefillData) %>;

  const form = document.getElementById("vendor-item-form");
  const submitBtn = document.getElementById("vendor-item-submit");
  const vendorSelect = document.getElementById("vendor-name");
  const userSelect = document.getElementById("vendor-user-name");
  const contactInput = document.getElementById("vendor-user-contact");
  const locationSelect = document.getElementById("vendor-binding-location");
  const itemIdInput = document.getElementById("resolved-item-id");
  const itemDisplayInput = document.getElementById("resolved-item-display");

  const labelFields = [
    "label-family",
    "label-paper-type",
    "label-paper-code",
    "label-width",
    "label-height",
    "label-gap",
    "label-ups",
    "label-core",
  ];

  const fieldToApiKey = {
    "label-family": "labelFamily",
    "label-paper-type": "paperType",
    "label-paper-code": "paperCode",
    "label-width": "labelWidth",
    "label-height": "labelHeight",
    "label-gap": "labelGap",
    "label-ups": "labelUps",
    "label-core": "labelCore",
  };

  const fieldToParam = fieldToApiKey;

  const vendorChoices = new Choices(vendorSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
  const userChoices = new Choices(userSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
  const locationChoices = new Choices(locationSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function getUserLocationEntries(user) {
    const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
    const entries = details
      .map((entry) => {
        const loc = normalizeLocationName(entry?.userLocation || entry?.location || "");
        if (!loc) return null;
        return { value: loc, label: loc };
      })
      .filter(Boolean);

    if (entries.length > 0) {
      const seen = new Set();
      return entries.filter((e) => (seen.has(e.value) ? false : seen.add(e.value)));
    }

    const fallbackLocation = normalizeLocationName(user?.userLocation || "");
    if (!fallbackLocation) return [];
    return [{ value: fallbackLocation, label: fallbackLocation }];
  }

  function clearLocationChoices() {
    locationChoices.clearStore();
    locationChoices.setChoices(
      [{ value: "", label: "Select location", disabled: true, selected: true }],
      "value",
      "label",
      true,
    );
  }

  function populateLocationChoices(user) {
    const entries = getUserLocationEntries(user);
    if (entries.length === 0) {
      clearLocationChoices();
      return;
    }
    const autoSelect = entries.length === 1;
    locationChoices.clearStore();
    locationChoices.setChoices(
      [
        { value: "", label: "Select location", disabled: true, selected: !autoSelect, placeholder: true },
        ...entries.map((e, i) => ({ value: e.value, label: e.label, selected: autoSelect && i === 0 })),
      ],
      "value",
      "label",
      true,
    );
  }

  const specChoices = {};
  labelFields.forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      specChoices[id] = new Choices(el, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    }
  });

  const vendorLabelPaperCodeEl = document.getElementById("vendor-label-paper-code");
  const vendorLabelPaperTypeEl = document.getElementById("vendor-label-paper-type");
  const labelMinQtyEl = document.getElementById("label-min-qty");

  let smartFilterBusy = false;

  function resetUserFields() {
    contactInput.value = "";
    clearLocationChoices();
  }

  function resetUserChoices() {
    userChoices.removeActiveItems();
    userChoices.clearChoices();
    userChoices.setChoices([{ value: "", label: "Search", disabled: true, selected: true }], "value", "label", true);
    resetUserFields();
  }

  function resetResolvedItem() {
    itemIdInput.value = "";
    itemDisplayInput.value = "";
    itemDisplayInput.classList.remove("item-id-success", "item-id-error");
    submitBtn.disabled = true;
  }

  function prefillVendorOverrides(data) {
    if (vendorLabelPaperCodeEl && !vendorLabelPaperCodeEl.value) {
      vendorLabelPaperCodeEl.value = data.paperCode || "";
    }
    if (vendorLabelPaperTypeEl && !vendorLabelPaperTypeEl.value) {
      vendorLabelPaperTypeEl.value = data.paperType || "";
    }
    if (labelMinQtyEl && !labelMinQtyEl.value && data[pageConfig.minQtyField]) {
      labelMinQtyEl.value = data[pageConfig.minQtyField];
    }
  }

  async function populateVendorUsers(vendorName) {
    resetUserChoices();
    if (!vendorName) return;

    try {
      const response = await fetch(`/fairtech/form/vendor-item-binding/${pageConfig.key}/vendor/${encodeURIComponent(vendorName)}`);
      const vendorData = await response.json();
      const users = Array.isArray(vendorData?.users) ? vendorData.users : [];
      if (!users.length) return;

      userChoices.setChoices(
        users.map((user, index) => ({
          value: user._id,
          label: user.userName || "",
          selected: index === 0,
          customProperties: {
            contact: user.userContact || "",
            locationDetails: user.locationDetails || [],
            userLocation: user.userLocation || "",
          },
        })),
        "value",
        "label",
        true,
      );

      contactInput.value = users[0].userContact || "";
      populateLocationChoices(users[0]);
    } catch (err) {
      console.error("Vendor users fetch failed:", err);
      resetUserChoices();
    }
  }

  async function filterSpecs(changedFieldId) {
    const params = new URLSearchParams();
    labelFields.forEach((id) => {
      const el = document.getElementById(id);
      if (el && el.value) {
        params.set(fieldToParam[id], el.value);
      }
    });

    const res = await fetch(`/fairtech/form/vendor-item-binding/${pageConfig.key}/filter-specs?${params}`);
    const data = await res.json();
    if (!data) return;

    const autoSelected = [];

    labelFields.forEach((id) => {
      if (id === changedFieldId) return;
      const apiKey = fieldToApiKey[id];
      const filteredValues = data[apiKey] || [];
      const currentValue = document.getElementById(id)?.value || "";
      const filteredValueSet = new Set(filteredValues.map((v) => String(v)));
      const choicesInstance = specChoices[id];

      if (choicesInstance) {
        const newChoices = filteredValues.map((v) => ({
          value: String(v),
          label: String(v),
          selected: String(v) === currentValue,
        }));

        if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
          const autoValue = String(filteredValues[0]);
          if (id === "label-paper-code" && vendorLabelPaperCodeEl) vendorLabelPaperCodeEl.value = autoValue;
          if (id === "label-paper-type" && vendorLabelPaperTypeEl) vendorLabelPaperTypeEl.value = autoValue;
        }

        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
          "value",
          "label",
          true,
        );

        if (currentValue && filteredValueSet.has(String(currentValue))) {
          choicesInstance.setChoiceByValue(String(currentValue));
        } else if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          choicesInstance.setChoiceByValue(String(filteredValues[0]));
        } else if (!filteredValues.length) {
          const el = document.getElementById(id);
          if (el) el.value = "";
        }
      }
    });

    if (autoSelected.length > 0) {
      await filterSpecs(autoSelected[0]);
    }
  }

  async function handleSmartFilterChange(changedFieldId) {
    if (smartFilterBusy) return;
    smartFilterBusy = true;
    try {
      await filterSpecs(changedFieldId);
      await resolveItem();
    } finally {
      smartFilterBusy = false;
    }
  }

  async function resolveItem() {
    resetResolvedItem();
    const values = {};
    for (const id of labelFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) return;
      values[id] = el.value;
    }

    const params = new URLSearchParams();
    labelFields.forEach(id => params.set(fieldToParam[id], values[id]));

    const res = await fetch(`/fairtech/form/vendor-item-binding/${pageConfig.key}/resolve?${params}`);
    if (!res.ok) {
      itemDisplayInput.value = "No matching item found";
      itemDisplayInput.classList.add("item-id-error");
      return;
    }

    const data = await res.json();
    itemIdInput.value = data.itemId;
    itemDisplayInput.value = data.displayValue;
    itemDisplayInput.classList.add("item-id-success");
    submitBtn.disabled = false;

    prefillVendorOverrides(data);
  }

  vendorSelect.addEventListener("change", async () => {
    try {
      await populateVendorUsers(vendorSelect.value);
    } catch (err) {
      console.error("Vendor fetch failed:", err);
      resetUserChoices();
    }
  });

  userSelect.addEventListener("change", () => {
    const selectedId = userChoices.getValue(true);
    if (!selectedId) return resetUserFields();

    const selectedUser = userChoices._store.choices.find((choice) => choice.value === selectedId);
    contactInput.value = selectedUser?.customProperties?.contact || "";
    populateLocationChoices({
      locationDetails: selectedUser?.customProperties?.locationDetails || [],
      userLocation: selectedUser?.customProperties?.userLocation || "",
    });
  });

  labelFields.forEach((id) => {
    const field = document.getElementById(id);
    if (!field) return;

    const syncToOverride = (val) => {
      const v = val || "";
      if (id === "label-paper-code" && vendorLabelPaperCodeEl) vendorLabelPaperCodeEl.value = v;
      if (id === "label-paper-type" && vendorLabelPaperTypeEl) vendorLabelPaperTypeEl.value = v;
    };

    field.addEventListener("change", () => {
      syncToOverride(field.value);
      handleSmartFilterChange(id);
    });
    field.addEventListener("addItem", (e) => {
      syncToOverride(e.detail.value);
      handleSmartFilterChange(id);
    });
  });

  if (prefillData) {
    labelFields.forEach(id => {
      const apiKey = fieldToApiKey[id];
      if (prefillData[apiKey] !== undefined) {
        specChoices[id].setChoiceByValue(String(prefillData[apiKey]));
      }
    });
    await resolveItem();
  }

  const resetSpecsBtn = document.getElementById("reset-specs-btn");
  if (resetSpecsBtn) {
    resetSpecsBtn.addEventListener("click", async () => {
      labelFields.forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.value = "";
        if (specChoices[id]) {
          specChoices[id].setChoiceByValue("");
        }
      });
      resetResolvedItem();
      vendorLabelPaperCodeEl.value = "";
      vendorLabelPaperTypeEl.value = "";
      labelMinQtyEl.value = "";

      vendorChoices.removeActiveItems();
      resetUserChoices();
      await filterSpecs("reset-all");
    });
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (!itemIdInput.value) {
      showVendorItemToast("Please select a valid item specification.", true);
      return;
    }

    submitBtn.disabled = true;
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)),
      });
      const data = await response.json();
      if (!response.ok || !data?.success) {
        showVendorItemToast(data?.message || "Failed to save vendor binding", true);
        submitBtn.disabled = false;
        return;
      }

      window.location.href = data.redirect || pageConfig.redirectTo;
    } catch (err) {
      console.error(err);
      showVendorItemToast("Failed to save vendor binding", true);
      submitBtn.disabled = false;
    }
  });

  submitBtn.disabled = true;
});

function showVendorItemToast(message, isError = true) {
  const existingToast = document.getElementById("vendor-item-toast");
  if (existingToast) existingToast.remove();

  const toast = document.createElement("div");
  toast.id = "vendor-item-toast";
  toast.className = `toast-notification ${isError ? "toast-error" : "toast-success"}`;
  toast.innerHTML = `
    <span>${message}</span>
    <span class="toast-close" onclick="this.parentElement.remove()">×</span>
  `;

  document.body.appendChild(toast);
  setTimeout(() => {
    if (toast.parentElement) {
      toast.style.animation = "slideOut 0.5s forwards";
      setTimeout(() => toast.remove(), 500);
    }
  }, 5000);
}
</script>
