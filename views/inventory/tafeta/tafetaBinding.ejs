<% layout('/layout/boilerplate') %>
<style>
  /* Tafeta ID badge beside the "Tafeta Specifications" heading -- shared
     look (.so-card__badge, formStyle.md) via salesOrderForm.css; only the
     resolved/error colour swap below is specific to this page. */
  #tafeta-id.tafeta-id-success {
    border-color: #059669;
    background-color: #f0fdf4;
    color: #065f46;
  }
  #tafeta-id.tafeta-id-error {
    border-color: var(--so-danger);
    background-color: #fff1f2;
    color: #9f1239;
  }

  /* Commission ₹ / % segmented control. Too narrow a row to host the full
     .so-switch component (its options are a 128px minimum each) -- this
     stays a small custom pair, sized to match the row's 40px fields. */
  .comm-mode-toggle {
    display: inline-flex;
    flex: none;
    height: var(--so-field-h);
    border: 1px solid var(--so-field-border);
    border-radius: var(--so-radius-sm);
    overflow: hidden;
  }
  .comm-mode-btn {
    border: none;
    background: var(--so-surface);
    color: var(--so-ink-soft);
    padding: 0 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }
  .comm-mode-btn + .comm-mode-btn {
    border-left: 1px solid var(--so-field-border);
  }
  .comm-mode-btn.active {
    background: var(--so-brand);
    color: #fff;
  }

  /* Widen only the open dropdown list for Client Name -- names here run
     long (e.g. "FLAIR WRITING EQUIPMENTS PVT LTD -FWEPL VALSAD") and get
     clipped at the select box's own width. The closed box stays as-is. */
  #client-name-div .choices__list--dropdown {
    width: max-content;
    min-width: 100%;
    max-width: 520px;
  }
</style>

<div class="main-content so-page">
  <form action="/fairtech/form/tafeta-binding" method="post" onsubmit="return validateTafetaBeforeSubmit()" class="needs-validation so-form" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1>Client Tafeta</h1></div>
      </header>

      <!-- ================= USER INFO =================
           Row: 8 + 8 + 8 + 8 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">User Info</h2></div>
        </div>
        <div class="so-grid">
          <div id="client-name-div" class="span-eight">
            <label for="client-name"><span class="so-label-text">Client Name</span></label>
            <select name="clientName" id="client-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% for (let client of clients) { %>
              <option value="<%= client %>"><%= client %></option>
              <% } %>
            </select>
          </div>
          <div id="user-name-div" class="span-eight">
            <label for="client-user-name"><span class="so-label-text">User Name</span></label>
            <select id="client-user-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div id="user-name-contact-div" class="span-eight">
            <label for="user-contact"><span class="so-label-text">User Contact</span></label>
            <input type="text" id="user-contact" class="form-control" name="userContact" placeholder="Enter User Contact" required />
          </div>
          <div id="client-location-div" class="span-eight">
            <label for="client-location"><span class="so-label-text">Location</span></label>
            <select name="location" id="client-location" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Select location</option>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= TAFETA SPECIFICATIONS =================
           Row: 5 + 5 + 3 + 3 + 3 + 3 + 4 + 3 + 3 = 32. -->
      <section class="so-card">
        <div class="so-card__head so-card__head--wrap">
          <span class="so-card__icon"><i class="fa-solid fa-ruler-combined"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Tafeta Specifications</h2></div>
          <!-- Tafeta ID lives beside the heading, not in the field grid
               below -- it's the resolved identifier for whatever specs are
               picked, not one more spec to fill in, and keeping it out of
               .so-grid means the row below keeps its own clean 32-column
               math regardless of how this badge is sized. Shared look:
               .so-card__badge (formStyle.md). -->
          <div class="so-card__badge" title="Resolves once Material Code, Material Type, Color, GSM, Width, MTRS, Core Length, Notch and Core ID match one Tafeta">
            <span class="so-card__badge-label">Tafeta ID</span>
            <input type="text" id="tafeta-id" name="tafetaProductId" class="so-card__badge-input" placeholder="Will appear here" readonly required />
          </div>
          <div class="so-card__aside">
            <button type="button" id="reset-specs-btn" class="so-toggle"><i class="fa-solid fa-rotate-left"></i> Reset</button>
          </div>
        </div>
        <div class="so-grid">
          <div class="span-five">
            <label for="tafeta-material-code"><span class="so-label-text">Material Code</span></label>
            <select name="tafetaMaterialCode" id="tafeta-material-code" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% materialCodes?.forEach(pc => { %>
                <option value="<%= pc %>"><%= pc %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tafeta-material-type"><span class="so-label-text">Material Type</span></label>
            <select name="tafetaMaterialType" id="tafeta-material-type" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% materialTypes?.forEach(pt => { %>
                <option value="<%= pt %>"><%= pt %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-three">
            <label for="tafeta-color"><span class="so-label-text">Color</span></label>
            <select name="tafetaColor" id="tafeta-color" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% colors?.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-three">
            <label for="tafeta-gsm"><span class="so-label-text">GSM</span></label>
            <select name="tafetaGsm" id="tafeta-gsm" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% gsms?.forEach(g => { %>
                <option value="<%= g %>"><%= g %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-three">
            <label for="tafeta-width"><span class="so-label-text">Width</span></label>
            <select name="tafetaWidth" id="tafeta-width" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% widths?.forEach(w => { %>
                <option value="<%= w %>"><%= w %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-three">
            <label for="tafeta-mtrs"><span class="so-label-text">MTRS</span></label>
            <select name="tafetaMtrs" id="tafeta-mtrs" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% mtrsList?.forEach(m => { %>
                <option value="<%= m %>"><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tafeta-core-len"><span class="so-label-text">Core Length</span></label>
            <select name="tafetaCoreLen" id="tafeta-core-len" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% coreLens?.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-three">
            <label for="tafeta-notch"><span class="so-label-text">Notch</span></label>
            <select name="tafetaNotch" id="tafeta-notch" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% notches?.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-three">
            <label for="tafeta-core-id"><span class="so-label-text">Core ID</span></label>
            <select name="tafetaCoreId" id="tafeta-core-id" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% coreIds?.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= CLIENT OVERRIDES =================
           8 fields x span-eight = 4 per row, 2 rows, 32 each. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-sliders"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Client Overrides</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="tafeta-client-material-code"><span class="so-label-text">Client Material Code</span></label>
            <input type="text" id="tafeta-client-material-code" class="form-control" name="tafetaClientMaterialCode" placeholder="Enter Client Material Code" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-client-material-type"><span class="so-label-text">Client Material Type</span></label>
            <input type="text" id="tafeta-client-material-type" class="form-control" name="tafetaClientMaterialType" placeholder="Enter Client Material Type" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-client-gsm"><span class="so-label-text">Client GSM</span></label>
            <input type="text" id="tafeta-client-gsm" class="form-control" name="clientTafetaGsm" placeholder="Enter Client GSM" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-mtrs-del"><span class="so-label-text">MTRS Delivered</span></label>
            <input type="text" id="tafeta-mtrs-del" class="form-control" name="tafetaMtrsDel" placeholder="Enter MTRS Delivered" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-rate-per-roll"><span class="so-label-text">Rate Per Roll</span></label>
            <input type="text" id="tafeta-rate-per-roll" class="form-control" name="tafetaRatePerRoll" placeholder="Enter rate per roll" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-commission"><span class="so-label-text">Commission Per Roll</span></label>
            <div style="display: flex; gap: 6px; align-items: stretch; width: 100%;">
              <input type="text" id="tafeta-commission" class="form-control" name="commissionValue" placeholder="Commission" style="flex: 1; min-width: 0;" />
              <div class="comm-mode-toggle" role="group" aria-label="Commission type">
                <button type="button" class="comm-mode-btn active" data-mode="VALUE" title="Flat amount per roll">₹</button>
                <button type="button" class="comm-mode-btn" data-mode="PERCENT" title="Percentage of Rate Per Roll">%</button>
              </div>
            </div>
            <span id="commission-hint" style="display: none; font-size: 11px; font-weight: 600; color: var(--so-faint);"></span>
            <input type="hidden" name="commissionMode" id="tafeta-commission-mode" value="VALUE" />
            <input type="hidden" name="commissionPerRoll" id="tafeta-commission-resolved" value="" />
          </div>
          <div class="span-eight">
            <label for="tafeta-our-amt"><span class="so-label-text">Our Amount Per Roll</span></label>
            <input type="text" id="tafeta-our-amt" class="form-control" placeholder="Auto-calculated" tabindex="-1" readonly />
          </div>
          <div class="span-eight">
            <label for="tafeta-sale-cost"><span class="so-label-text">Sales sq mtrs Cost</span></label>
            <input type="text" id="tafeta-sale-cost" class="form-control" name="tafetaSaleCost" placeholder="Auto-calculated" tabindex="-1" required readonly />
          </div>
        </div>
      </section>

      <!-- ================= PRICING & ORDER TERMS =================
           Row: 8 + 8 + 8 + 8 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-cart-shopping"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Pricing &amp; Order Terms</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="tafeta-min-qty"><span class="so-label-text">Minimum Order QTY</span></label>
            <input type="text" id="tafeta-min-qty" class="form-control" name="tafetaMinQty" placeholder="Enter minimum qty" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-odr-qty"><span class="so-label-text">Order QTY</span></label>
            <input type="text" id="tafeta-odr-qty" class="form-control" name="tafetaOdrQty" placeholder="Enter order qty" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-odr-freq"><span class="so-label-text">Repeat Order Freq</span></label>
            <input type="text" id="tafeta-odr-freq" class="form-control" name="tafetaOdrFreq" placeholder="Enter repeat order frequency" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-credit-term"><span class="so-label-text">CR</span></label>
            <input type="text" id="tafeta-credit-term" class="form-control" name="tafetaCreditTerm" placeholder="Enter credit term" required />
          </div>
          <input type="hidden" name="tafetaId" id="resolved-tafeta-id" />
          <input type="hidden" name="userId" id="user-id" />
        </div>
      </section>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="so-actions">
      <span class="so-actions__hint">
        <i class="fa-regular fa-circle-check"></i>
        <span class="so-actions__hint-text">Specs resolve automatically once Material Code, Material Type, Color, GSM, Width, MTRS, Core Length, Notch and Core ID match one Tafeta.</span>
      </span>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Save Tafeta Rating</button>
    </div>
  </form>
</div>

<!-- ===== RATE CALCULATION & JS ===== -->
<script src="/js/choices.min.js"></script>
<script>
(function () {
  // Full text on hover for anything this page cuts short with an ellipsis --
  // see formStyle.md's "Long text" section. Delegated from document, so it
  // also covers what Choices builds later (dropdown options).
  const TRUNCATING = [
    ".so-page .so-label-text",
    ".so-page .form-control",
    ".so-page #tafeta-id",
    ".so-page .choices__list--single .choices__item",
    ".so-page .choices__list--dropdown .choices__item",
    ".so-page .choices__list[aria-expanded] .choices__item",
    ".so-page .so-actions__hint-text",
  ].join(",");

  document.addEventListener("mouseover", (e) => {
    const el = e.target instanceof Element ? e.target.closest(TRUNCATING) : null;
    if (!el) return;
    const full = (el.matches("input, textarea") ? el.value : el.textContent).replace(/\s+/g, " ").trim();
    const isCut = el.scrollWidth > el.clientWidth + 1;
    if (isCut && full) {
      el.title = full;
      el.dataset.soTip = "1";
    } else if (el.dataset.soTip) {
      el.removeAttribute("title");
      delete el.dataset.soTip;
    }
  });
})();

document.addEventListener("DOMContentLoaded", () => {
  /* ================= ELEMENTS ================= */
  const submitBtn = document.querySelector("button[type='submit']");

  const clientSelect = document.getElementById("client-name");
  const userSelect = document.getElementById("client-user-name");

  const userIdInput = document.getElementById("user-id");
  const userContactInput = document.getElementById("user-contact");
  const locationSelect = document.getElementById("client-location");
  const tafetaMtrsInput = document.getElementById("tafeta-mtrs");
  const tafetaMtrsDelInput = document.getElementById("tafeta-mtrs-del");

  const tafetaIdInput = document.getElementById("resolved-tafeta-id");
  const tafetaIdDisplay = document.getElementById("tafeta-id");

  const tafetaFields = [
    "tafeta-material-code",
    "tafeta-material-type",
    "tafeta-color",
    "tafeta-gsm",
    "tafeta-width",
    "tafeta-mtrs",
    "tafeta-core-len",
    "tafeta-notch",
    "tafeta-core-id",
  ];

  const fieldToApiKey = {
    "tafeta-material-code": "materialCodes",
    "tafeta-material-type": "materialTypes",
    "tafeta-color": "colors",
    "tafeta-gsm": "gsms",
    "tafeta-width": "widths",
    "tafeta-mtrs": "mtrsList",
    "tafeta-core-len": "coreLens",
    "tafeta-notch": "notches",
    "tafeta-core-id": "coreIds",
  };

  const fieldToParam = {
    "tafeta-material-code": "tafetaMaterialCode",
    "tafeta-material-type": "tafetaMaterialType",
    "tafeta-color": "tafetaColor",
    "tafeta-gsm": "tafetaGsm",
    "tafeta-width": "tafetaWidth",
    "tafeta-mtrs": "tafetaMtrs",
    "tafeta-core-len": "tafetaCoreLen",
    "tafeta-notch": "tafetaNotch",
    "tafeta-core-id": "tafetaCoreId",
  };

  submitBtn.disabled = true;

  /* ================= CHOICES INIT ================= */
  const clientChoices = new Choices(clientSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
    // Default searchResultLimit (4) silently drops real matches when several
    // client names are near-identical -- widen it and tighten the fuzzy
    // threshold so every close match surfaces instead of being crowded out by
    // loose noise matches.
    searchResultLimit: 20,
    fuseOptions: { threshold: 0.3 },
  });

  const userChoices = new Choices(userSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  const locationChoices = new Choices(locationSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  // Full user docs for the selected client (kept for locationDetails lookup)
  let currentUsers = [];

  const specChoices = {};
  tafetaFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      specChoices[id] = new Choices(el, {
        searchEnabled: true,
        shouldSort: false,
        itemSelectText: "",
      });
    }
  });

  /* ================= HELPERS ================= */
  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function getUserLocationEntries(user) {
    const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
    const entries = details
      .map((entry) => {
        const userLocation = normalizeLocationName(entry?.userLocation || entry?.location || "");
        if (!userLocation) return null;
        return { value: userLocation, label: userLocation };
      })
      .filter(Boolean);

    if (entries.length > 0) {
      const seen = new Set();
      return entries.filter((e) => (seen.has(e.value) ? false : seen.add(e.value)));
    }

    const fallbackLocation = normalizeLocationName(user?.userLocation || "");
    if (!fallbackLocation) return [];
    return [{ value: fallbackLocation, label: fallbackLocation }];
  }

  function clearLocationChoices() {
    locationChoices.clearStore();
    locationChoices.setChoices(
      [{ value: "", label: "Select location", disabled: true, selected: true }],
      "value",
      "label",
      true
    );
  }

  function populateLocationChoices(user) {
    const entries = getUserLocationEntries(user);
    if (entries.length === 0) {
      clearLocationChoices();
      return;
    }
    const autoSelect = entries.length === 1;
    locationChoices.clearStore();
    locationChoices.setChoices(
      [
        { value: "", label: "Select location", disabled: true, selected: !autoSelect, placeholder: true },
        ...entries.map((e, i) => ({ value: e.value, label: e.label, selected: autoSelect && i === 0 })),
      ],
      "value",
      "label",
      true
    );
  }

  function resetUserFields() {
    userIdInput.value = "";
    userContactInput.value = "";
    clearLocationChoices();
  }

  function hardResetUserSelection() {
    userChoices.removeActiveItems();
    userChoices.clearChoices();
    resetUserFields();
  }

  function resetResolvedTafeta() {
    tafetaIdInput.value = "";
    tafetaIdDisplay.value = "";
    submitBtn.disabled = true;
    tafetaIdDisplay.classList.remove("tafeta-id-success", "tafeta-id-error");
  }

  function syncDeliveredMeters() {
    if (!tafetaMtrsInput || !tafetaMtrsDelInput) return;
    const currentMtrs = tafetaMtrsInput.value;
    tafetaMtrsDelInput.value = currentMtrs || "";
  }

  /* ================= SMART FILTER ================= */
  async function filterSpecs(changedFieldId) {
    const params = new URLSearchParams();
    tafetaFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.value) {
        params.set(fieldToParam[id], el.value);
      }
    });

    try {
      const res = await fetch(`/fairtech/form/tafeta-binding/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      tafetaFields.forEach(id => {
        if (id === changedFieldId) return; // skip the field that triggered the filter
        const choicesInstance = specChoices[id];
        if (!choicesInstance) return;

        const apiKey = fieldToApiKey[id];
        const filteredValues = data[apiKey] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map(v => ({
          value: String(v),
          label: String(v),
          selected: String(v) === currentValue,
        }));

        // Auto-select if exactly one option and nothing currently selected (and not resetting)
        if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some(c => c.selected) }, ...newChoices],
          "value",
          "label",
          true
        );
      });

      // If any fields were auto-selected, re-run filter to cascade
      if (autoSelected.length > 0) {
        await filterSpecs(autoSelected[0]);
        resolveTafeta();
      }
    } catch (err) {
      console.error("Filter specs error:", err);
    }
  }

  /* ================= CLIENT → USER ================= */
  clientSelect.addEventListener("change", async () => {
    const clientName = clientSelect.value;
    hardResetUserSelection();

    const res = await fetch(`/fairtech/form/tafeta-binding/client/${clientName}`);
    const clientData = await res.json();
    if (!clientData || !clientData.users) return;

    currentUsers = clientData.users;

    if (clientData.users.length === 1) {
      const u = clientData.users[0];
      userChoices.setChoices(
        [{
          value: u._id,
          label: u.userName,
          selected: true,
          customProperties: { mobile: u.userContact || "", location: u.userLocation || "" }
        }],
        "value",
        "label",
        true
      );
      userIdInput.value = u._id;
      userContactInput.value = u.userContact || "";
      populateLocationChoices(u);
      return;
    }

    userChoices.setChoices(
      clientData.users.map(u => ({
        value: u._id,
        label: u.userName,
        customProperties: { mobile: u.userContact || "", location: u.userLocation || "" }
      })),
      "value",
      "label",
      true
    );
    resetUserFields();
  });

  /* ================= USER CHANGE ================= */
  userSelect.addEventListener("change", () => {
    const selectedId = userChoices.getValue(true);
    if (!selectedId) return;

    const choice = userChoices._store.choices.find(c => c.value === selectedId);
    if (!choice) return;

    userIdInput.value = choice.value;
    userContactInput.value = choice.customProperties?.mobile || "";

    const selectedUser = currentUsers.find(u => String(u._id) === String(selectedId));
    populateLocationChoices(selectedUser || { userLocation: choice.customProperties?.location || "" });
  });

  /* ================= TAFETA RESOLVE ================= */
  async function resolveTafeta() {
    resetResolvedTafeta();
    syncDeliveredMeters();

    const values = {};
    for (let id of tafetaFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) return;
      values[id] = el.value;
    }

    const params = new URLSearchParams({
      tafetaMaterialCode: values["tafeta-material-code"],
      tafetaMaterialType: values["tafeta-material-type"],
      tafetaColor: values["tafeta-color"],
      tafetaGsm: values["tafeta-gsm"],
      tafetaWidth: values["tafeta-width"],
      tafetaMtrs: values["tafeta-mtrs"],
      tafetaCoreLen: values["tafeta-core-len"],
      tafetaNotch: values["tafeta-notch"],
      tafetaCoreId: values["tafeta-core-id"],
    });

    const res = await fetch(`/fairtech/form/tafeta-binding/resolve-tafeta?${params}`);

    if (!res.ok) {
      tafetaIdDisplay.value = "No matching Tafeta found";
      tafetaIdDisplay.classList.add("tafeta-id-error");
      return;
    }

    const data = await res.json();

    tafetaIdInput.value = data.tafetaId;
    tafetaIdDisplay.value = data.tafetaProductId;
    tafetaIdDisplay.classList.add("tafeta-id-success");
    submitBtn.disabled = false;

    document.getElementById("tafeta-client-material-code").value = values["tafeta-material-code"];
    document.getElementById("tafeta-client-material-type").value = values["tafeta-material-type"];
    document.getElementById("tafeta-client-gsm").value = values["tafeta-gsm"];
    calcSaleCost();
  }

  /* ================= SPEC CHANGE HANDLER ================= */
  tafetaFields.forEach(id => {
    document.getElementById(id)?.addEventListener("change", async () => {
      await filterSpecs(id);
      resolveTafeta();
    });
  });

  /* ================= RESET SPECS ================= */
  const resetSpecsBtn = document.getElementById("reset-specs-btn");
  if (resetSpecsBtn) {
    resetSpecsBtn.addEventListener("click", async () => {
      // Clear underlying values for tafeta specs & reset their Choices UI
      tafetaFields.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";

        // Also clear the Choices visible selection
        if (specChoices[id]) {
          specChoices[id].setChoiceByValue("");
        }
      });

      resetResolvedTafeta();

      // Clear the overrides if populated
      const clientMaterialCode = document.getElementById("tafeta-client-material-code");
      if (clientMaterialCode) clientMaterialCode.value = "";
      const clientMaterialType = document.getElementById("tafeta-client-material-type");
      if (clientMaterialType) clientMaterialType.value = "";
      const clientGsm = document.getElementById("tafeta-client-gsm");
      if (clientGsm) clientGsm.value = "";

      // Clear all other text inputs
      const otherInputs = [
        "tafeta-mtrs-del",
        "tafeta-rate-per-roll",
        "tafeta-commission",
        "tafeta-sale-cost",
        "tafeta-min-qty",
        "tafeta-odr-qty",
        "tafeta-odr-freq",
        "tafeta-credit-term"
      ];
      otherInputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";
      });
      setCommissionMode("VALUE");
      if (commissionResolvedInput) commissionResolvedInput.value = "";
      if (commissionHint) { commissionHint.style.display = "none"; commissionHint.textContent = ""; }

      // Reset Client and User dropdowns
      if (typeof clientChoices !== "undefined") {
        clientChoices.setChoiceByValue("");
      }
      hardResetUserSelection();

      // Fetch fresh, unfiltered options and apply them to all fields
      await filterSpecs("reset-all");
    });
  }

  /* ================= RATE CALC + COMMISSION ================= */
  const widthInput = document.getElementById("tafeta-width");
  const ratePerRollInput = document.getElementById("tafeta-rate-per-roll");
  const saleCostInput = document.getElementById("tafeta-sale-cost");
  const commissionInput = document.getElementById("tafeta-commission");
  const commissionResolvedInput = document.getElementById("tafeta-commission-resolved");
  const commissionModeInput = document.getElementById("tafeta-commission-mode");
  const ourAmtInput = document.getElementById("tafeta-our-amt");
  const commissionHint = document.getElementById("commission-hint");

  let commissionMode = "VALUE";
  function resolveCommission() {
    const rate = Number(ratePerRollInput?.value) || 0;
    const raw = Number(commissionInput?.value) || 0;
    let ourAmt = rate;
    let resolved;
    if (commissionMode === "PERCENT") {
      ourAmt = raw ? rate / (1 + raw / 100) : rate;
      resolved = rate - ourAmt;
    } else {
      resolved = raw;
      ourAmt = Math.max(0, rate - raw);
    }
    const resolvedRounded = Math.round(resolved * 100) / 100;
    if (commissionResolvedInput) commissionResolvedInput.value = raw ? String(resolvedRounded) : "";
    if (ourAmtInput) ourAmtInput.value = rate ? (Math.round(ourAmt * 100) / 100).toFixed(2) : "";
    if (commissionHint) {
      if (commissionMode === "PERCENT" && raw) {
        commissionHint.style.display = "block";
        commissionHint.textContent = `= ₹${resolvedRounded.toLocaleString("en-IN")} per roll`;
      } else {
        commissionHint.style.display = "none";
        commissionHint.textContent = "";
      }
    }
    return ourAmt;
  }

  function setCommissionMode(mode) {
    commissionMode = mode === "PERCENT" ? "PERCENT" : "VALUE";
    if (commissionModeInput) commissionModeInput.value = commissionMode;
    document.querySelectorAll(".comm-mode-btn").forEach((b) =>
      b.classList.toggle("active", b.dataset.mode === commissionMode));
    calcSaleCost();
  }
  document.querySelectorAll(".comm-mode-btn").forEach((b) =>
    b.addEventListener("click", () => setCommissionMode(b.dataset.mode)));

  function calcSaleCost() {
    const netRate = resolveCommission();
    if (!widthInput?.value || !tafetaMtrsInput?.value || !netRate) {
      saleCostInput.value = "";
      return;
    }
    const area = (Number(widthInput.value) * Number(tafetaMtrsInput.value)) / 1000;
    if (!area) { saleCostInput.value = ""; return; }
    saleCostInput.value = (netRate / area).toFixed(4);
  }

  if (widthInput) widthInput.addEventListener("input", calcSaleCost);
  tafetaMtrsInput.addEventListener("input", () => {
    syncDeliveredMeters();
    calcSaleCost();
  });
  tafetaMtrsInput.addEventListener("change", syncDeliveredMeters);
  tafetaMtrsInput.addEventListener("addItem", syncDeliveredMeters);
  if (ratePerRollInput) ratePerRollInput.addEventListener("input", calcSaleCost);
  if (commissionInput) commissionInput.addEventListener("input", calcSaleCost);
});

/* ================= CUSTOM TOAST ================= */
function showClientToast(message, isError = true) {
  const existingToast = document.getElementById("client-toast");
  if (existingToast) existingToast.remove();

  const toast = document.createElement("div");
  toast.id = "client-toast";
  toast.className = `toast-notification ${isError ? 'toast-error' : 'toast-success'}`;
  toast.innerHTML = `
    <span>${message}</span>
    <span class="toast-close" onclick="this.parentElement.remove()">×</span>
  `;

  document.body.appendChild(toast);

  setTimeout(() => {
    if (toast.parentElement) {
       toast.style.animation = "slideOut 0.5s forwards";
       setTimeout(() => toast.remove(), 500);
    }
  }, 5000);
}

/* ================= FORM GUARD ================= */
function validateTafetaBeforeSubmit() {
  const tafetaId = document.getElementById("resolved-tafeta-id").value;
  if (!tafetaId) {
    showClientToast("Please select a valid Tafeta specification.", true);
    return false;
  }

  const minQty = Number(document.getElementById("tafeta-min-qty").value);
  const odrQty = Number(document.getElementById("tafeta-odr-qty").value);

  if (minQty >= odrQty) {
    showClientToast("Order Quantity must be greater than Minimum Stock Quantity", true);
    return false;
  }

  return true;
}
</script>
