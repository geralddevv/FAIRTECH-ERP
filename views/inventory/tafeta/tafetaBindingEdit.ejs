<% layout('/layout/boilerplate') -%>
<style>
  /* Commission ₹ / % segmented control -- same as the create page. */
  .comm-mode-toggle {
    display: inline-flex;
    flex: none;
    height: var(--so-field-h);
    border: 1px solid var(--so-field-border);
    border-radius: var(--so-radius-sm);
    overflow: hidden;
  }
  .comm-mode-btn {
    border: none;
    background: var(--so-surface);
    color: var(--so-ink-soft);
    padding: 0 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }
  .comm-mode-btn + .comm-mode-btn { border-left: 1px solid var(--so-field-border); }
  .comm-mode-btn.active { background: var(--so-brand); color: #fff; }
</style>

<div class="main-content so-page">
  <form class="needs-validation so-form" action="/fairtech/tafeta-binding/edit/<%= binding._id %>" method="post" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>" />

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1>Edit Tafeta Binding</h1></div>
      </header>

      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">User Info</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label><span class="so-label-text">Client Name</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.clientName || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">User Name</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.userName || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label for="binding-location"><span class="so-label-text">Location</span></label>
            <select name="location" id="binding-location" class="form-control select-tag" required>
              <% (userLocations || []).forEach(loc => { %>
                <option value="<%= loc %>" <%= (binding.location || '') === loc ? 'selected' : '' %>><%= loc %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-eight">
            <label for="binding-status"><span class="so-label-text">Status</span></label>
            <select name="status" id="binding-status" class="form-control select-tag" required>
              <option value="ACTIVE" <%= binding.status === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
              <option value="INACTIVE" <%= binding.status === "INACTIVE" ? "selected" : "" %>>INACTIVE</option>
            </select>
          </div>
        </div>
      </section>

      <section class="so-card">
        <div class="so-card__head so-card__head--wrap">
          <span class="so-card__icon"><i class="fa-solid fa-ruler-combined"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Tafeta Specifications</h2></div>
          <div class="so-card__badge">
            <span class="so-card__badge-label">Tafeta ID</span>
            <input type="text" class="so-card__badge-input" value="<%= binding.tafetaId?.tafetaProductId || 'N/A' %>" readonly />
          </div>
        </div>
        <div class="so-grid">
          <div class="span-five">
            <label><span class="so-label-text">Material Code</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaMaterialCode || '' %>" readonly />
          </div>
          <div class="span-five">
            <label><span class="so-label-text">Material Type</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaMaterialType || '' %>" readonly />
          </div>
          <div class="span-three">
            <label><span class="so-label-text">Color</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaColor || '' %>" readonly />
          </div>
          <div class="span-three">
            <label><span class="so-label-text">GSM</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaGsm || '' %>" readonly />
          </div>
          <div class="span-three">
            <label><span class="so-label-text">Width</span></label>
            <input type="text" class="form-control" id="tafeta-width" value="<%= binding.tafetaId?.tafetaWidth || '' %>" readonly />
          </div>
          <div class="span-three">
            <label><span class="so-label-text">MTRS</span></label>
            <input type="text" class="form-control" id="tafeta-mtrs" value="<%= binding.tafetaId?.tafetaMtrs || '' %>" readonly />
          </div>
          <div class="span-four">
            <label><span class="so-label-text">Core Length</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaCoreLen || '' %>" readonly />
          </div>
          <div class="span-three">
            <label><span class="so-label-text">Notch</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaNotch || '' %>" readonly />
          </div>
          <div class="span-three">
            <label><span class="so-label-text">Core ID</span></label>
            <input type="text" class="form-control" value="<%= binding.tafetaId?.tafetaCoreId || '' %>" readonly />
          </div>
        </div>
      </section>

      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-sliders"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Client Overrides</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="tafeta-tafetaClientMaterialCode"><span class="so-label-text">Client Material Code</span></label>
            <input type="text" id="tafeta-tafetaClientMaterialCode" name="tafetaClientMaterialCode" class="form-control" value="<%= binding.tafetaClientMaterialCode %>" />
          </div>
          <div class="span-eight">
            <label for="tafeta-tafetaClientMaterialType"><span class="so-label-text">Client Material Type</span></label>
            <input type="text" id="tafeta-tafetaClientMaterialType" name="tafetaClientMaterialType" class="form-control" value="<%= binding.tafetaClientMaterialType %>" />
          </div>
          <div class="span-eight">
            <label for="tafeta-clientTafetaGsm"><span class="so-label-text">Client GSM</span></label>
            <input type="text" id="tafeta-clientTafetaGsm" name="clientTafetaGsm" class="form-control" value="<%= binding.clientTafetaGsm %>" />
          </div>
          <div class="span-eight">
            <label for="tafeta-tafetaMtrsDel"><span class="so-label-text">MTRS Delivered</span></label>
            <input type="text" id="tafeta-tafetaMtrsDel" name="tafetaMtrsDel" class="form-control" value="<%= binding.tafetaMtrsDel %>" />
          </div>
          <div class="span-eight">
            <label for="tafeta-rate-per-roll"><span class="so-label-text">Rate Per Roll</span></label>
            <input type="text" name="tafetaRatePerRoll" id="tafeta-rate-per-roll" class="form-control" value="<%= binding.tafetaRatePerRoll %>" />
          </div>
          <% const _commMode = binding.commissionMode === "PERCENT" ? "PERCENT" : "VALUE";
             const _commRaw = (binding.commissionValue !== undefined && binding.commissionValue !== null && String(binding.commissionValue) !== "" && Number(binding.commissionValue) !== 0)
               ? binding.commissionValue
               : (binding.commissionPerRoll || ''); %>
          <div class="span-eight">
            <label for="tafeta-commission"><span class="so-label-text">Commission Per Roll</span></label>
            <div style="display: flex; gap: 6px; align-items: stretch; width: 100%;">
              <input type="text" id="tafeta-commission" name="commissionValue" class="form-control"
                value="<%= _commRaw %>" placeholder="Commission" style="flex: 1; min-width: 0;" />
              <div class="comm-mode-toggle" role="group" aria-label="Commission type">
                <button type="button" class="comm-mode-btn <%= _commMode === 'VALUE' ? 'active' : '' %>" data-mode="VALUE" title="Flat amount per roll">₹</button>
                <button type="button" class="comm-mode-btn <%= _commMode === 'PERCENT' ? 'active' : '' %>" data-mode="PERCENT" title="Percentage of Rate Per Roll">%</button>
              </div>
            </div>
            <span id="commission-hint" style="display: none; font-size: 11px; font-weight: 600; color: var(--so-faint);"></span>
            <input type="hidden" name="commissionMode" id="tafeta-commission-mode" value="<%= _commMode %>" />
            <input type="hidden" name="commissionPerRoll" id="tafeta-commission-resolved" value="<%= binding.commissionPerRoll || '' %>" />
          </div>
          <div class="span-eight">
            <label for="tafeta-our-amt"><span class="so-label-text">Our Amount Per Roll</span></label>
            <input type="text" id="tafeta-our-amt" class="form-control" placeholder="Auto-calculated" tabindex="-1" readonly />
          </div>
          <div class="span-eight">
            <label for="tafeta-sale-cost"><span class="so-label-text">Sales sq mtrs Cost</span></label>
            <input type="text" name="tafetaSaleCost" id="tafeta-sale-cost" class="form-control" value="<%= binding.tafetaSaleCost %>" placeholder="Auto-calculated" tabindex="-1" required readonly />
          </div>
        </div>
      </section>

      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-cart-shopping"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Pricing &amp; Order Terms</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="tafeta-tafetaMinQty"><span class="so-label-text">Minimum Order QTY</span></label>
            <input type="text" id="tafeta-tafetaMinQty" name="tafetaMinQty" class="form-control" value="<%= binding.tafetaMinQty %>" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-tafetaOdrQty"><span class="so-label-text">Order QTY</span></label>
            <input type="text" id="tafeta-tafetaOdrQty" name="tafetaOdrQty" class="form-control" value="<%= binding.tafetaOdrQty %>" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-tafetaOdrFreq"><span class="so-label-text">Repeat Order Freq</span></label>
            <input type="text" id="tafeta-tafetaOdrFreq" name="tafetaOdrFreq" class="form-control" value="<%= binding.tafetaOdrFreq || '' %>" required />
          </div>
          <div class="span-eight">
            <label for="tafeta-tafetaCreditTerm"><span class="so-label-text">CR</span></label>
            <input type="text" id="tafeta-tafetaCreditTerm" name="tafetaCreditTerm" class="form-control" value="<%= binding.tafetaCreditTerm || '' %>" required />
          </div>
        </div>
      </section>
    </div>

    <div class="so-actions">
      <button type="button" id="cancelBtn" class="so-btn so-btn--ghost">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update Tafeta Binding</button>
    </div>
  </form>
</div>

<script>
  document.getElementById("cancelBtn").addEventListener("click", () => {
    window.history.back();
  });

  (function () {
    const widthVal = Number(document.getElementById("tafeta-width")?.value) || 0;
    const mtrsVal = Number(document.getElementById("tafeta-mtrs")?.value) || 0;
    const rateInput = document.getElementById("tafeta-rate-per-roll");
    const costInput = document.getElementById("tafeta-sale-cost");
    const commissionInput = document.getElementById("tafeta-commission");
    const commissionResolvedInput = document.getElementById("tafeta-commission-resolved");
    const commissionModeInput = document.getElementById("tafeta-commission-mode");
    const ourAmtInput = document.getElementById("tafeta-our-amt");
    const commissionHint = document.getElementById("commission-hint");

    let commissionMode = commissionModeInput?.value === "PERCENT" ? "PERCENT" : "VALUE";

    function resolveCommission() {
      const rate = Number(rateInput?.value) || 0;
      const raw = Number(commissionInput?.value) || 0;
      let ourAmt = rate;
      let resolved;
      if (commissionMode === "PERCENT") {
        ourAmt = raw ? rate / (1 + raw / 100) : rate;
        resolved = rate - ourAmt;
      } else {
        resolved = raw;
        ourAmt = Math.max(0, rate - raw);
      }
      const resolvedRounded = Math.round(resolved * 100) / 100;
      if (commissionResolvedInput) commissionResolvedInput.value = raw ? String(resolvedRounded) : "";
      if (ourAmtInput) ourAmtInput.value = rate ? (Math.round(ourAmt * 100) / 100).toFixed(2) : "";
      if (commissionHint) {
        if (commissionMode === "PERCENT" && raw) {
          commissionHint.style.display = "block";
          commissionHint.textContent = `= ₹${resolvedRounded.toLocaleString("en-IN")} per roll`;
        } else {
          commissionHint.style.display = "none";
          commissionHint.textContent = "";
        }
      }
      return ourAmt;
    }

    function setCommissionMode(mode) {
      commissionMode = mode === "PERCENT" ? "PERCENT" : "VALUE";
      if (commissionModeInput) commissionModeInput.value = commissionMode;
      document.querySelectorAll(".comm-mode-btn").forEach((b) =>
        b.classList.toggle("active", b.dataset.mode === commissionMode));
      calcSaleCost();
    }
    document.querySelectorAll(".comm-mode-btn").forEach((b) =>
      b.addEventListener("click", () => setCommissionMode(b.dataset.mode)));

    function calcSaleCost() {
      const area = (widthVal * mtrsVal) / 1000;
      const netRate = resolveCommission();
      if (!area || !netRate) { costInput.value = ""; return; }
      costInput.value = (netRate / area).toFixed(4);
    }

    if (rateInput) rateInput.addEventListener("input", calcSaleCost);
    if (commissionInput) commissionInput.addEventListener("input", calcSaleCost);
    calcSaleCost();
  })();
</script>
