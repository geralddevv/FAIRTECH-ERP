<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<!-- Form style (formStyle.md) for the Add/Edit/Delete Magnet dialogs. Linked
     here (not via CSS: ) because this page's CSS slot already holds
     tableDisp.css for the table. -->
<link href="<%= formStyleHref %>" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    .btn-action {
      height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
      font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
    }
    .btn-action:hover { opacity: 0.85; }
  </style>

  <div class="indi-head">
    <h1>Magnet Master</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button type="button" class="header-action-btn" onclick="soDialog.open('magnet-add-dialog')">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Magnet
      </button>
    </div>
  </div>

  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD DIALOG (formStyle.md) ============ -->
<div id="magnet-add-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="magnet-add-form" class="so-dialog" action="/fairtech/form/magnet" method="post" autocomplete="off" novalidate data-so-form role="dialog" aria-modal="true" aria-labelledby="magnet-add-title">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-magnet"></i></span>
      <div><h3 class="so-dialog__title" id="magnet-add-title">Add Magnet</h3></div>
    </div>
    <div class="so-dialog__body">
      <div class="so-dialog__field">
        <label for="magnet-add-name">Magnet Name <span class="so-req">*</span></label>
        <input type="text" id="magnet-add-name" name="magnetName" placeholder="Enter magnet name" maxlength="100" required data-so-autofocus />
      </div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="magnet-add-size">Size</label>
          <input type="text" id="magnet-add-size" name="size" placeholder="Enter size" maxlength="100" />
        </div>
        <div class="so-dialog__field">
          <label for="magnet-add-vendor">Vendor</label>
          <select id="magnet-add-vendor" name="vendorName">
            <option value="">Select Vendor</option>
            <% (vendors || []).forEach((v) => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="so-dialog__field">
        <label for="magnet-add-date">Date <span class="so-req">*</span></label>
        <input type="date" id="magnet-add-date" name="date" value="<%= todayStr %>" required />
      </div>
    </div>
    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('magnet-add-dialog')">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Save</button>
    </div>
  </form>
</div>

<!-- ============ EDIT DIALOG (formStyle.md) ============ -->
<div id="magnet-edit-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="magnet-edit-form" class="so-dialog" action="/fairtech/api/magnets/" method="post" autocomplete="off" novalidate data-so-form role="dialog" aria-modal="true" aria-labelledby="magnet-edit-title">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-pen-to-square"></i></span>
      <div><h3 class="so-dialog__title" id="magnet-edit-title">Edit Magnet</h3></div>
    </div>
    <div class="so-dialog__body">
      <div class="so-dialog__field">
        <label for="magnet-edit-name">Magnet Name <span class="so-req">*</span></label>
        <input type="text" id="magnet-edit-name" name="magnetName" placeholder="Enter magnet name" maxlength="100" required data-so-autofocus />
      </div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="magnet-edit-size">Size</label>
          <input type="text" id="magnet-edit-size" name="size" placeholder="Enter size" maxlength="100" />
        </div>
        <div class="so-dialog__field">
          <label for="magnet-edit-vendor">Vendor</label>
          <select id="magnet-edit-vendor" name="vendorName"></select>
        </div>
      </div>
      <div class="so-dialog__field">
        <label for="magnet-edit-date">Date <span class="so-req">*</span></label>
        <input type="date" id="magnet-edit-date" name="date" required />
      </div>
    </div>
    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('magnet-edit-dialog')">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update</button>
    </div>
  </form>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG (formStyle.md) ============ -->
<div id="magnet-delete-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <div class="so-dialog so-dialog--sm" role="dialog" aria-modal="true" aria-labelledby="magnet-delete-title">
    <div class="so-dialog__head">
      <span class="so-dialog__icon so-dialog__icon--danger"><i class="fa-solid fa-triangle-exclamation"></i></span>
      <div>
        <h3 class="so-dialog__title" id="magnet-delete-title">Delete Magnet?</h3>
        <p class="so-dialog__desc">Are you sure you want to delete <strong id="magnet-delete-name"></strong>? This cannot be undone.</p>
      </div>
    </div>
    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('magnet-delete-dialog')">Cancel</button>
      <button type="button" class="so-btn so-btn--danger" id="magnet-delete-confirm-btn" onclick="submitDelete()">Yes, Delete</button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="table-data" type="application/json"><%- safeJson(magnets || []) %></script>
<script id="vendors-data" type="application/json"><%- safeJson(vendors || []) %></script>

<script>
  const tableData = JSON.parse(document.getElementById("table-data").textContent);
  const vendorsData = JSON.parse(document.getElementById("vendors-data").textContent);
  const findRow = (id) => tableData.find((r) => String(r._id) === String(id));

  function fmtDate(v) {
    if (!v) return "—";
    const parts = String(v).split("-");
    return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : v;
  }

  // Rebuilds the Edit dialog's Vendor options from Vendor Master, adding the
  // record's own saved vendor if it no longer matches an active one -- same
  // treatment the rest of the app gives a stored vendor/paper code that's
  // since gone missing from the master.
  function buildEditVendorOptions(selectedName) {
    const names = selectedName && !vendorsData.includes(selectedName) ? [...vendorsData, selectedName] : vendorsData;
    const sel = document.getElementById("magnet-edit-vendor");
    sel.innerHTML = '<option value="">Select Vendor</option>' +
      names.map((v) => `<option value="${v}"${v === selectedName ? " selected" : ""}>${v}</option>`).join("");
  }

  // ---- EDIT ----
  window.openEditDialog = function (id) {
    const row = findRow(id);
    if (!row) return;
    window.soDialog.open("magnet-edit-dialog");
    const form = document.getElementById("magnet-edit-form");
    form.action = `/fairtech/api/magnets/${id}`;
    document.getElementById("magnet-edit-name").value = row.magnetName || "";
    document.getElementById("magnet-edit-size").value = row.size || "";
    document.getElementById("magnet-edit-date").value = row.date || "";
    buildEditVendorOptions(row.vendorName || "");
  };

  // ---- DELETE ----
  let deleteId = null;

  window.openDeleteDialog = function (id) {
    const row = findRow(id);
    if (!row) return;
    deleteId = id;
    document.getElementById("magnet-delete-name").textContent = row.magnetName;
    window.soDialog.open("magnet-delete-dialog");
  };

  async function submitDelete() {
    if (!deleteId) return;
    const btn = document.getElementById("magnet-delete-confirm-btn");
    btn.disabled = true;
    try {
      const res = await fetch(`/fairtech/api/magnets/${deleteId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        window.soDialog.close("magnet-delete-dialog");
        showToast(data.message || "Failed to delete magnet.", true);
      }
    } catch {
      window.soDialog.close("magnet-delete-dialog");
      showToast("Error deleting magnet.", true);
    } finally {
      btn.disabled = false;
    }
  }

  // ---- Table ----
  const table = new Tabulator("#master-table", {
    data: tableData,
    placeholder: "No magnets added yet",
    initialSort: [{ column: "magnetName", dir: "asc" }],
    columns: [
      srNoColumn(),
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 100,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="openEditDialog('${row._id}')" class="btn-action" style="background:#e67e22;" title="Edit Magnet"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="openDeleteDialog('${row._id}')" class="btn-action" style="background:#d9534f;" title="Delete Magnet"><i class="fa-solid fa-trash"></i></button>
            </div>
          `;
        },
      },
      {
        title: "Magnet Name",
        field: "magnetName",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        formatter: (cell) => `<span style="font-weight:600; color:#03365a;">${cell.getValue() || ""}</span>`,
      },
      {
        title: "Size",
        field: "size",
        headerFilter: "input",
        headerFilterPlaceholder: "Filter...",
        formatter: (cell) => cell.getValue() || "—",
      },
      {
        title: "Vendor",
        field: "vendorName",
        headerFilter: "input",
        headerFilterPlaceholder: "Filter...",
        formatter: (cell) => cell.getValue() || "—",
      },
      {
        title: "Date",
        field: "date",
        headerFilter: "input",
        headerFilterPlaceholder: "Filter date...",
        formatter: (cell) => fmtDate(cell.getValue()),
      },
    ],
  });
</script>
<script src="/js/soFormDialog.js?v=1"></script>
