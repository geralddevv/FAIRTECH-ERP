<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    .btn-action {
      height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
      font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
    }
    .btn-action:hover { opacity: 0.85; }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
      background: #fff;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
  </style>

  <div class="indi-head">
    <h1>Print Cylinder Master</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openAddDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Print Cylinder
      </button>
    </div>
  </div>

  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD DIALOG ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(420px, 95vw); padding: 0; border-radius: 14px; overflow: hidden;">
    <div class="dialog-header">
      <h2 id="addDialogTitle">Add Print Cylinder</h2>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <label class="dialog-field-label" for="addNameInput">Print Cylinder Name</label>
      <input
        type="text"
        id="addNameInput"
        class="form-control premium-input"
        placeholder="Enter print cylinder name"
        autocomplete="off"
        maxlength="100"
      />
      <div id="addNameError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ EDIT DIALOG ============ -->
<div class="logout-modal" id="editDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="editDialogTitle"
    style="width: min(420px, 95vw); padding: 0; border-radius: 14px; overflow: hidden;">
    <div class="dialog-header">
      <h2 id="editDialogTitle">Edit Print Cylinder</h2>
      <button class="dialog-close-btn" type="button" onclick="closeEditDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <label class="dialog-field-label" for="editNameInput">Print Cylinder Name</label>
      <input
        type="text"
        id="editNameInput"
        class="form-control premium-input"
        placeholder="Enter print cylinder name"
        autocomplete="off"
        maxlength="100"
      />
      <div id="editNameError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeEditDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="editSubmitBtn" onclick="submitEdit()">Update</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG ============ -->
<div class="logout-modal" id="deleteDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteDialogTitle"
    style="width: min(400px, 95vw);">
    <h2 class="logout-title" id="deleteDialogTitle">
      <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; margin-right: 8px;"></i>Delete Print Cylinder?
    </h2>
    <p class="logout-text">
      Are you sure you want to delete <strong id="deleteName"></strong>? This action cannot be undone.
    </p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" onclick="closeDeleteDialog()">Cancel</button>
      <button
        class="logout-btn"
        type="button"
        id="deleteConfirmBtn"
        onclick="submitDelete()"
        style="background: #ef4444; color: #fff; border-color: #ef4444;">
        Yes, Delete
      </button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="table-data" type="application/json"><%- safeJson(printCylinders || []) %></script>

<script>
  const tableData = JSON.parse(document.getElementById("table-data").textContent);
  const findRow = (id) => tableData.find((r) => String(r._id) === String(id));

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  // Dismiss on backdrop click
  ["addDialog", "editDialog", "deleteDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  // Dismiss on ESC
  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "editDialog", "deleteDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  // ---- ADD ----
  function openAddDialog() {
    document.getElementById("addNameInput").value = "";
    hideError("addNameError");
    openModal("addDialog");
    setTimeout(() => document.getElementById("addNameInput").focus(), 60);
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  document.getElementById("addNameInput").addEventListener("keydown", e => {
    if (e.key === "Enter") submitAdd();
  });

  async function submitAdd() {
    const name = document.getElementById("addNameInput").value.trim();
    if (!name) {
      showError("addNameError", "Print cylinder name is required.");
      return;
    }
    hideError("addNameError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/fairtech/form/print-cylinder", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ printCylinderName: name }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/fairtech/form/print-cylinder";
      } else {
        showError("addNameError", data.message || "Failed to add print cylinder.");
      }
    } catch {
      showError("addNameError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT ----
  let editId = null;

  window.openEditDialog = function (id) {
    const row = findRow(id);
    if (!row) return;
    editId = id;
    document.getElementById("editNameInput").value = row.printCylinderName;
    hideError("editNameError");
    openModal("editDialog");
    setTimeout(() => {
      const inp = document.getElementById("editNameInput");
      inp.focus();
      inp.select();
    }, 60);
  };
  function closeEditDialog() {
    closeModal("editDialog");
    editId = null;
  }

  document.getElementById("editNameInput").addEventListener("keydown", e => {
    if (e.key === "Enter") submitEdit();
  });

  async function submitEdit() {
    const name = document.getElementById("editNameInput").value.trim();
    if (!name) {
      showError("editNameError", "Print cylinder name is required.");
      return;
    }
    if (!editId) return;
    hideError("editNameError");
    setLoading("editSubmitBtn", true);
    try {
      const res = await fetch(`/fairtech/api/print-cylinders/${editId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ printCylinderName: name }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("editNameError", data.message || "Failed to update print cylinder.");
      }
    } catch {
      showError("editNameError", "Server error. Please try again.");
    } finally {
      setLoading("editSubmitBtn", false);
    }
  }

  // ---- DELETE ----
  let deleteId = null;

  window.openDeleteDialog = function (id) {
    const row = findRow(id);
    if (!row) return;
    deleteId = id;
    document.getElementById("deleteName").textContent = row.printCylinderName;
    openModal("deleteDialog");
  };
  function closeDeleteDialog() {
    closeModal("deleteDialog");
    deleteId = null;
  }

  async function submitDelete() {
    if (!deleteId) return;
    setLoading("deleteConfirmBtn", true);
    try {
      const res = await fetch(`/fairtech/api/print-cylinders/${deleteId}`, {
        method: "DELETE",
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        closeDeleteDialog();
        alert(data.message || "Failed to delete print cylinder.");
      }
    } catch {
      closeDeleteDialog();
      alert("Error deleting print cylinder.");
    } finally {
      setLoading("deleteConfirmBtn", false);
    }
  }

  // ---- Table ----
  const table = new Tabulator("#master-table", {
    data: tableData,
    placeholder: "No print cylinders added yet",
    initialSort: [{ column: "printCylinderName", dir: "asc" }],
    columns: [
      srNoColumn(),
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 100,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="openEditDialog('${row._id}')" class="btn-action" style="background:#e67e22;" title="Edit Print Cylinder"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="openDeleteDialog('${row._id}')" class="btn-action" style="background:#d9534f;" title="Delete Print Cylinder"><i class="fa-solid fa-trash"></i></button>
            </div>
          `;
        },
      },
      {
        title: "Print Cylinder Name",
        field: "printCylinderName",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        formatter: (cell) => `<span style="font-weight:600; color:#03365a;">${cell.getValue() || ""}</span>`,
      },
      {
        title: "Created",
        field: "createdAt",
        headerFilter: "input",
        headerFilterPlaceholder: "Filter date...",
        formatter: (cell) => (cell.getValue() ? new Date(cell.getValue()).toLocaleDateString("en-IN") : "—"),
      },
    ],
  });
</script>
