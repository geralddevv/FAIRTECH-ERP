<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<!-- Form style (formStyle.md) for the Add/Edit/Delete Location dialogs. Linked
     here (not via CSS: ) because this page's CSS slot already holds
     tableDisp.css for the table. -->
<link href="<%= formStyleHref %>" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    .btn-action {
      height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
      font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
    }
    .btn-action:hover { opacity: 0.85; }
  </style>

  <div class="indi-head">
    <h1>Location Master</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button type="button" class="header-action-btn" onclick="soDialog.open('location-add-dialog')">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Location
      </button>
    </div>
  </div>

  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD LOCATION DIALOG (formStyle.md) ============ -->
<div id="location-add-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="location-add-form" class="so-dialog" action="/fairtech/form/location" method="post" autocomplete="off" novalidate data-so-form role="dialog" aria-modal="true" aria-labelledby="location-add-title">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-location-dot"></i></span>
      <div><h3 class="so-dialog__title" id="location-add-title">Add Location</h3></div>
    </div>
    <div class="so-dialog__body">
      <div class="so-dialog__field">
        <label for="location-add-name">Location Name <span class="so-req">*</span></label>
        <input type="text" id="location-add-name" name="locationName" placeholder="Enter location name" maxlength="100" required data-so-autofocus />
      </div>
      <div class="so-dialog__field">
        <label for="location-add-date">Date <span class="so-req">*</span></label>
        <input type="date" id="location-add-date" name="date" value="<%= todayStr %>" required />
      </div>
    </div>
    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('location-add-dialog')">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Save</button>
    </div>
  </form>
</div>

<!-- ============ EDIT LOCATION DIALOG (formStyle.md) ============ -->
<div id="location-edit-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="location-edit-form" class="so-dialog" action="/fairtech/api/locations/" method="post" autocomplete="off" novalidate data-so-form role="dialog" aria-modal="true" aria-labelledby="location-edit-title">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-pen-to-square"></i></span>
      <div><h3 class="so-dialog__title" id="location-edit-title">Edit Location</h3></div>
    </div>
    <div class="so-dialog__body">
      <div class="so-dialog__field">
        <label for="location-edit-name">Location Name <span class="so-req">*</span></label>
        <input type="text" id="location-edit-name" name="locationName" placeholder="Enter location name" maxlength="100" required data-so-autofocus />
      </div>
      <div class="so-dialog__field">
        <label for="location-edit-date">Date <span class="so-req">*</span></label>
        <input type="date" id="location-edit-date" name="date" required />
      </div>
    </div>
    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('location-edit-dialog')">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update</button>
    </div>
  </form>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG (formStyle.md) ============ -->
<div id="location-delete-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <div class="so-dialog so-dialog--sm" role="dialog" aria-modal="true" aria-labelledby="location-delete-title">
    <div class="so-dialog__head">
      <span class="so-dialog__icon so-dialog__icon--danger"><i class="fa-solid fa-triangle-exclamation"></i></span>
      <div>
        <h3 class="so-dialog__title" id="location-delete-title">Delete Location?</h3>
        <p class="so-dialog__desc">Are you sure you want to delete <strong id="location-delete-name"></strong>? This cannot be undone.</p>
      </div>
    </div>
    <div class="so-dialog__foot">
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('location-delete-dialog')">Cancel</button>
      <button type="button" class="so-btn so-btn--danger" id="location-delete-confirm-btn" onclick="submitDelete()">Yes, Delete</button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="table-data" type="application/json"><%- safeJson(locations || []) %></script>

<script>
  const tableData = JSON.parse(document.getElementById("table-data").textContent);
  const findRow = (id) => tableData.find((r) => String(r._id) === String(id));

  function fmtDate(v) {
    if (!v) return "—";
    const parts = String(v).split("-");
    return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : v;
  }

  // ---- EDIT ----
  window.openEditDialog = function (id) {
    const row = findRow(id);
    if (!row) return;
    window.soDialog.open("location-edit-dialog");
    const form = document.getElementById("location-edit-form");
    form.action = `/fairtech/api/locations/${id}`;
    document.getElementById("location-edit-name").value = row.locationName || "";
    document.getElementById("location-edit-date").value = row.date || "";
  };

  // ---- DELETE ----
  let deleteId = null;

  window.openDeleteDialog = function (id) {
    const row = findRow(id);
    if (!row) return;
    deleteId = id;
    document.getElementById("location-delete-name").textContent = row.locationName;
    window.soDialog.open("location-delete-dialog");
  };

  async function submitDelete() {
    if (!deleteId) return;
    const btn = document.getElementById("location-delete-confirm-btn");
    btn.disabled = true;
    try {
      const res = await fetch(`/fairtech/api/locations/${deleteId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        window.soDialog.close("location-delete-dialog");
        showToast(data.message || "Failed to delete location.", true);
      }
    } catch {
      window.soDialog.close("location-delete-dialog");
      showToast("Error deleting location.", true);
    } finally {
      btn.disabled = false;
    }
  }

  // ---- Table ----
  const table = new Tabulator("#master-table", {
    data: tableData,
    placeholder: "No locations added yet",
    initialSort: [{ column: "locationName", dir: "asc" }],
    columns: [
      srNoColumn(),
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 100,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="openEditDialog('${row._id}')" class="btn-action" style="background:#e67e22;" title="Edit Location"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="openDeleteDialog('${row._id}')" class="btn-action" style="background:#d9534f;" title="Delete Location"><i class="fa-solid fa-trash"></i></button>
            </div>
          `;
        },
      },
      {
        title: "Location Name",
        field: "locationName",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        formatter: (cell) => `<span style="font-weight:600; color:#03365a;">${cell.getValue() || ""}</span>`,
      },
      {
        title: "Date",
        field: "date",
        headerFilter: "input",
        headerFilterPlaceholder: "Filter date...",
        formatter: (cell) => fmtDate(cell.getValue()),
      },
    ],
  });
</script>
<script src="/js/soFormDialog.js?v=1"></script>
