  <%- include('./_ttrMasterForm', { rm: {
    previewId: typeof previewTtrProductId !== 'undefined' ? previewTtrProductId : '',
    standalone: true,
    cancelHref: '/fairtech/ttr/view',
  } }) %>
</div>
