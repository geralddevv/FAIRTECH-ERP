<% layout('/layout/boilerplate') -%>
<style>
  /* Commission ₹ / % segmented control -- same as the create page. */
  .comm-mode-toggle {
    display: inline-flex;
    flex: none;
    height: var(--so-field-h);
    border: 1px solid var(--so-field-border);
    border-radius: var(--so-radius-sm);
    overflow: hidden;
  }
  .comm-mode-btn {
    border: none;
    background: var(--so-surface);
    color: var(--so-ink-soft);
    padding: 0 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }
  .comm-mode-btn + .comm-mode-btn { border-left: 1px solid var(--so-field-border); }
  .comm-mode-btn.active { background: var(--so-brand); color: #fff; }
</style>

<% const _m = binding.ttrId || {}; %>
<div class="main-content so-page">
  <form class="needs-validation so-form" action="/fairtech/ttr-binding/edit/<%= binding._id %>" method="post" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>" />

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1>Edit TTR Binding</h1></div>
      </header>

      <!-- ================= USER INFO ================= -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">User Info</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label><span class="so-label-text">Client Name</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.clientName || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">User Name</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.userName || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label for="binding-location"><span class="so-label-text">Location</span></label>
            <select name="location" id="binding-location" class="form-control select-tag" required>
              <% (userLocations || []).forEach(loc => { %>
                <option value="<%= loc %>" <%= (binding.location || '') === loc ? 'selected' : '' %>><%= loc %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-eight">
            <label for="binding-status"><span class="so-label-text">Status</span></label>
            <select name="status" id="binding-status" class="form-control select-tag" required>
              <option value="ACTIVE" <%= binding.status === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
              <option value="INACTIVE" <%= binding.status === "INACTIVE" ? "selected" : "" %>>INACTIVE</option>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= TTR SPECIFICATIONS (READ-ONLY) ================= -->
      <section class="so-card">
        <div class="so-card__head so-card__head--wrap">
          <span class="so-card__icon"><i class="fa-solid fa-ruler-combined"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">TTR Specifications</h2></div>
          <div class="so-card__badge">
            <span class="so-card__badge-label">TTR ID</span>
            <input type="text" class="so-card__badge-input" value="<%= _m.ttrProductId || 'N/A' %>" readonly />
          </div>
        </div>
        <div class="so-grid">
          <div class="span-seven"><label><span class="so-label-text">Material Code</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrMaterialCode || '' %>" readonly /></div>
          <div class="span-six"><label><span class="so-label-text">Type</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrType || '' %>" readonly /></div>
          <div class="span-six"><label><span class="so-label-text">Color</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrColor || '' %>" readonly /></div>
          <div class="span-six"><label><span class="so-label-text">Width</span></label>
            <input type="text" class="form-control" id="ttr-width" value="<%= _m.ttrWidth || '' %>" readonly /></div>
          <div class="span-seven"><label><span class="so-label-text">MTRS</span></label>
            <input type="text" class="form-control" id="ttr-mtrs" value="<%= _m.ttrMtrs || '' %>" readonly /></div>
          <div class="span-six"><label><span class="so-label-text">Ink Face</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrInkFace || '' %>" readonly /></div>
          <div class="span-six"><label><span class="so-label-text">Core ID</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrCoreId || '' %>" readonly /></div>
          <div class="span-six"><label><span class="so-label-text">Core Length</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrCoreLength || '' %>" readonly /></div>
          <div class="span-seven"><label><span class="so-label-text">Notch</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrNotch || '' %>" readonly /></div>
          <div class="span-seven"><label><span class="so-label-text">Winding</span></label>
            <input type="text" class="form-control" value="<%= _m.ttrWinding || '' %>" readonly /></div>
        </div>
      </section>

      <!-- ================= CLIENT OVERRIDES ================= -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-sliders"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Client Overrides</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-five">
            <label><span class="so-label-text">Client Material Code</span></label>
            <input type="text" name="ttrClientMaterialCode" class="form-control" value="<%= binding.ttrClientMaterialCode %>" />
          </div>
          <div class="span-four">
            <label><span class="so-label-text">Client Type</span></label>
            <input type="text" name="clientTtrType" class="form-control" value="<%= binding.clientTtrType %>" />
          </div>
          <div class="span-four">
            <label><span class="so-label-text">MTRS Delivered</span></label>
            <input type="text" name="ttrMtrsDel" class="form-control" value="<%= binding.ttrMtrsDel %>" />
          </div>
          <div class="span-four">
            <label for="ttr-rate-per-roll"><span class="so-label-text">Rate Per Roll</span></label>
            <input type="text" name="ttrRatePerRoll" id="ttr-rate-per-roll" class="form-control" value="<%= binding.ttrRatePerRoll %>" />
          </div>
          <% const _commMode = binding.commissionMode === "PERCENT" ? "PERCENT" : "VALUE";
             const _commRaw = (binding.commissionValue !== undefined && binding.commissionValue !== null && String(binding.commissionValue) !== "" && Number(binding.commissionValue) !== 0)
               ? binding.commissionValue
               : (binding.commissionPerRoll || ''); %>
          <div class="span-five">
            <label for="ttr-commission"><span class="so-label-text">Commission Per Roll</span></label>
            <div style="display: flex; gap: 6px; align-items: stretch; width: 100%;">
              <input type="text" id="ttr-commission" name="commissionValue" class="form-control"
                value="<%= _commRaw %>" placeholder="Commission" style="flex: 1; min-width: 0;" />
              <div class="comm-mode-toggle" role="group" aria-label="Commission type">
                <button type="button" class="comm-mode-btn <%= _commMode === 'VALUE' ? 'active' : '' %>" data-mode="VALUE" title="Flat amount per roll">₹</button>
                <button type="button" class="comm-mode-btn <%= _commMode === 'PERCENT' ? 'active' : '' %>" data-mode="PERCENT" title="Percentage of Rate Per Roll">%</button>
              </div>
            </div>
            <span id="commission-hint" style="display: none; font-size: 11px; font-weight: 600; color: var(--so-faint);"></span>
            <input type="hidden" name="commissionMode" id="ttr-commission-mode" value="<%= _commMode %>" />
            <input type="hidden" name="commissionPerRoll" id="ttr-commission-resolved" value="<%= binding.commissionPerRoll || '' %>" />
          </div>
          <div class="span-five">
            <label for="ttr-our-amt"><span class="so-label-text">Our Amount Per Roll</span></label>
            <input type="text" id="ttr-our-amt" class="form-control" placeholder="Auto-calculated" tabindex="-1" readonly />
          </div>
          <div class="span-five">
            <label for="ttr-sale-cost"><span class="so-label-text">Sales sq mtrs Cost</span></label>
            <input type="text" name="ttrSaleCost" id="ttr-sale-cost" class="form-control" value="<%= binding.ttrSaleCost %>" placeholder="Auto-calculated" tabindex="-1" required readonly />
          </div>
        </div>
      </section>

      <!-- ================= PRICING & ORDER TERMS ================= -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-cart-shopping"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Pricing &amp; Order Terms</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label><span class="so-label-text">Minimum Order Qty</span></label>
            <input type="text" name="ttrMinQty" class="form-control" value="<%= binding.ttrMinQty %>" />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">Order QTY</span></label>
            <input type="text" name="ttrOdrQty" class="form-control" value="<%= binding.ttrOdrQty %>" />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">Repeat Order Freq</span></label>
            <input type="text" name="ttrOdrFreq" class="form-control" value="<%= binding.ttrOdrFreq || '' %>" />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">CR</span></label>
            <input type="text" name="ttrCreditTerm" class="form-control" value="<%= binding.ttrCreditTerm || '' %>" />
          </div>
        </div>
      </section>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="so-actions">
      <button type="button" id="cancelBtn" class="so-btn so-btn--ghost">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update TTR Binding</button>
    </div>
  </form>
</div>

<script>
  document.getElementById("cancelBtn").addEventListener("click", () => {
    window.history.back();
  });

  (function () {
    const rateInput = document.getElementById("ttr-rate-per-roll");
    const saleCostInput = document.getElementById("ttr-sale-cost");
    const widthInput = document.getElementById("ttr-width");
    const mtrsInput = document.getElementById("ttr-mtrs");
    const commissionInput = document.getElementById("ttr-commission");
    const commissionResolvedInput = document.getElementById("ttr-commission-resolved");
    const commissionModeInput = document.getElementById("ttr-commission-mode");
    const ourAmtInput = document.getElementById("ttr-our-amt");
    const commissionHint = document.getElementById("commission-hint");

    let commissionMode = commissionModeInput?.value === "PERCENT" ? "PERCENT" : "VALUE";

    function resolveCommission() {
      const rate = Number(rateInput?.value) || 0;
      const raw = Number(commissionInput?.value) || 0;
      let ourAmt = rate;
      let resolved;
      if (commissionMode === "PERCENT") {
        ourAmt = raw ? rate / (1 + raw / 100) : rate;
        resolved = rate - ourAmt;
      } else {
        resolved = raw;
        ourAmt = Math.max(0, rate - raw);
      }
      const resolvedRounded = Math.round(resolved * 100) / 100;
      if (commissionResolvedInput) commissionResolvedInput.value = raw ? String(resolvedRounded) : "";
      if (ourAmtInput) ourAmtInput.value = rate ? (Math.round(ourAmt * 100) / 100).toFixed(2) : "";
      if (commissionHint) {
        if (commissionMode === "PERCENT" && raw) {
          commissionHint.style.display = "block";
          commissionHint.textContent = `= ₹${resolvedRounded.toLocaleString("en-IN")} per roll`;
        } else {
          commissionHint.style.display = "none";
          commissionHint.textContent = "";
        }
      }
      return ourAmt;
    }

    function setCommissionMode(mode) {
      commissionMode = mode === "PERCENT" ? "PERCENT" : "VALUE";
      if (commissionModeInput) commissionModeInput.value = commissionMode;
      document.querySelectorAll(".comm-mode-btn").forEach((b) =>
        b.classList.toggle("active", b.dataset.mode === commissionMode));
      calcSaleCost();
    }
    document.querySelectorAll(".comm-mode-btn").forEach((b) =>
      b.addEventListener("click", () => setCommissionMode(b.dataset.mode)));

    function calcSaleCost() {
      const width = Number(widthInput?.value);
      const mtrs = Number(mtrsInput?.value);
      const netRate = resolveCommission();
      if (!width || !mtrs || !netRate) { saleCostInput.value = ""; return; }
      const area = (width * mtrs) / 1000;
      saleCostInput.value = (netRate / area).toFixed(4);
    }

    if (rateInput) rateInput.addEventListener("input", calcSaleCost);
    if (commissionInput) commissionInput.addEventListener("input", calcSaleCost);
    calcSaleCost();
  })();
</script>
