<% layout('/layout/boilerplate') -%>

<style>
  .input-tag[readonly] {
    background: #f1f5f9;
    cursor: not-allowed;
  }
  /* Commission ₹ / % segmented toggle */
  .comm-mode-toggle {
    display: inline-flex;
    background: #e2e8f0;
    border-radius: 0.375rem;
    padding: 2px;
    gap: 2px;
  }
  .comm-mode-btn {
    border: none;
    background: transparent;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 0.3rem;
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s, color 0.15s;
  }
  .comm-mode-btn:hover:not(.active) { background: #cbd5e1; }
  .comm-mode-btn.active { background: #044a78; color: #fff; }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
  <form
    class="needs-validation"
    action="/fairtech/pos-roll-binding/edit/<%= binding._id %>"
    method="post"
    autocomplete="off"
    novalidate
  >
    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>" />
    <div class="span-full form-subheading gap">
      <h1>Edit POS Roll Binding</h1>
    </div>

    <!-- ================= READ-ONLY INFO ================= -->

    <div class="span-six">
      <label>POS Roll ID</label>
      <input
        type="text"
        class="form-control input-tag"
        value="<%= binding.posRollId?.posProductId || 'N/A' %>"
        readonly
      />
    </div>

    <div class="span-six">
      <label>Paper Code</label>
      <input type="text" class="form-control input-tag" value="<%= binding.posRollId?.posPaperCode || '' %>" readonly />
    </div>

    <div class="span-seven">
      <label>User Name</label>
      <input type="text" class="form-control input-tag" value="<%= binding.userId?.userName || '' %>" readonly />
    </div>

    <div class="span-seven">
      <label>Client Name</label>
      <input type="text" class="form-control input-tag" value="<%= binding.userId?.clientName || '' %>" readonly />
    </div>

    <div class="span-six">
      <label for="binding-location">Location</label>
      <select name="location" id="binding-location" class="form-control select-tag" required>
        <% (userLocations || []).forEach(loc => { %>
          <option value="<%= loc %>" <%= (binding.location || '') === loc ? 'selected' : '' %>><%= loc %></option>
        <% }) %>
      </select>
    </div>

    <!-- ================= POS ROLL MASTER SPECS (READ-ONLY) ================= -->

    <div class="span-six">
      <label>Paper Type</label>
      <input type="text" class="form-control input-tag" value="<%= binding.posRollId?.posPaperType || '' %>" readonly />
    </div>

    <div class="span-seven">
      <label>Color</label>
      <input type="text" class="form-control input-tag" value="<%= binding.posRollId?.posColor || '' %>" readonly />
    </div>

    <div class="span-six">
      <label>GSM</label>
      <input type="text" class="form-control input-tag" value="<%= binding.posRollId?.posGsm || '' %>" readonly />
    </div>

    <div class="span-six">
      <label>Width</label>
      <input
        type="text"
        class="form-control input-tag"
        id="pos-width"
        value="<%= binding.posRollId?.posWidth || '' %>"
        readonly
      />
    </div>

    <div class="span-six">
      <label>MTRS</label>
      <input
        type="text"
        class="form-control input-tag"
        id="pos-mtrs"
        value="<%= binding.posRollId?.posMtrs || '' %>"
        readonly
      />
    </div>

    <div class="span-seven">
      <label>Core ID</label>
      <input type="text" class="form-control input-tag" value="<%= binding.posRollId?.posCoreId || '' %>" readonly />
    </div>

    <!-- ================= CLIENT SPECIFICATIONS ================= -->

    <div class="span-full form-subheading">
      <h1>Client Specifications</h1>
    </div>

    <div class="span-seven">
      <label>Client Paper Code</label>
      <input
        type="text"
        name="posClientPaperCode"
        class="form-control"
        value="<%= binding.posClientPaperCode %>"
        required
      />
    </div>

    <div class="span-seven">
      <label>Client Material Type</label>
      <input
        type="text"
        name="posClientMaterialType"
        class="form-control"
        value="<%= binding.posClientMaterialType || '' %>"
        required
      />
    </div>

    <div class="span-seven">
      <label>Client GSM</label>
      <input type="text" name="clientPosGsm" class="form-control" value="<%= binding.clientPosGsm %>" required />
    </div>

    <div class="span-six">
      <label>MTRS Delivered</label>
      <input type="text" name="posMtrsDel" class="form-control" value="<%= binding.posMtrsDel %>" required />
    </div>

    <div class="span-six">
      <label>Rate Per Roll</label>
      <input
        type="text"
        name="posRatePerRoll"
        id="pos-rate-per-roll"
        class="form-control"
        value="<%= binding.posRatePerRoll %>"
        required
      />
    </div>

    <% const _commMode = binding.commissionMode === "PERCENT" ? "PERCENT" : "VALUE";
       const _commRaw = (binding.commissionValue !== undefined && binding.commissionValue !== null && String(binding.commissionValue) !== "" && Number(binding.commissionValue) !== 0)
         ? binding.commissionValue
         : (binding.commissionPerRoll || ''); %>
    <div class="span-six">
      <label for="pos-commission">Commission Per Roll</label>
      <div style="display: flex; gap: 6px; align-items: stretch; width: 100%;">
        <input type="text" id="pos-commission" name="commissionValue" class="form-control"
          value="<%= _commRaw %>" placeholder="Commission" style="flex: 1; min-width: 0;" />
        <div class="comm-mode-toggle" role="group" aria-label="Commission type">
          <button type="button" class="comm-mode-btn <%= _commMode === 'VALUE' ? 'active' : '' %>" data-mode="VALUE" title="Flat amount per roll">₹</button>
          <button type="button" class="comm-mode-btn <%= _commMode === 'PERCENT' ? 'active' : '' %>" data-mode="PERCENT" title="Percentage of Rate Per Roll">%</button>
        </div>
      </div>
      <span id="commission-hint" style="display: none; font-size: 12px; font-weight: 600; color: #6b7280; margin-top: 4px;"></span>
      <input type="hidden" name="commissionMode" id="pos-commission-mode" value="<%= _commMode %>" />
      <input type="hidden" name="commissionPerRoll" id="pos-commission-resolved" value="<%= binding.commissionPerRoll || '' %>" />
    </div>
    <div class="span-six">
      <label for="pos-our-amt">Our Amount Per Roll</label>
      <input type="text" id="pos-our-amt" class="form-control" tabindex="-1" readonly />
    </div>

    <div class="span-six">
      <label>Sales sq mtrs Cost</label>
      <input
        type="text"
        name="posSaleCost"
        id="pos-sale-cost"
        class="form-control"
        value="<%= binding.posSaleCost %>"
        tabindex="-1"
        required
        readonly
      />
    </div>

    <!-- ================= PRICING & ORDER TERMS ================= -->

    <div class="span-full form-subheading">
      <h1>Pricing & Order Terms</h1>
    </div>

    <div class="span-seven">
      <label>Minimum Order QTY</label>
      <input type="text" name="posMinQty" class="form-control" value="<%= binding.posMinQty %>" required />
    </div>

    <div class="span-six">
      <label>Order QTY</label>
      <input type="text" name="posOdrQty" class="form-control" value="<%= binding.posOdrQty %>" required />
    </div>

    <div class="span-seven">
      <label>Repeat Order Freq</label>
      <input type="text" name="posOdrFreq" class="form-control" value="<%= binding.posOdrFreq || '' %>" required />
    </div>

    <div class="span-six">
      <label>CR</label>
      <input
        type="text"
        name="posCreditTerm"
        class="form-control"
        value="<%= binding.posCreditTerm || '' %>"
        required
      />
    </div>

    <div class="span-six">
      <label>Status</label>
      <select name="status" class="form-control select-tag" required>
        <option value="ACTIVE" <%= binding.status === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
        <option value="INACTIVE" <%= binding.status === "INACTIVE" ? "selected" : "" %>>INACTIVE</option>
      </select>
    </div>    

    <!-- ================= BUTTONS ================= -->

    <div class="span-full btn-grp" style="flex-direction: row-reverse">
      <button class="submit-btn" type="submit">Update POS Roll Binding</button>
      <button type="button" id="cancelBtn">Cancel</button>
    </div>
  </form>
</div>

<script>
  document.getElementById("cancelBtn").addEventListener("click", () => {
    window.history.back();
  });

  (function () {
    const widthVal = Number(document.getElementById("pos-width").value) || 0;
    const mtrsVal = Number(document.getElementById("pos-mtrs").value) || 0;
    const rateInput = document.getElementById("pos-rate-per-roll");
    const costInput = document.getElementById("pos-sale-cost");
    const commissionInput = document.getElementById("pos-commission");
    const commissionResolvedInput = document.getElementById("pos-commission-resolved");
    const commissionModeInput = document.getElementById("pos-commission-mode");
    const ourAmtInput = document.getElementById("pos-our-amt");
    const commissionHint = document.getElementById("commission-hint");

    let commissionMode = commissionModeInput?.value === "PERCENT" ? "PERCENT" : "VALUE";

    function resolveCommission() {
      const rate = Number(rateInput?.value) || 0;
      const raw = Number(commissionInput?.value) || 0;
      let ourAmt = rate;
      let resolved;
      if (commissionMode === "PERCENT") {
        ourAmt = raw ? rate / (1 + raw / 100) : rate;
        resolved = rate - ourAmt;
      } else {
        resolved = raw;
        ourAmt = Math.max(0, rate - raw);
      }
      const resolvedRounded = Math.round(resolved * 100) / 100;
      if (commissionResolvedInput) commissionResolvedInput.value = raw ? String(resolvedRounded) : "";
      if (ourAmtInput) ourAmtInput.value = rate ? (Math.round(ourAmt * 100) / 100).toFixed(2) : "";
      if (commissionHint) {
        if (commissionMode === "PERCENT" && raw) {
          commissionHint.style.display = "block";
          commissionHint.textContent = `= ₹${resolvedRounded.toLocaleString("en-IN")} per roll`;
        } else {
          commissionHint.style.display = "none";
          commissionHint.textContent = "";
        }
      }
      return ourAmt;
    }

    function setCommissionMode(mode) {
      commissionMode = mode === "PERCENT" ? "PERCENT" : "VALUE";
      if (commissionModeInput) commissionModeInput.value = commissionMode;
      document.querySelectorAll(".comm-mode-btn").forEach((b) =>
        b.classList.toggle("active", b.dataset.mode === commissionMode));
      calcSaleCost();
    }
    document.querySelectorAll(".comm-mode-btn").forEach((b) =>
      b.addEventListener("click", () => setCommissionMode(b.dataset.mode)));

    function calcSaleCost() {
      const area = (widthVal * mtrsVal) / 1000;
      const netRate = resolveCommission();
      if (!area || !netRate) { costInput.value = ""; return; }
      costInput.value = (netRate / area).toFixed(4);
    }

    if (rateInput) rateInput.addEventListener("input", calcSaleCost);
    if (commissionInput) commissionInput.addEventListener("input", calcSaleCost);
    calcSaleCost();
  })();
</script>
