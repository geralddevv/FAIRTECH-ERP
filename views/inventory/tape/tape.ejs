<% layout('/layout/boilerplate') %>
<%
  // GET /form/tape-master: the same Tape Master card the "+ Tape" dialog on
  // /fairtech/tape/view uses, as a page of its own -- for anyone who lands on
  // the URL directly. Markup: _tapeMasterForm.ejs.
%>
<div class="main-content">
  <%- include('./_tapeMasterForm', { tm: {
    previewId: typeof previewTapeProductId !== 'undefined' ? previewTapeProductId : '',
    standalone: true,
    cancelHref: '/fairtech/tape/view',
  } }) %>
</div>
