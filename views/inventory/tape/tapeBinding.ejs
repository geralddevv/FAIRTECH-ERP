<% layout('/layout/boilerplate') %>
<style>
  /* Tape ID badge beside the "Tape Specifications" heading -- shared look
     (.so-card__badge, formStyle.md) via salesOrderForm.css; only the
     resolved/error colour swap below is specific to this page. */
  #tape-id.tape-id-success {
    border-color: #059669;
    background-color: #f0fdf4;
    color: #065f46;
  }
  #tape-id.tape-id-error {
    border-color: var(--so-danger);
    background-color: #fff1f2;
    color: #9f1239;
  }

  /* Commission ₹ / % segmented control. Too narrow a row to host the full
     .so-switch component (its options are a 128px minimum each) -- this
     stays a small custom pair, sized to match the row's 40px fields. */
  .comm-mode-toggle {
    display: inline-flex;
    flex: none;
    height: var(--so-field-h);
    border: 1px solid var(--so-field-border);
    border-radius: var(--so-radius-sm);
    overflow: hidden;
  }
  .comm-mode-btn {
    border: none;
    background: var(--so-surface);
    color: var(--so-ink-soft);
    padding: 0 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }
  .comm-mode-btn + .comm-mode-btn {
    border-left: 1px solid var(--so-field-border);
  }
  .comm-mode-btn.active {
    background: var(--so-brand);
    color: #fff;
  }

  /* Widen only the open dropdown list for Client Name -- names here run
     long (e.g. "FLAIR WRITING EQUIPMENTS PVT LTD -FWEPL VALSAD") and get
     clipped at the select box's own width. The closed box stays as-is. */
  #client-name-div .choices__list--dropdown {
    width: max-content;
    min-width: 100%;
    max-width: 520px;
  }
</style>

<div class="main-content so-page">
  <form action="/fairtech/form/tape-binding" method="post" onsubmit="return validateTapeBeforeSubmit()" class="needs-validation so-form" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1>Client Tape</h1></div>
      </header>

      <!-- ================= USER INFO =================
           Row: 8 + 8 + 8 + 8 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">User Info</h2></div>
        </div>
        <div class="so-grid">
          <div id="client-name-div" class="span-eight">
            <label for="client-name"><span class="so-label-text">Client Name</span></label>
            <select name="clientName" id="client-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% for (let client of clients) { %>
              <option value="<%= client %>"><%= client %></option>
              <% } %>
            </select>
          </div>
          <div id="user-name-div" class="span-eight">
            <label for="client-user-name"><span class="so-label-text">User Name</span></label>
            <select id="client-user-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div id="user-name-contact-div" class="span-eight">
            <label for="user-contact"><span class="so-label-text">User Contact</span></label>
            <input type="text" id="user-contact" class="form-control" name="userContact" placeholder="Enter User Contact" required />
          </div>
          <div id="client-location-div" class="span-eight">
            <label for="client-location"><span class="so-label-text">Location</span></label>
            <select name="location" id="client-location" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Select location</option>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= TAPE SPECIFICATIONS =================
           Row: 5 + 5 + 4 + 4 + 5 + 5 + 4 = 32. -->
      <section class="so-card">
        <div class="so-card__head so-card__head--wrap">
          <span class="so-card__icon"><i class="fa-solid fa-ruler-combined"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Tape Specifications</h2></div>
          <!-- Tape ID lives beside the heading, not in the field grid below --
               it's the resolved identifier for whatever specs are picked,
               not one more spec to fill in, and keeping it out of .so-grid
               means the row below keeps its own clean 32-column math
               regardless of how this badge is sized. Shared look:
               .so-card__badge (formStyle.md). -->
          <div class="so-card__badge" title="Resolves once Paper Code, Paper Type, GSM, Width, MTRS, Core ID and Finish match one Tape">
            <span class="so-card__badge-label">Tape ID</span>
            <input type="text" id="tape-id" name="tapeProductId" class="so-card__badge-input" placeholder="Will appear here" readonly required />
          </div>
          <div class="so-card__aside">
            <button type="button" id="reset-specs-btn" class="so-toggle"><i class="fa-solid fa-rotate-left"></i> Reset</button>
          </div>
        </div>
        <div class="so-grid">
          <div class="span-five">
            <label for="tape-paper-code"><span class="so-label-text">Paper Code</span></label>
            <select name="tapePaperCode" id="tape-paper-code" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% paperCodes?.forEach(pc => { %>
                <option value="<%= pc %>"><%= pc %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tape-paper-type"><span class="so-label-text">Paper Type</span></label>
            <select name="tapePaperType" id="tape-paper-type" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% paperTypes?.forEach(pt => { %>
                <option value="<%= pt %>"><%= pt %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tape-gsm"><span class="so-label-text">GSM</span></label>
            <select name="tapeGsm" id="tape-gsm" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% gsms?.forEach(g => { %>
                <option value="<%= g %>"><%= g %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tape-width"><span class="so-label-text">Width</span></label>
            <select name="tapeWidth" id="tape-width" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% widths?.forEach(w => { %>
                <option value="<%= w %>"><%= w %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tape-mtrs"><span class="so-label-text">MTRS</span></label>
            <select name="tapeMtrs" id="tape-mtrs" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% mtrsList?.forEach(m => { %>
                <option value="<%= m %>"><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tape-core-id"><span class="so-label-text">Core ID</span></label>
            <select name="tapeCoreId" id="tape-core-id" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% coreIds?.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tape-finish"><span class="so-label-text">Finish</span></label>
            <select name="tapeFinish" id="tape-finish" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% finishes?.forEach(f => { %>
                <option value="<%= f %>"><%= f %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= CLIENT OVERRIDES =================
           8 fields x span-eight = 4 per row, 2 rows, 32 each. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-sliders"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Client Overrides</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="tape-client-paper-code"><span class="so-label-text">Client Paper Code</span></label>
            <input type="text" id="tape-client-paper-code" class="form-control" name="tapeClientPaperCode" placeholder="Enter Client Paper Code" required />
          </div>
          <div class="span-eight">
            <label for="tape-client-gsm"><span class="so-label-text">Client GSM</span></label>
            <input type="text" id="tape-client-gsm" class="form-control" name="clientTapeGsm" placeholder="Enter Client GSM" required />
          </div>
          <div class="span-eight">
            <label for="item-client-item-type"><span class="so-label-text">Client Item Type</span></label>
            <input type="text" id="item-client-item-type" class="form-control" name="itemClientItemType" placeholder="Enter Client Item Type" required />
          </div>
          <div class="span-eight">
            <label for="tape-mtrs-del"><span class="so-label-text">MTRS Delivered</span></label>
            <input type="text" id="tape-mtrs-del" class="form-control" name="tapeMtrsDel" placeholder="Enter MTRS Delivered" required />
          </div>
          <div class="span-eight">
            <label for="tape-rate-per-roll"><span class="so-label-text">Rate Per Roll</span></label>
            <input type="text" id="tape-rate-per-roll" class="form-control" name="tapeRatePerRoll" placeholder="Enter rate per roll" required />
          </div>
          <div class="span-eight">
            <label for="tape-commission"><span class="so-label-text">Commission Per Roll</span></label>
            <div style="display: flex; gap: 6px; align-items: stretch; width: 100%;">
              <input type="text" id="tape-commission" class="form-control" name="commissionValue" placeholder="Commission" style="flex: 1; min-width: 0;" />
              <div class="comm-mode-toggle" role="group" aria-label="Commission type">
                <button type="button" class="comm-mode-btn active" data-mode="VALUE" title="Flat amount per roll">₹</button>
                <button type="button" class="comm-mode-btn" data-mode="PERCENT" title="Percentage of Rate Per Roll">%</button>
              </div>
            </div>
            <span id="commission-hint" style="display: none; font-size: 11px; font-weight: 600; color: var(--so-faint);"></span>
            <input type="hidden" name="commissionMode" id="tape-commission-mode" value="VALUE" />
            <input type="hidden" name="commissionPerRoll" id="tape-commission-resolved" value="" />
          </div>
          <div class="span-eight">
            <label for="tape-our-amt"><span class="so-label-text">Our Amount Per Roll</span></label>
            <input type="text" id="tape-our-amt" class="form-control" placeholder="Auto-calculated" tabindex="-1" readonly />
          </div>
          <div class="span-eight">
            <label for="tape-sale-cost"><span class="so-label-text">Sales sq mtrs Cost</span></label>
            <input type="text" id="tape-sale-cost" class="form-control" name="tapeSaleCost" placeholder="Auto-calculated" tabindex="-1" required readonly />
          </div>
        </div>
      </section>

      <!-- ================= PRICING & ORDER TERMS =================
           Row: 7 + 6 + 7 + 6 + 6 = 32. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-cart-shopping"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Pricing &amp; Order Terms</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-seven">
            <label for="tape-min-qty"><span class="so-label-text">Minimum Order QTY</span></label>
            <input type="text" id="tape-min-qty" class="form-control" name="tapeMinQty" placeholder="Enter minimum qty" required />
          </div>
          <div class="span-six">
            <label for="tape-odr-qty"><span class="so-label-text">Order QTY</span></label>
            <input type="text" id="tape-odr-qty" class="form-control" name="tapeOdrQty" placeholder="Enter order qty" required />
          </div>
          <div class="span-seven">
            <label for="tape-odr-freq"><span class="so-label-text">Repeat Order Freq</span></label>
            <input type="text" id="tape-odr-freq" class="form-control" name="tapeOdrFreq" placeholder="Enter repeat order frequency" required />
          </div>
          <div class="span-six">
            <label for="tape-credit-term"><span class="so-label-text">CR</span></label>
            <input type="text" id="tape-credit-term" class="form-control" name="tapeCreditTerm" placeholder="Enter credit term" required />
          </div>
          <div class="span-six">
            <label for="tape-billing-type"><span class="so-label-text">Billing Type</span></label>
            <select id="tape-billing-type" class="form-control select-tag" name="billingType" required>
              <option value="" disabled selected hidden>Select</option>
              <option value="ROLLS">Rolls</option>
              <option value="RUNNING MTRS">Running Mtrs</option>
            </select>
          </div>
          <input type="hidden" name="tapeId" id="resolved-tape-id" />
          <input type="hidden" name="userId" id="user-id" />
        </div>
      </section>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="so-actions">
      <span class="so-actions__hint">
        <i class="fa-regular fa-circle-check"></i>
        <span class="so-actions__hint-text">Specs resolve automatically once Paper Code, Paper Type, GSM, Width, MTRS, Core ID and Finish match one Tape.</span>
      </span>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Save Tape</button>
    </div>
  </form>
</div>

<!-- ===== RATE CALCULATION ===== -->
<script>
(function () {
  // Full text on hover for anything this page cuts short with an ellipsis --
  // see formStyle.md's "Long text" section. Delegated from document, so it
  // also covers what Choices builds later (dropdown options).
  const TRUNCATING = [
    ".so-page .so-label-text",
    ".so-page .form-control",
    ".so-page #tape-id",
    ".so-page .choices__list--single .choices__item",
    ".so-page .choices__list--dropdown .choices__item",
    ".so-page .choices__list[aria-expanded] .choices__item",
    ".so-page .so-actions__hint-text",
  ].join(",");

  document.addEventListener("mouseover", (e) => {
    const el = e.target instanceof Element ? e.target.closest(TRUNCATING) : null;
    if (!el) return;
    const full = (el.matches("input, textarea") ? el.value : el.textContent).replace(/\s+/g, " ").trim();
    const isCut = el.scrollWidth > el.clientWidth + 1;
    if (isCut && full) {
      el.title = full;
      el.dataset.soTip = "1";
    } else if (el.dataset.soTip) {
      el.removeAttribute("title");
      delete el.dataset.soTip;
    }
  });
})();

document.addEventListener("DOMContentLoaded", () => {
  /* ================= ELEMENTS ================= */
  const submitBtn = document.querySelector("button[type='submit']");

  const clientSelect = document.getElementById("client-name");
  const userSelect = document.getElementById("client-user-name");

  const userIdInput = document.getElementById("user-id");
  const userContactInput = document.getElementById("user-contact");
  const locationSelect = document.getElementById("client-location");
  const tapeMtrsInput = document.getElementById("tape-mtrs");
  const tapeMtrsDelInput = document.getElementById("tape-mtrs-del");

  const tapeIdInput = document.getElementById("resolved-tape-id");
  const tapeIdDisplay = document.getElementById("tape-id");

  const tapeFields = [
    "tape-paper-code",
    "tape-paper-type",
    "tape-gsm",
    "tape-width",
    "tape-mtrs",
    "tape-core-id",
    "tape-finish",
  ];

  // Map from element ID to the API response key
  const fieldToApiKey = {
    "tape-paper-code": "paperCodes",
    "tape-paper-type": "paperTypes",
    "tape-gsm": "gsms",
    "tape-width": "widths",
    "tape-mtrs": "mtrsList",
    "tape-core-id": "coreIds",
    "tape-finish": "finishes",
  };

  // Map from element ID to the query param name
  const fieldToParam = {
    "tape-paper-code": "tapePaperCode",
    "tape-paper-type": "tapePaperType",
    "tape-gsm": "tapeGsm",
    "tape-width": "tapeWidth",
    "tape-mtrs": "tapeMtrs",
    "tape-core-id": "tapeCoreId",
    "tape-finish": "tapeFinish",
  };

  submitBtn.disabled = true;

  /* ================= CHOICES INIT ================= */
  const clientChoices = new Choices(clientSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
    // Default searchResultLimit (4) silently drops real matches when several
    // client names are near-identical -- widen it and tighten the fuzzy
    // threshold so every close match surfaces instead of being crowded out by
    // loose noise matches.
    searchResultLimit: 20,
    fuseOptions: { threshold: 0.3 },
  });

  const userChoices = new Choices(userSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  const locationChoices = new Choices(locationSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  // Full user docs for the selected client (kept for locationDetails lookup)
  let currentUsers = [];

  // Store Choices instances for spec fields
  const specChoices = {};
  tapeFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      specChoices[id] = new Choices(el, {
        searchEnabled: true,
        shouldSort: false,
        itemSelectText: "",
      });
    }
  });

  /* ================= HELPERS ================= */
  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function getUserLocationEntries(user) {
    const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
    const entries = details
      .map((entry) => {
        const userLocation = normalizeLocationName(entry?.userLocation || entry?.location || "");
        if (!userLocation) return null;
        return { value: userLocation, label: userLocation };
      })
      .filter(Boolean);

    if (entries.length > 0) {
      // De-duplicate locations while preserving order
      const seen = new Set();
      return entries.filter((e) => (seen.has(e.value) ? false : seen.add(e.value)));
    }

    const fallbackLocation = normalizeLocationName(user?.userLocation || "");
    if (!fallbackLocation) return [];
    return [{ value: fallbackLocation, label: fallbackLocation }];
  }

  function clearLocationChoices() {
    locationChoices.clearStore();
    locationChoices.setChoices(
      [{ value: "", label: "Select location", disabled: true, selected: true }],
      "value",
      "label",
      true
    );
  }

  function populateLocationChoices(user) {
    const entries = getUserLocationEntries(user);
    if (entries.length === 0) {
      clearLocationChoices();
      return;
    }
    const autoSelect = entries.length === 1;
    locationChoices.clearStore();
    locationChoices.setChoices(
      [
        { value: "", label: "Select location", disabled: true, selected: !autoSelect, placeholder: true },
        ...entries.map((e, i) => ({ value: e.value, label: e.label, selected: autoSelect && i === 0 })),
      ],
      "value",
      "label",
      true
    );
  }

  function resetUserFields() {
    userIdInput.value = "";
    userContactInput.value = "";
    clearLocationChoices();
  }

  function hardResetUserSelection() {
    userChoices.removeActiveItems();
    userChoices.clearChoices();
    resetUserFields();
  }

  function resetResolvedTape() {
    tapeIdInput.value = "";
    tapeIdDisplay.value = "";
    submitBtn.disabled = true;
    tapeIdDisplay.classList.remove("tape-id-success", "tape-id-error");
  }

  function syncDeliveredMeters() {
    if (!tapeMtrsInput || !tapeMtrsDelInput) return;
    const currentMtrs = tapeMtrsInput.value;
    tapeMtrsDelInput.value = currentMtrs || "";
  }

  /* ================= SMART FILTER ================= */
  let filterTimeout = null;

  async function filterSpecs(changedFieldId) {
    // Build query params from all currently selected values
    const params = new URLSearchParams();
    tapeFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.value) {
        params.set(fieldToParam[id], el.value);
      }
    });

    try {
      const res = await fetch(`/fairtech/form/tape-binding/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      // Update each dropdown with filtered options (except the one just changed)
      tapeFields.forEach(id => {
        if (id === changedFieldId) return; // skip the field that triggered the filter
        const choicesInstance = specChoices[id];
        if (!choicesInstance) return;

        const apiKey = fieldToApiKey[id];
        const filteredValues = data[apiKey] || [];
        const currentValue = document.getElementById(id)?.value || "";

        // Build new choices array
        const newChoices = filteredValues.map(v => ({
          value: String(v),
          label: String(v),
          selected: String(v) === currentValue,
        }));

        // Auto-select if exactly one option and nothing currently selected (and not resetting)
        if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        // Clear and repopulate
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some(c => c.selected) }, ...newChoices],
          "value",
          "label",
          true
        );
      });

      // If any fields were auto-selected, re-run filter to cascade
      if (autoSelected.length > 0) {
        await filterSpecs(autoSelected[0]);
        resolveTape();
      }
    } catch (err) {
      console.error("Filter specs error:", err);
    }
  }

  /* ================= CLIENT → USER ================= */
  clientSelect.addEventListener("change", async () => {
    const clientName = clientSelect.value;

    hardResetUserSelection();

    const res = await fetch(`/fairtech/form/tape-binding/client/${clientName}`);
    const clientData = await res.json();
    if (!clientData || !clientData.users) return;

    currentUsers = clientData.users;

    // ===== SINGLE USER =====
    if (clientData.users.length === 1) {
      const u = clientData.users[0];

      userChoices.setChoices(
        [{
          value: u._id,
          label: u.userName,
          selected: true,
          customProperties: {
            mobile: u.userContact || "",
            location: u.userLocation || ""
          }
        }],
        "value",
        "label",
        true
      );

      userIdInput.value = u._id;
      userContactInput.value = u.userContact || "";
      populateLocationChoices(u);
      return;
    }

    // ===== MULTIPLE USERS =====
    userChoices.setChoices(
      clientData.users.map(u => ({
        value: u._id,
        label: u.userName,
        customProperties: {
          mobile: u.userContact || "",
          location: u.userLocation || ""
        }
      })),
      "value",
      "label",
      true
    );

    resetUserFields();
  });

  /* ================= USER CHANGE ================= */
  userSelect.addEventListener("change", () => {
    const selectedId = userChoices.getValue(true);
    if (!selectedId) return;

    const choice = userChoices._store.choices.find(
      c => c.value === selectedId
    );
    if (!choice) return;

    userIdInput.value = choice.value;
    userContactInput.value = choice.customProperties?.mobile || "";

    const selectedUser = currentUsers.find(u => String(u._id) === String(selectedId));
    populateLocationChoices(selectedUser || { userLocation: choice.customProperties?.location || "" });
  });

  /* ================= TAPE RESOLVE ================= */
  async function resolveTape() {
    resetResolvedTape();
    syncDeliveredMeters();

    const values = {};
    for (let id of tapeFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) return;
      values[id] = el.value;
    }

    const params = new URLSearchParams({
      tapePaperCode: values["tape-paper-code"],
      tapePaperType: values["tape-paper-type"],
      tapeGsm: values["tape-gsm"],
      tapeWidth: values["tape-width"],
      tapeMtrs: values["tape-mtrs"],
      tapeCoreId: values["tape-core-id"],
      tapeFinish: values["tape-finish"],
    });

    const res = await fetch(
      `/fairtech/form/tape-binding/resolve-tape?${params}`
    );

    if (!res.ok) {
      tapeIdDisplay.value = "No matching tape found";
      tapeIdDisplay.classList.add("tape-id-error");
      return;
    }

    const data = await res.json();

    tapeIdInput.value = data.tapeId;
    tapeIdDisplay.value = data.tapeProductId;
    tapeIdDisplay.classList.add("tape-id-success");
    submitBtn.disabled = false;

    document.getElementById("tape-client-paper-code").value =
      values["tape-paper-code"];
    document.getElementById("tape-client-gsm").value =
      values["tape-gsm"];
    document.getElementById("item-client-item-type").value =
      values["tape-paper-type"];
  }

  /* ================= SPEC CHANGE HANDLER ================= */
  tapeFields.forEach(id => {
    document.getElementById(id)?.addEventListener("change", async () => {
      await filterSpecs(id);
      resolveTape();
    });
  });

  /* ================= RESET SPECS ================= */
  const resetSpecsBtn = document.getElementById("reset-specs-btn");
  if (resetSpecsBtn) {
    resetSpecsBtn.addEventListener("click", async () => {
      // Clear underlying values for tape specs & reset their Choices UI
      tapeFields.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";

        // Also clear the Choices visible selection
        if (specChoices[id]) {
          specChoices[id].setChoiceByValue("");
        }
      });

      resetResolvedTape();

      // Clear the overrides if populated
      const clientPaperCode = document.getElementById("tape-client-paper-code");
      if (clientPaperCode) clientPaperCode.value = "";
      const clientGsm = document.getElementById("tape-client-gsm");
      if (clientGsm) clientGsm.value = "";

      // Clear all other text inputs
      const otherInputs = [
        "tape-mtrs-del",
        "tape-rate-per-roll",
        "tape-commission",
        "tape-our-amt",
        "tape-sale-cost",
        "tape-min-qty",
        "tape-odr-qty",
        "tape-odr-freq",
        "tape-credit-term",
        "tape-billing-type"
      ];
      otherInputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";
      });
      // Reset commission back to ₹ (VALUE) mode and clear its resolved/hint state
      setCommissionMode("VALUE");
      if (commissionResolvedInput) commissionResolvedInput.value = "";
      if (commissionHint) { commissionHint.style.display = "none"; commissionHint.textContent = ""; }

      // Reset Client and User dropdowns
      if (typeof clientChoices !== "undefined") {
        clientChoices.setChoiceByValue("");
      }
      hardResetUserSelection();

      // Fetch fresh, unfiltered options and apply them to all fields
      await filterSpecs("reset-all");
    });
  }

  /* ================= RATE CALC + COMMISSION ================= */
  const widthInput = document.getElementById("tape-width");
  const ratePerRollInput = document.getElementById("tape-rate-per-roll");
  const saleCostInput = document.getElementById("tape-sale-cost");
  const commissionInput = document.getElementById("tape-commission");
  const commissionResolvedInput = document.getElementById("tape-commission-resolved");
  const commissionModeInput = document.getElementById("tape-commission-mode");
  const ourAmtInput = document.getElementById("tape-our-amt");
  const commissionHint = document.getElementById("commission-hint");

  // Commission can be entered as a flat amount per roll (VALUE) or as a
  // percentage of the rate per roll (PERCENT). Either way we resolve it to a
  // flat per-roll amount in #tape-commission-resolved, and the sale cost is
  // computed from the rate net of commission (Our Amount Per Roll) -- mirrors
  // the label binding form.
  let commissionMode = "VALUE";
  function resolveCommission() {
    const rate = Number(ratePerRollInput?.value) || 0;
    const raw = Number(commissionInput?.value) || 0;
    let ourAmt = rate;
    let resolved;
    if (commissionMode === "PERCENT") {
      ourAmt = raw ? rate / (1 + raw / 100) : rate;
      resolved = rate - ourAmt;
    } else {
      resolved = raw;
      ourAmt = Math.max(0, rate - raw);
    }
    const resolvedRounded = Math.round(resolved * 100) / 100;
    commissionResolvedInput.value = raw ? String(resolvedRounded) : "";
    ourAmtInput.value = rate ? (Math.round(ourAmt * 100) / 100).toFixed(2) : "";
    if (commissionHint) {
      if (commissionMode === "PERCENT" && raw) {
        commissionHint.style.display = "block";
        commissionHint.textContent = `= ₹${resolvedRounded.toLocaleString("en-IN")} per roll`;
      } else {
        commissionHint.style.display = "none";
        commissionHint.textContent = "";
      }
    }
    return ourAmt;
  }

  function setCommissionMode(mode) {
    commissionMode = mode === "PERCENT" ? "PERCENT" : "VALUE";
    commissionModeInput.value = commissionMode;
    document.querySelectorAll(".comm-mode-btn").forEach((b) =>
      b.classList.toggle("active", b.dataset.mode === commissionMode));
    calcSaleCost();
  }
  document.querySelectorAll(".comm-mode-btn").forEach((b) =>
    b.addEventListener("click", () => setCommissionMode(b.dataset.mode)));

  function calcSaleCost() {
    const netRate = resolveCommission();
    const width = Number(widthInput?.value) || 0;
    const mtrs = Number(tapeMtrsInput?.value) || 0;
    if (!width || !mtrs || !netRate) { saleCostInput.value = ""; return; }
    const area = (width * mtrs) / 1000;
    if (!area) { saleCostInput.value = ""; return; }
    saleCostInput.value = (netRate / area).toFixed(4);
  }

  widthInput.addEventListener("input", calcSaleCost);
  tapeMtrsInput.addEventListener("input", () => {
    syncDeliveredMeters();
    calcSaleCost();
  });
  tapeMtrsInput.addEventListener("change", syncDeliveredMeters);
  tapeMtrsInput.addEventListener("addItem", syncDeliveredMeters);
  ratePerRollInput.addEventListener("input", calcSaleCost);
  commissionInput.addEventListener("input", calcSaleCost);

  /* ================= MOQ COMMA FORMATTING ================= */
  const tapeMinQtyInput = document.getElementById("tape-min-qty");
  if (tapeMinQtyInput) tapeMinQtyInput.addEventListener("input", () => applyQtyCommaFormatting(tapeMinQtyInput));
});

/* ================= MOQ COMMA FORMATTING ================= */
function formatQtyWithCommas(raw) {
  const digits = String(raw ?? "").replace(/[^\d]/g, "");
  return digits ? Number(digits).toLocaleString("en-US") : "";
}
function applyQtyCommaFormatting(el) {
  if (!el) return;
  const prev = el.value;
  const formatted = formatQtyWithCommas(prev);
  if (formatted === prev) return;
  const caret = el.selectionStart ?? prev.length;
  const digitsBeforeCaret = prev.slice(0, caret).replace(/[^\d]/g, "").length;
  el.value = formatted;
  if (document.activeElement === el) {
    let pos = 0, seen = 0;
    while (pos < formatted.length && seen < digitsBeforeCaret) {
      if (/\d/.test(formatted[pos])) seen++;
      pos++;
    }
    el.setSelectionRange(pos, pos);
  }
}

/* ================= CUSTOM TOAST ================= */
function showClientToast(message, isError = true) {
  // Check if existing toast exists, remove it
  const existingToast = document.getElementById("client-toast");
  if (existingToast) {
    existingToast.remove();
  }

  const toast = document.createElement("div");
  toast.id = "client-toast";
  toast.className = `toast-notification ${isError ? 'toast-error' : 'toast-success'}`;
  toast.innerHTML = `
    <span>${message}</span>
    <span class="toast-close" onclick="this.parentElement.remove()">×</span>
  `;

  document.body.appendChild(toast);

  // Auto remove
  setTimeout(() => {
    if (toast.parentElement) {
       toast.style.animation = "slideOut 0.5s forwards";
       setTimeout(() => toast.remove(), 500);
    }
  }, 5000);
}

/* ================= FORM GUARD ================= */
function validateTapeBeforeSubmit() {
  const tapeId = document.getElementById("resolved-tape-id").value;
  if (!tapeId) {
    showClientToast("Please select valid tape specifications.", true);
    return false;
  }

  // Strip the display commas so the stored value is a plain number.
  const minQtyEl = document.getElementById("tape-min-qty");
  const odrQtyEl = document.getElementById("tape-odr-qty");
  if (minQtyEl) minQtyEl.value = minQtyEl.value.replace(/,/g, "");
  if (odrQtyEl) odrQtyEl.value = odrQtyEl.value.replace(/,/g, "");

  const minQty = Number(minQtyEl.value);
  const odrQty = Number(odrQtyEl.value);

  if (minQty >= odrQty) {
    showClientToast("Order Quantity must be greater than Minimum Order Quantity", true);
    return false;
  }

  return true;
}
</script>
