<% layout('/layout/boilerplate') -%>
<style>
  #tape-id-display.tape-id-success {
    border-color: #059669;
    background-color: #f0fdf4;
    color: #065f46;
  }
  #tape-id-display.tape-id-error {
    border-color: var(--so-danger);
    background-color: #fff1f2;
    color: #9f1239;
  }

  /* Commission ₹ / % segmented control -- same as the create page. */
  .comm-mode-toggle {
    display: inline-flex;
    flex: none;
    height: var(--so-field-h);
    border: 1px solid var(--so-field-border);
    border-radius: var(--so-radius-sm);
    overflow: hidden;
  }
  .comm-mode-btn {
    border: none;
    background: var(--so-surface);
    color: var(--so-ink-soft);
    padding: 0 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }
  .comm-mode-btn + .comm-mode-btn { border-left: 1px solid var(--so-field-border); }
  .comm-mode-btn.active { background: var(--so-brand); color: #fff; }
</style>

<div class="main-content so-page">
  <form class="needs-validation so-form" action="/fairtech/tape-binding/edit/<%= binding._id %>" method="post" onsubmit="return validateBeforeSubmit()" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>" />
    <input type="hidden" name="tapeId" id="resolved-tape-id" value="<%= binding.tapeId?._id || '' %>" />

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1>Edit Tape Binding</h1></div>
      </header>

      <!-- ================= USER INFO ================= -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">User Info</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label><span class="so-label-text">Client Name</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.clientName || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">User Name</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.userName || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label><span class="so-label-text">User Contact</span></label>
            <input type="text" class="form-control" value="<%= binding.userId?.userContact || '' %>" readonly />
          </div>
          <div class="span-eight">
            <label for="binding-location"><span class="so-label-text">Location</span></label>
            <select name="location" id="binding-location" class="form-control select-tag" required>
              <% (userLocations || []).forEach(loc => { %>
                <option value="<%= loc %>" <%= (binding.location || '') === loc ? 'selected' : '' %>><%= loc %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= TAPE SPECIFICATIONS ================= -->
      <section class="so-card">
        <div class="so-card__head so-card__head--wrap">
          <span class="so-card__icon"><i class="fa-solid fa-ruler-combined"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Tape Specifications</h2></div>
          <div class="so-card__badge" title="Resolves once Paper Code, Paper Type, GSM, Width, MTRS, Core ID and Finish match one Tape">
            <span class="so-card__badge-label">Tape ID</span>
            <input type="text" id="tape-id-display" class="so-card__badge-input" value="<%= binding.tapeId?.tapeProductId || 'N/A' %>" placeholder="Will appear here" readonly />
          </div>
          <div class="so-card__aside">
            <button type="button" id="reset-specs-btn" class="so-toggle"><i class="fa-solid fa-rotate-left"></i> Reset</button>
          </div>
        </div>
        <div class="so-grid">
          <div class="span-five">
            <label for="tape-paper-code"><span class="so-label-text">Paper Code</span></label>
            <select name="tapePaperCode" id="tape-paper-code" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% paperCodes?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tape-paper-type"><span class="so-label-text">Paper Type</span></label>
            <select name="tapePaperType" id="tape-paper-type" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% paperTypes?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tape-gsm"><span class="so-label-text">GSM</span></label>
            <select name="tapeGsm" id="tape-gsm" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% gsms?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tape-width"><span class="so-label-text">Width</span></label>
            <select name="tapeWidth" id="tape-width" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% widths?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tape-mtrs"><span class="so-label-text">MTRS</span></label>
            <select name="tapeMtrs" id="tape-mtrs" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% mtrsList?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-five">
            <label for="tape-core-id"><span class="so-label-text">Core ID</span></label>
            <select name="tapeCoreId" id="tape-core-id" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% coreIds?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
          <div class="span-four">
            <label for="tape-finish"><span class="so-label-text">Finish</span></label>
            <select name="tapeFinish" id="tape-finish" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% finishes?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= CLIENT OVERRIDES ================= -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-sliders"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Client Overrides</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="tape-client-paper-code"><span class="so-label-text">Client Paper Code</span></label>
            <input type="text" id="tape-client-paper-code" name="tapeClientPaperCode" class="form-control" value="<%= binding.tapeClientPaperCode %>" required />
          </div>
          <div class="span-eight">
            <label for="tape-client-gsm"><span class="so-label-text">Client GSM</span></label>
            <input type="text" id="tape-client-gsm" name="clientTapeGsm" class="form-control" value="<%= binding.clientTapeGsm %>" required />
          </div>
          <div class="span-eight">
            <label for="item-client-item-type"><span class="so-label-text">Client Item Type</span></label>
            <input type="text" id="item-client-item-type" name="itemClientItemType" class="form-control" value="<%= binding.itemClientItemType || '' %>" />
          </div>
          <div class="span-eight">
            <label for="tape-mtrs-del"><span class="so-label-text">MTRS Delivered</span></label>
            <input type="text" id="tape-mtrs-del" name="tapeMtrsDel" class="form-control" value="<%= binding.tapeMtrsDel %>" required />
          </div>
          <div class="span-eight">
            <label for="tape-rate-per-roll"><span class="so-label-text">Rate Per Roll</span></label>
            <input type="text" id="tape-rate-per-roll" name="tapeRatePerRoll" class="form-control" value="<%= binding.tapeRatePerRoll %>" required />
          </div>
          <% const _commMode = binding.commissionMode === "PERCENT" ? "PERCENT" : "VALUE";
             const _commRaw = (binding.commissionValue !== undefined && binding.commissionValue !== null && String(binding.commissionValue) !== "" && Number(binding.commissionValue) !== 0)
               ? binding.commissionValue
               : (binding.commissionPerRoll || ''); %>
          <div class="span-eight">
            <label for="tape-commission"><span class="so-label-text">Commission Per Roll</span></label>
            <div style="display: flex; gap: 6px; align-items: stretch; width: 100%;">
              <input type="text" id="tape-commission" name="commissionValue" class="form-control"
                value="<%= _commRaw %>" placeholder="Commission" style="flex: 1; min-width: 0;" />
              <div class="comm-mode-toggle" role="group" aria-label="Commission type">
                <button type="button" class="comm-mode-btn <%= _commMode === 'VALUE' ? 'active' : '' %>" data-mode="VALUE" title="Flat amount per roll">₹</button>
                <button type="button" class="comm-mode-btn <%= _commMode === 'PERCENT' ? 'active' : '' %>" data-mode="PERCENT" title="Percentage of Rate Per Roll">%</button>
              </div>
            </div>
            <span id="commission-hint" style="display: none; font-size: 11px; font-weight: 600; color: var(--so-faint);"></span>
            <input type="hidden" name="commissionMode" id="tape-commission-mode" value="<%= _commMode %>" />
            <input type="hidden" name="commissionPerRoll" id="tape-commission-resolved" value="<%= binding.commissionPerRoll || '' %>" />
          </div>
          <div class="span-eight">
            <label for="tape-our-amt"><span class="so-label-text">Our Amount Per Roll</span></label>
            <input type="text" id="tape-our-amt" class="form-control" placeholder="Auto-calculated" tabindex="-1" readonly />
          </div>
          <div class="span-eight">
            <label for="tape-sale-cost"><span class="so-label-text">Sales sq mtrs Cost</span></label>
            <input type="text" id="tape-sale-cost" name="tapeSaleCost" class="form-control" value="<%= binding.tapeSaleCost %>" placeholder="Auto-calculated" tabindex="-1" required readonly />
          </div>
        </div>
      </section>

      <!-- ================= PRICING & ORDER TERMS ================= -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-cart-shopping"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Pricing &amp; Order Terms</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-six">
            <label for="tape-min-qty"><span class="so-label-text">Minimum Order QTY</span></label>
            <input type="text" id="tape-min-qty" name="tapeMinQty" class="form-control" value="<%= binding.tapeMinQty %>" required />
          </div>
          <div class="span-five">
            <label for="tape-odr-qty"><span class="so-label-text">Order QTY</span></label>
            <input type="text" id="tape-odr-qty" name="tapeOdrQty" class="form-control" value="<%= binding.tapeOdrQty %>" required />
          </div>
          <div class="span-six">
            <label for="tape-odr-freq"><span class="so-label-text">Repeat Order Freq</span></label>
            <input type="text" id="tape-odr-freq" name="tapeOdrFreq" class="form-control" value="<%= binding.tapeOdrFreq || '' %>" required />
          </div>
          <div class="span-five">
            <label for="tape-credit-term"><span class="so-label-text">CR</span></label>
            <input type="text" id="tape-credit-term" name="tapeCreditTerm" class="form-control" value="<%= binding.tapeCreditTerm || '' %>" required />
          </div>
          <div class="span-five">
            <label for="tape-billing-type"><span class="so-label-text">Billing Type</span></label>
            <select name="billingType" id="tape-billing-type" class="form-control select-tag" required>
              <option value="ROLLS" <%= binding.billingType === "ROLLS" ? "selected" : "" %>>Rolls</option>
              <option value="RUNNING MTRS" <%= binding.billingType === "RUNNING MTRS" ? "selected" : "" %>>Running Mtrs</option>
            </select>
          </div>
          <div class="span-five">
            <label for="binding-status"><span class="so-label-text">Status</span></label>
            <select name="status" id="binding-status" class="form-control select-tag" required>
              <option value="ACTIVE" <%= binding.status === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
              <option value="INACTIVE" <%= binding.status === "INACTIVE" ? "selected" : "" %>>INACTIVE</option>
            </select>
          </div>
        </div>
      </section>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="so-actions">
      <button type="button" id="cancelBtn" class="so-btn so-btn--ghost">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update Tape Binding</button>
    </div>
  </form>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const CURRENT = {
    tapePaperCode: "<%= binding.tapeId?.tapePaperCode || '' %>",
    tapePaperType: "<%= binding.tapeId?.tapePaperType || '' %>",
    tapeGsm:       "<%= binding.tapeId?.tapeGsm || '' %>",
    tapeWidth:     "<%= binding.tapeId?.tapeWidth || '' %>",
    tapeMtrs:      "<%= binding.tapeId?.tapeMtrs || '' %>",
    tapeCoreId:    "<%= binding.tapeId?.tapeCoreId || '' %>",
    tapeFinish:    "<%= binding.tapeId?.tapeFinish || '' %>",
  };

  const tapeFields = [
    "tape-paper-code",
    "tape-paper-type",
    "tape-gsm",
    "tape-width",
    "tape-mtrs",
    "tape-core-id",
    "tape-finish",
  ];

  const fieldToApiKey = {
    "tape-paper-code": "paperCodes",
    "tape-paper-type": "paperTypes",
    "tape-gsm":        "gsms",
    "tape-width":      "widths",
    "tape-mtrs":       "mtrsList",
    "tape-core-id":    "coreIds",
    "tape-finish":     "finishes",
  };

  const fieldToParam = {
    "tape-paper-code": "tapePaperCode",
    "tape-paper-type": "tapePaperType",
    "tape-gsm":        "tapeGsm",
    "tape-width":      "tapeWidth",
    "tape-mtrs":       "tapeMtrs",
    "tape-core-id":    "tapeCoreId",
    "tape-finish":     "tapeFinish",
  };

  const tapeIdInput   = document.getElementById("resolved-tape-id");
  const tapeIdDisplay = document.getElementById("tape-id-display");
  const rateInput     = document.getElementById("tape-rate-per-roll");
  const saleCostInput = document.getElementById("tape-sale-cost");
  const commissionInput = document.getElementById("tape-commission");
  const commissionResolvedInput = document.getElementById("tape-commission-resolved");
  const commissionModeInput = document.getElementById("tape-commission-mode");
  const ourAmtInput = document.getElementById("tape-our-amt");
  const commissionHint = document.getElementById("commission-hint");

  /* ── Choices init ── */
  const specChoices = {};
  tapeFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) specChoices[id] = new Choices(el, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
  });

  const locationEl = document.getElementById("binding-location");
  if (locationEl) new Choices(locationEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

  /* ── Commission ₹ / % (resolves to a flat per-roll amount; sale cost is
        computed net of commission -- mirrors the label binding form) ── */
  let commissionMode = commissionModeInput?.value === "PERCENT" ? "PERCENT" : "VALUE";
  function resolveCommission() {
    const rate = Number(rateInput?.value) || 0;
    const raw = Number(commissionInput?.value) || 0;
    let ourAmt = rate;
    let resolved;
    if (commissionMode === "PERCENT") {
      ourAmt = raw ? rate / (1 + raw / 100) : rate;
      resolved = rate - ourAmt;
    } else {
      resolved = raw;
      ourAmt = Math.max(0, rate - raw);
    }
    const resolvedRounded = Math.round(resolved * 100) / 100;
    if (commissionResolvedInput) commissionResolvedInput.value = raw ? String(resolvedRounded) : "";
    if (ourAmtInput) ourAmtInput.value = rate ? (Math.round(ourAmt * 100) / 100).toFixed(2) : "";
    if (commissionHint) {
      if (commissionMode === "PERCENT" && raw) {
        commissionHint.style.display = "block";
        commissionHint.textContent = `= ₹${resolvedRounded.toLocaleString("en-IN")} per roll`;
      } else {
        commissionHint.style.display = "none";
        commissionHint.textContent = "";
      }
    }
    return ourAmt;
  }

  function setCommissionMode(mode) {
    commissionMode = mode === "PERCENT" ? "PERCENT" : "VALUE";
    if (commissionModeInput) commissionModeInput.value = commissionMode;
    document.querySelectorAll(".comm-mode-btn").forEach((b) =>
      b.classList.toggle("active", b.dataset.mode === commissionMode));
    calcSaleCost();
  }
  document.querySelectorAll(".comm-mode-btn").forEach((b) =>
    b.addEventListener("click", () => setCommissionMode(b.dataset.mode)));

  /* ── Rate calc (net of commission) ── */
  function calcSaleCost() {
    const netRate = resolveCommission();
    const width = Number(document.getElementById("tape-width")?.value) || 0;
    const mtrs  = Number(document.getElementById("tape-mtrs")?.value)  || 0;
    if (!width || !mtrs || !netRate) { saleCostInput.value = ""; return; }
    saleCostInput.value = (netRate / ((width * mtrs) / 1000)).toFixed(4);
  }

  rateInput?.addEventListener("input", calcSaleCost);
  commissionInput?.addEventListener("input", calcSaleCost);

  /* ── Smart filter ── */
  async function filterSpecs(changedFieldId) {
    const params = new URLSearchParams();
    tapeFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.value) params.set(fieldToParam[id], el.value);
    });

    try {
      const res  = await fetch(`/fairtech/form/tape-binding/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];
      tapeFields.forEach(id => {
        if (id === changedFieldId) return;
        const inst = specChoices[id];
        if (!inst) return;
        const filteredValues = data[fieldToApiKey[id]] || [];
        const currentValue   = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map(v => ({
          value: String(v), label: String(v), selected: String(v) === currentValue,
        }));

        if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        inst.clearStore();
        inst.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some(c => c.selected) }, ...newChoices],
          "value", "label", true
        );

        if (currentValue && filteredValues.map(String).includes(currentValue)) {
          inst.setChoiceByValue(currentValue);
        } else if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          inst.setChoiceByValue(String(filteredValues[0]));
        }
      });

      if (autoSelected.length) await filterSpecs(autoSelected[0]);
    } catch (err) {
      console.error("Filter specs error:", err);
    }
  }

  /* ── Resolve tape ── */
  async function resolveTape() {
    const values = {};
    for (const id of tapeFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) {
        tapeIdInput.value = "";
        tapeIdDisplay.value = "— select all specs —";
        tapeIdDisplay.classList.remove("tape-id-success", "tape-id-error");
        return;
      }
      values[id] = el.value;
    }

    const params = new URLSearchParams({
      tapePaperCode: values["tape-paper-code"],
      tapePaperType: values["tape-paper-type"],
      tapeGsm:       values["tape-gsm"],
      tapeWidth:     values["tape-width"],
      tapeMtrs:      values["tape-mtrs"],
      tapeCoreId:    values["tape-core-id"],
      tapeFinish:    values["tape-finish"],
    });

    try {
      const res = await fetch(`/fairtech/form/tape-binding/resolve-tape?${params}`);
      if (!res.ok) {
        tapeIdInput.value  = "";
        tapeIdDisplay.value = "No matching tape found";
        tapeIdDisplay.classList.remove("tape-id-success"); tapeIdDisplay.classList.add("tape-id-error");
        return;
      }
      const data = await res.json();
      tapeIdInput.value  = data.tapeId;
      tapeIdDisplay.value = data.tapeProductId;
      tapeIdDisplay.classList.remove("tape-id-error"); tapeIdDisplay.classList.add("tape-id-success");
      calcSaleCost();
    } catch (err) {
      console.error("Resolve tape error:", err);
    }
  }

  /* ── Spec change handler ── */
  tapeFields.forEach(id => {
    document.getElementById(id)?.addEventListener("change", async () => {
      await filterSpecs(id);
      await resolveTape();
    });
  });

  /* ── Reset ── */
  document.getElementById("reset-specs-btn").addEventListener("click", async () => {
    tapeFields.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = "";
      specChoices[id]?.setChoiceByValue("");
    });
    tapeIdInput.value  = "";
    tapeIdDisplay.value = "";
    tapeIdDisplay.classList.remove("tape-id-success", "tape-id-error");
    await filterSpecs("reset-all");
  });

  /* ── Cancel ── */
  document.getElementById("cancelBtn").addEventListener("click", () => window.history.back());

  /* ── Init: prefill dropdowns with current binding specs ── */
  (async () => {
    // First pass — populate all lists unfiltered
    await filterSpecs("init-none");

    // Set each field to the current binding value
    for (const [id, paramKey] of Object.entries(fieldToParam)) {
      const val = CURRENT[paramKey];
      if (val && specChoices[id]) specChoices[id].setChoiceByValue(String(val));
    }

    // Cascade-filter with all values set
    await filterSpecs("init-none");

    // Re-apply values in case cascade cleared any
    for (const [id, paramKey] of Object.entries(fieldToParam)) {
      const val = CURRENT[paramKey];
      if (val && specChoices[id]) specChoices[id].setChoiceByValue(String(val));
    }

    await resolveTape();
  })();
});

function validateBeforeSubmit() {
  const tapeId = document.getElementById("resolved-tape-id").value;
  if (!tapeId) {
    showToast("Please select valid tape specifications.", "error");
    return false;
  }
  const minQty = Number(document.getElementById("tape-min-qty")?.value);
  const odrQty = Number(document.getElementById("tape-odr-qty")?.value);
  if (minQty >= odrQty) {
    showToast("Order Quantity must be greater than Minimum Order Quantity", "error");
    return false;
  }
  return true;
}
</script>
