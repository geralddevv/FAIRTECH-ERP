<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  .legend-banner {
    background: #f8f9fa;
    border: 1px solid #e6eaf2;
    border-radius: 8px;
    padding: 10px 14px;
  }
  .legend-banner-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 13px;
    color: #044a78;
    cursor: pointer;
  }
  .paper-reorder-legend {
    display: none;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 10px;
    font-size: 12px;
    color: #4b5563;
  }
  .paper-reorder-legend.open { display: flex; }
  .paper-reorder-legend b { color: #1f2a44; }

  .unbound-banner {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 8px;
    padding: 12px 16px;
  }
  .unbound-banner-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: #92400e;
    cursor: pointer;
  }
  .unbound-list {
    margin-top: 10px;
    display: none;
    flex-direction: column;
    gap: 6px;
  }
  .unbound-list.open { display: flex; }
  .unbound-row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
  }
  .unbound-row span.client { font-weight: 700; color: #1f2a44; flex: 1; }
  .unbound-row a.bind-link {
    background: #044a78;
    color: #fff;
    text-decoration: none;
    padding: 4px 12px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Tabulator's dataTree expand/collapse toggle -- sits alone in its own
     blank column (see dataTreeElementColumn below). One chevron glyph rotated
     90° between states (rather than swapping to a second right/down glyph)
     matches the same rotate-on-open idiom already used for the Column
     Legend/unbound-orders chevrons above -- a plain, borderless icon with a
     soft hover tint reads as part of the table instead of a separate button
     bolted onto it. tabindex from Tabulator's own markup also left a focus
     ring on click -- outline is explicitly killed below. */
  .tabulator-data-tree-control {
    width: 20px !important;
    height: 20px !important;
    border: none !important;
    border-radius: 4px !important;
    background: rgba(4, 74, 120, 0.1) !important;
    box-shadow: none !important;
    outline: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: background-color 0.15s ease !important;
  }
  .tabulator-data-tree-control:hover {
    background: rgba(4, 74, 120, 0.18) !important;
  }
  .tabulator-data-tree-control:focus,
  .tabulator-data-tree-control:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  .tabulator-data-tree-control-expand,
  .tabulator-data-tree-control-collapse {
    width: auto !important;
    height: auto !important;
    background: none !important;
    border: none !important;
  }
  .tabulator-data-tree-control-expand::before,
  .tabulator-data-tree-control-collapse::before {
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    content: "\f054"; /* chevron-right, one glyph for both states */
    font-size: 11px;
    line-height: 1;
    color: #044a78;
    display: inline-block;
    transition: transform 0.2s ease;
  }
  /* "collapse" control is shown while the row IS expanded (clicking it
     collapses) -- so this is the open state, rotated to point down. */
  .tabulator-data-tree-control-collapse::before {
    transform: rotate(90deg);
  }
  /* Tabulator's own default plus/minus bar is drawn on this ::after -- still
     present underneath our glyph above unless killed explicitly. */
  .tabulator-data-tree-control-expand::after,
  .tabulator-data-tree-control-collapse::after {
    content: none !important;
    display: none !important;
  }

  /* Parent (paper-spec) rows deliberately get no override here -- they fall
     through to tableDisp.css's shared .tabulator-row:hover rule, the same
     hover every other table in the app uses. Only the order rows below get
     their own hover: the shared rule's grey wash, against their own shading
     + top border, read as a boxed highlight rather than a hover cue, so
     they need a look of their own instead of the shared one. */

  /* The shared rule force-resets border-width/style/color to "none" on
     every side (!important) on hover, which on the order rows wipes out
     (then, once the mouse leaves, restores) the top border set in
     rowFormatter below -- reasserting all four sides explicitly here keeps
     that border static regardless of hover state. Background is a
     deliberate, slightly darker shade of the row's own resting color (not
     the shared rule's grey) so hovering an order line still gives feedback,
     just without the boxed look the generic table-wide hover had. */
  #master-table .tabulator-row.order-detail-row {
    transition: background-color 0.15s ease;
  }
  #master-table .tabulator-row.order-detail-row--clickable {
    cursor: pointer;
  }
  #master-table .tabulator-row.order-detail-row:hover {
    background-color: #eef2f7 !important;
    border-top: 1px solid #e6eaf2 !important;
    border-right-style: none !important;
    border-bottom-style: none !important;
    border-left-style: none !important;
  }

  /* See rowFormatter in the script below -- order rows get this class
     instead of a one-time JS display toggle so cells/resize-handles added
     after rowFormatter runs (rows built later by Tabulator's virtual DOM)
     are still hidden. */
  #master-table .tabulator-row.order-detail-row > .tabulator-cell,
  #master-table .tabulator-row.order-detail-row > .tabulator-col-resize-handle {
    display: none !important;
  }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1>Paper Re-Order for Production</h1>
    <div class="download-btns" style="display: flex; gap: 14px; align-items: center">
      <span
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(255, 255, 255, 0.14);
          border: 1px solid rgba(255, 255, 255, 0.25);
          color: #fff;
          padding: 6px 14px;
          border-radius: 999px;
          font-size: 13px;
          font-weight: 700;
          white-space: nowrap;
        "
      >
        <i class="fa-solid fa-ruler-combined"></i>
        Total Sq Mtrs: <span id="total-sq-mtrs"><%= Number(totalSqMtrs || 0).toLocaleString("en-IN") %></span>
      </span>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span>
            <i class="fa-solid fa-file-arrow-down"></i>
            <span class="download-typo">Download</span>
          </span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-pdf">
            <i class="fas fa-file-pdf download-selector__option-icon"></i>
            <span>PDF</span>
          </span>
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i>
            <span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="legend-banner">
    <div class="legend-banner-head" onclick="document.getElementById('paper-reorder-legend').classList.toggle('open'); this.querySelector('i.fa-chevron-down')?.classList.toggle('fa-rotate-180')">
      <i class="fa-solid fa-circle-info"></i>
      <span>Column Legend</span>
      <i class="fa-solid fa-chevron-down" style="margin-left: auto; transition: transform 0.2s"></i>
    </div>
    <div id="paper-reorder-legend" class="paper-reorder-legend">
      <span><b>Available</b> — running metres currently in stock (reels with quantity &gt; 0)</span>
      <span><b>WIP Reserved</b> — metres already earmarked for orders assigned to a machine</span>
      <span><b>Required</b> — metres pending (unassigned) orders still need</span>
      <span><b>Balance</b> — Available − WIP Reserved − Required; red means short</span>
      <span><b>Sq Mtrs</b> — Required Rolls × Size</span>
    </div>
  </div>

  <% if (unbound && unbound.length) { %>
  <div class="unbound-banner">
    <div class="unbound-banner-head" onclick="document.getElementById('unbound-list').classList.toggle('open'); this.querySelector('i.fa-chevron-down')?.classList.toggle('fa-rotate-180')">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span><%= unbound.length %> pending order<%= unbound.length === 1 ? '' : 's' %> can't be sized yet — no Production Binding on file</span>
      <i class="fa-solid fa-chevron-down" style="margin-left: auto; transition: transform 0.2s"></i>
    </div>
    <div class="unbound-list" id="unbound-list">
      <% unbound.forEach(function(o) { %>
      <div class="unbound-row">
        <span class="client"><%= o.clientName %> — <%= o.productId %><%= o.poNumber ? ' (PO ' + o.poNumber + ')' : '' %></span>
        <span>Qty <%= o.balanceQty %></span>
        <a class="bind-link" href="/fairtech/form/prodcalc?fromPending=<%= encodeURIComponent(o.orderId) %>">
          <i class="fa-solid fa-link"></i> Bind Production
        </a>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

<script id="paper-reorder-data" type="application/json">
  <%- safeJson(groups || []) %>
</script>

<script>
  const rawGroups = JSON.parse(document.getElementById("paper-reorder-data").textContent);

  const fmt = (n) => (n === null || n === undefined ? "—" : Number(n).toLocaleString("en-IN"));

  const escapeHtml = (val) =>
    String(val ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");

  const fmtDate = (d) => {
    if (!d) return "";
    const dt = new Date(d);
    return isNaN(dt.getTime()) ? "" : dt.toLocaleDateString("en-GB");
  };

  // Flatten server groups into Tabulator's dataTree shape: one row per paper
  // spec, with the pending orders drawing on it as _children rows sharing the
  // same field names (blank/null where a figure doesn't apply at that level).
  // A paper spec with stock but no currently-pending order still gets a row
  // (see the route) with an empty orders list. Tabulator's dataTree module
  // still draws the expand toggle for an empty _children array (it only
  // checks Array.isArray, not length), so the toggle used to be there but
  // opened onto nothing -- which read as "the dropdown won't open". Giving
  // it a one-line placeholder child instead keeps the toggle doing something
  // visible on every row (not missing, not a dead click).
  const tableData = rawGroups.map((g) => {
    const hasOrders = g._children.length > 0;
    return {
      vendorName: g.vendorName,
      prodCode: g.prodCode,
      family: g.family,
      size: g.paperSize,
      availableRolls: g.availableRolls,
      availableMtrs: g.availableMtrs,
      wipAllottedMtrs: g.wipAllottedMtrs,
      effectiveMtrs: g.effectiveMtrs,
      requiredMtrs: g.requiredMtrs,
      requiredRolls: g.requiredRolls,
      sqMtrs: g.sqMtrs,
      balanceMtrs: g.balanceMtrs,
      shortage: g.shortage,
      orderCount: g._children.length,
      hasIncompleteRequirement: g.hasIncompleteRequirement,
      isParent: true,
      _children: hasOrders
        ? g._children.map((c) => ({
            orderId: c.orderId,
            clientName: c.clientName,
            poDate: c.poDate,
            poNumber: c.poNumber,
            dieNo: c.dieNo ? `Die ${c.dieNo}` : "",
            labelWidth: c.labelWidth,
            labelHeight: c.labelHeight,
            availableRolls: null,
            availableMtrs: null,
            wipAllottedMtrs: null,
            effectiveMtrs: null,
            requiredMtrs: c.requiredMtrs,
            requiredRolls: c.requiredRolls,
            balanceMtrs: null,
            balanceQty: c.balanceQty,
            isParent: false,
          }))
        : [{ isParent: false, noOrders: true }],
    };
  });

  document.addEventListener("DOMContentLoaded", () => {
    const table = new Tabulator("#master-table", {
      data: tableData,
      dataTree: true,
      dataTreeStartExpanded: false,
      dataTreeChildField: "_children",
      // Child (order) rows don't carry real vendorName/prodCode/family values
      // of their own -- with the default (true) each header filter tests
      // children individually and fails them on every field they don't have,
      // so as soon as any filter was active the children vanished from the
      // DOM entirely even under an expanded, matching parent. false scopes
      // filtering to parent rows only; a matching parent's children display
      // in full regardless of what column was filtered on.
      dataTreeFilter: false,
      // Give the expand/collapse toggle its own blank column -- like every
      // other table's Actions column.
      dataTreeElementColumn: "_toggle",
      placeholder: "No paper stock or pending orders found",
      // Order (child) rows carry their identity as free text that doesn't fit a
      // fixed column width without truncating or wrapping awkwardly. Rather than
      // giving it its own column, hide every per-column cell on those rows and
      // replace them with one spanning bar that starts right where Vendor Name
      // would sit, so the full line is always visible regardless of column widths.
      rowFormatter: (row) => {
        const data = row.getData();
        if (data.isParent) return;
        const el = row.getElement();
        if (el.querySelector(".order-detail-span")) return;
        el.style.backgroundColor = "#f8fafc";
        el.style.borderTop = "1px solid #e6eaf2";
        // Rows Tabulator's virtual DOM builds later (below the initial fold)
        // get their per-column resize-handle spans appended *after*
        // rowFormatter runs, so a one-time JS loop here misses them on those
        // rows. A CSS rule keyed off this class instead applies continuously
        // regardless of when Tabulator inserts them -- hides every cell
        // (including _toggle, which only ever holds the dataTree branch-guide
        // line on an order row, not a real expand control) and every resize
        // handle, both of which would otherwise leave a blank strip above
        // the bar appended below.
        el.classList.add("order-detail-row");
        // Tabulator's own rowClick fires from a listener bound on each
        // .tabulator-cell -- all of which are display:none on this row (see
        // the CSS rule above), so Tabulator never sees a click here at all.
        // Binding directly on the row element with a plain DOM listener
        // sidesteps that; the assign-link icon below still calls its own
        // stopPropagation() so its own (new-tab) navigation doesn't also
        // trigger this same-tab one.
        if (data.orderId) {
          el.classList.add("order-detail-row--clickable");
          el.addEventListener("click", () => {
            window.location.href = `/fairtech/labels/production/assign/${encodeURIComponent(data.orderId)}`;
          });
        }
        const bar = document.createElement("div");
        bar.className = "order-detail-span";
        bar.style.cssText =
          "flex:1; display:flex; align-items:center; flex-wrap:wrap; gap:8px; padding:6px 12px; color:#4b5563; font-size:13px;";
        if (data.noOrders) {
          bar.innerHTML = `<span style="color:#94a3b8; font-style:italic;">No pending orders for this paper spec -- stock only.</span>`;
        } else {
          const dim = (data.labelWidth && data.labelHeight)
            ? `${data.labelWidth} × ${data.labelHeight}`
            : "";
          const parts = [
            `↳ <b style="color:#1f2a44;">${escapeHtml(data.clientName || "—")}</b>`,
            data.poDate ? `PO Date: ${fmtDate(data.poDate)}` : "",
            data.poNumber ? `PO ${escapeHtml(data.poNumber)}` : "",
            data.dieNo ? escapeHtml(data.dieNo) : "",
            dim ? escapeHtml(dim) : "",
            `Qty ${fmt(data.balanceQty ?? 0)}`,
            data.requiredMtrs != null ? `Required ${fmt(data.requiredMtrs)} m` : "",
            data.requiredRolls != null ? `${fmt(data.requiredRolls)} roll${data.requiredRolls === 1 ? "" : "s"}` : "",
          ].filter(Boolean);
          const assignLink = data.orderId
            ? ` <a href="/fairtech/labels/production/assign/${encodeURIComponent(data.orderId)}" target="_blank" rel="noopener" title="Open in Assign Production" style="color:#044a78;" onclick="event.stopPropagation()"><i class="fa-solid fa-up-right-from-square"></i></a>`
            : "";
          bar.innerHTML =
            parts.map((p, i) => (i === 0 ? p : `<span>${p}</span>`)).join('<span style="color:#334155; font-size:16px; font-weight:700; line-height:1;">&middot;</span>') +
            assignLink;
        }
        el.appendChild(bar);
      },
      columns: [
        {
          title: "",
          field: "_toggle",
          width: 40,
          hozAlign: "center",
          headerSort: false,
        },
        {
          title: "Vendor Name",
          field: "vendorName",
          minWidth: 160,
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => {
            const row = cell.getRow().getData();
            if (!row.isParent) return "";
            const warn = row.hasIncompleteRequirement
              ? ` <i class="fa-solid fa-circle-info" title="Some orders on this paper couldn't be sized (die missing Across Ups)" style="color:#d97706"></i>`
              : "";
            return `<span style="font-weight:700; color:#1f2a44;">${cell.getValue() || ""}</span>${warn}`;
          },
        },
        {
          title: "Family",
          field: "family",
          minWidth: 120,
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => (cell.getRow().getData().isParent ? cell.getValue() || "" : ""),
        },
        {
          title: "Prod Code",
          field: "prodCode",
          minWidth: 110,
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => (cell.getRow().getData().isParent ? cell.getValue() || "" : ""),
        },
        {
          title: "Size",
          field: "size",
          minWidth: 110,
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
        },
        {
          title: "Available Rolls",
          field: "availableRolls",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => fmt(cell.getValue()),
        },
        {
          title: "Available Mtrs",
          field: "availableMtrs",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => fmt(cell.getValue()),
        },
        {
          title: "WIP Reserved Mtrs",
          field: "wipAllottedMtrs",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => fmt(cell.getValue()),
        },
        {
          title: "Effective Mtrs",
          field: "effectiveMtrs",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => fmt(cell.getValue()),
        },
        {
          title: "Required Mtrs",
          field: "requiredMtrs",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => `<span style="font-weight:600;">${fmt(cell.getValue())}</span>`,
        },
        {
          title: "Required Rolls",
          field: "requiredRolls",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => fmt(cell.getValue()),
        },
        {
          title: "Sq Mtrs",
          field: "sqMtrs",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => fmt(cell.getValue()),
        },
        {
          title: "Balance Mtrs",
          field: "balanceMtrs",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Filter...",
          formatter: (cell) => {
            const row = cell.getRow().getData();
            if (!row.isParent) return "—";
            const val = cell.getValue();
            const color = row.shortage ? "#dc2626" : "#16a34a";
            return `<span style="font-weight:800; color:${color};">${fmt(val)}</span>`;
          },
        },
      ],
    });

    window._paperReorderTable = table;

    // Total Sq Mtrs badge starts as the server-computed sum of every paper
    // spec (see totalSqMtrs in the route); once header filters narrow the
    // table down to a subset of paper-spec (parent) rows, the badge should
    // track just those rather than staying fixed at the unfiltered total.
    const totalSqMtrsEl = document.getElementById("total-sq-mtrs");
    const updateTotalSqMtrs = (rows) => {
      const total = rows.reduce((sum, r) => sum + (Number(r.getData().sqMtrs) || 0), 0);
      totalSqMtrsEl.textContent = total.toLocaleString("en-IN");
    };
    table.on("dataFiltered", (filters, rows) => updateTotalSqMtrs(rows));

    table.on("tableBuilt", () => {
      document.querySelector(".table-spinner")?.classList.add("hidden");
      updateTotalSqMtrs(table.getRows());
    });

    const selector = document.getElementById("downloadSelector");
    const trigger = selector.querySelector(".download-selector__trigger");
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      selector.classList.toggle("download-selector--active");
    });
    document.addEventListener("click", () => selector.classList.remove("download-selector--active"));

    document.getElementById("download-pdf").addEventListener("click", () => {
      table.download("pdf", "paper_reorder.pdf", { orientation: "landscape", title: "Paper Re-Order" });
      selector.classList.remove("download-selector--active");
    });
    document.getElementById("download-xlsx").addEventListener("click", () => {
      table.download("xlsx", "paper_reorder.xlsx", { sheetName: "Paper Reorder" });
      selector.classList.remove("download-selector--active");
    });
  });
</script>
