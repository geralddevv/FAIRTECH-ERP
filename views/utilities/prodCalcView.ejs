<!-- Link to boilerplate.ejs -->
<% layout('/layout/boilerplate') -%>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<body>
  <div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
    <style>
      .header-action-btn {
        background-color: #f0f0f0;
        color: #044a78;
        padding: 2px 14px;
        font-size: 14px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .header-action-btn:hover {
        background-color: #e4e4e4;
      }
      #prodcalc-table {
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
      }
      /* .row-margin-* colours live in layout/boilerplate.ejs -- shared with
         Pending Label Orders so both pages shade a margin identically. */
      /* Brand blue rather than an amber/warning colour on purpose: rows carry
         their own red/yellow/green margin band, and this pill has to stay
         legible on every one of them. */
      .outsource-pill {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 999px;
        background: #044a78;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
        white-space: nowrap;
      }
      /* Margin % can't recompute live (deleted/broken label link, or the
         binding's own paper data is incomplete) -- flagged distinctly from
         the red/yellow/green margin bands so a frozen number never reads as
         a trustworthy one. See withLiveLabelRate() in fairdesk_route.js. */
      .margin-stale-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 1px 8px;
        border-radius: 999px;
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #f59e0b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.2px;
        white-space: nowrap;
        cursor: help;
      }
      .row-margin-stale {
        background: repeating-linear-gradient(135deg, #fffbeb, #fffbeb 10px, #fef3c7 10px, #fef3c7 20px) !important;
      }
      /* Margin-band client-count badges -- same pill look as the status tabs
         on /fairtech/client/view (.order-highlight), coloured to match this
         page's own row-margin-* bands instead of that page's status colours. */
      .order-highlight {
        padding: 0.3rem 0.85rem;
        border-radius: 0.35rem;
        font-weight: 600;
        font-size: 1.15rem;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.5);
        margin-left: 8px;
        display: inline-block;
      }
      #band-badge-white {
        color: #044a78;
        border: 1px solid #044a78;
        background-color: #ffffff;
      }
      /* Clicking a badge filters the table to that Margin % band, same
         interaction as the status tabs on /fairtech/client/view. */
      .margin-band-tab {
        cursor: pointer;
        user-select: none;
        transition: outline 0.15s ease, filter 0.15s ease;
      }
      .margin-band-tab:hover { filter: brightness(1.12); }
      .margin-band-tab.selected { outline: 2px solid #044a78; outline-offset: 1px; filter: brightness(1.1); }
      /* Same separator bar as the header tabs on /fairtech/client/view --
         splits the plain heading text from the clickable badges. */
      .heading-separator {
        display: inline-block;
        width: 1px;
        height: 18px;
        margin-left: 8px;
        background-color: rgba(255, 255, 255, 0.4);
        vertical-align: middle;
      }
    </style>

    <div class="indi-head">
      <h1>
        Costing View
        <span class="heading-separator" aria-hidden="true"></span>
        <%
          // Each filter's own "clear" link drops only itself, keeping the
          // other one intact -- clearing the paper filter from the P./C.
          // Label Costing tabs shouldn't also drop back to the unfiltered,
          // both-models page.
          const modelQS = (typeof itemModel !== "undefined" && itemModel) ? `model=${itemModel}` : "";
          const withoutPaperHref = "/fairtech/prodcalc/view" + (modelQS ? `?${modelQS}` : "");
          // The badges count distinct clients on the combined (unfiltered)
          // view, where a row's "identity" is which client it belongs to --
          // but once narrowed to one item type via ?model=, each row IS one
          // binding of that item, so the badges switch to counting bindings
          // themselves. See the matching client-side branch in
          // renderMarginBandCounts() below -- keep this phrasing in step with it.
          const bandSubject = itemModel === "ColorLabel" ? "Color Label bindings" : itemModel === "Label" ? "Plain Label bindings" : "Clients with at least one binding";
        %>
        <% if (marginRestricted) { %>
          <%# "sales" role: the route sends only Critical-band rows, with every
              rate/margin field stripped -- so just a count, and no threshold
              in the wording either. %>
          <span id="band-badge-red" class="order-highlight" style="background-color: rgba(220, 53, 69, 0.45);">Critical Margin: <%= jsonData.length %></span>
        <% } else { %>
        <span style="font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.75);">Margin:</span>
        <span id="band-badge-all" class="order-highlight margin-band-tab selected" data-band="" title="Show every binding, clearing any Margin % filter">All: <span id="band-count-all">—</span></span>
        <span class="heading-separator" aria-hidden="true"></span>
        <span id="band-badge-white" class="order-highlight margin-band-tab" data-band="row-margin-white" title="<%= bandSubject %> in the Priority band (&gt; 1.5) -- click to filter">Priority: <span id="band-count-white">—</span></span>
        <span id="band-badge-green" class="order-highlight margin-band-tab" data-band="row-margin-green" style="background-color: rgba(40, 167, 69, 0.45);" title="<%= bandSubject %> in the Healthy Margin band (&gt; 1.4 - 1.5) -- click to filter">Healthy: <span id="band-count-green">—</span></span>
        <span id="band-badge-yellow" class="order-highlight margin-band-tab" data-band="row-margin-yellow" style="background-color: rgba(255, 193, 7, 0.45);" title="<%= bandSubject %> in the Low Margin band (&gt; 1.3 - 1.4) -- click to filter">Low: <span id="band-count-yellow">—</span></span>
        <span id="band-badge-red" class="order-highlight margin-band-tab" data-band="row-margin-red" style="background-color: rgba(220, 53, 69, 0.45);" title="<%= bandSubject %> in the Critical Margin band (&lt;= 1.3) -- click to filter">Critical: <span id="band-count-red">—</span></span>
        <% } %>
        <% if (typeof paperFilter !== "undefined" && paperFilter) { %>
          <span style="font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.75);">
            — filtered to <%= paperFilter.paperProductId || paperFilter.prodCode %>
            (<a href="<%= withoutPaperHref %>" style="color: #ffffff; text-decoration: underline;">clear</a>)
          </span>
        <% } %>
      </h1>

      <div style="display: flex; gap: 10px; align-items: center">
        <% if (!marginRestricted) { %>
        <button class="header-action-btn" onclick="window.location.href = '/fairtech/form/prodcalc'">
          <i class="fa-solid fa-plus" style="margin-right: 4px"></i> New Binding
        </button>
        <% } %>

        <div class="download-selector" id="downloadSelector">
          <button class="download-selector__trigger">
            <span>
              <i class="fa-solid fa-file-arrow-down"></i>
              <span class="download-typo">Download</span>
            </span>
            <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
          </button>
          <div class="download-selector__menu" id="downloads">
            <span class="download-selector__option" id="download-pdf">
              <i class="fas fa-file-pdf download-selector__option-icon"></i>
              <span>PDF</span>
            </span>
            <span class="download-selector__option" id="download-xlsx">
              <i class="fas fa-file-excel download-selector__option-icon"></i>
              <span>Excel</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="table-spinner"><div class="spinner-circle"></div></div>
    <div id="prodcalc-table" class="tabulator tabulator-modern"></div>
  </div>

  <!-- Tabulator JS -->
  <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

  <script>
    // ================= DOWNLOAD DROPDOWN UI =================

    const downloadSelector = document.getElementById("downloadSelector");
    const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");

    triggerBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      downloadSelector.classList.toggle("download-selector--active");
      const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
      icon.style.transform = downloadSelector.classList.contains("download-selector--active")
        ? "rotate(180deg)"
        : "rotate(0deg)";
    });

    document.addEventListener("click", () => {
      downloadSelector.classList.remove("download-selector--active");
      const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
      icon.style.transform = "rotate(0deg)";
    });

    downloadSelector.querySelector(".download-selector__menu").addEventListener("click", (e) => {
      e.stopPropagation();
    });

    // ================= TABULATOR DATA =================

    let tableData = [];
    try {
      tableData = <%- safeJson(jsonData || []) %>;
    } catch (err) {
      console.error("Prod Calc View JSON error", err);
    }

    // Drives renderMarginBandCounts()'s choice of what the header badges
    // count -- see the comment there, and the matching EJS-side `bandSubject`
    // used for the badges' tooltip text above. Plain JSON.stringify, not
    // safeJson -- safeJson coerces a falsy value (this null, on the
    // unfiltered page) to "{}", which is truthy and would make every page
    // look item-filtered. itemModel only ever comes from the route's own
    // `req.query.model === "ColorLabel" ? "ColorLabel" : ... ? "Label" : null`
    // ternary, never raw user input, so it needs no HTML-escaping here.
    const itemModel = <%- JSON.stringify(typeof itemModel !== "undefined" ? itemModel : null) %>;

    // "sales" role: every row here is already Critical-band and carries no
    // rate/margin fields at all (stripped server-side -- see
    // MARGIN_RESTRICTED_FIELDS in fairdesk_route.js). The margin columns,
    // band badges, averages and row actions are left out for them below.
    const MARGIN_RESTRICTED = <%- JSON.stringify(!!marginRestricted) %>;

    // Outsourced bindings carry no Margin % (see "Margin % source" in
    // CLAUDE.md) and so read as a blank/incomparable value wherever the table
    // is sorted by it -- sink them to the bottom on first load rather than
    // let that blank land wherever the default numeric sort happens to put
    // it. Non-outsourced rows keep the original ascending-by-Margin-%
    // ordering within their group. This runs once, before Tabulator's own
    // initialSort would otherwise re-sort the data and undo it -- see
    // initTable() below, which intentionally has no initialSort.
    tableData.sort((a, b) => {
      const aOut = a.isOutsource ? 1 : 0;
      const bOut = b.isOutsource ? 1 : 0;
      if (aOut !== bOut) return aOut - bOut;
      const aVal = parseFloat(a.prodActual);
      const bVal = parseFloat(b.prodActual);
      const aNum = Number.isFinite(aVal) ? aVal : Infinity;
      const bNum = Number.isFinite(bVal) ? bVal : Infinity;
      return aNum - bNum;
    });

    // Header badges: on the combined (unfiltered) Costing View, how many
    // distinct clients have at least one binding in each Margin % band --
    // but once the page is narrowed to one item type (?model=Label or
    // ?model=ColorLabel), every row already IS one binding of that item, so
    // "count of clients" stops being the useful number and the badges count
    // the bindings (labels / color labels) themselves instead. Keep the
    // `bandSubject` tooltip text above in step with this branch. Bands/colours
    // come from window.marginBandClass in layout/boilerplate.ejs -- the single
    // shared definition (see "Margin % colour bands" in CLAUDE.md) -- never
    // redefined here. In the distinct-client mode, a client with bindings in
    // more than one band is counted in every band it appears in, same as a
    // row can only ever carry one band but a client can carry several rows.
    // Stale/outsourced rows have no band (marginBandClass returns "" for a
    // blank Margin %) and so count toward none of the coloured bands either
    // way, though they still count toward "All".
    (function renderMarginBandCounts() {
      if (MARGIN_RESTRICTED) return; // no band badges rendered for this role
      const byItem = !!itemModel;
      const bandKeys = ["row-margin-red", "row-margin-yellow", "row-margin-green", "row-margin-white"];
      const totals = { "row-margin-red": 0, "row-margin-yellow": 0, "row-margin-green": 0, "row-margin-white": 0 };
      const clientsByBand = byItem ? null : {
        "row-margin-red": new Set(),
        "row-margin-yellow": new Set(),
        "row-margin-green": new Set(),
        "row-margin-white": new Set(),
      };
      const allClients = byItem ? null : new Set();
      let allCount = 0;

      tableData.forEach((r) => {
        allCount++;
        if (!byItem) allClients.add(r.companyName || "");
        if (r.marginStale) return;
        const cls = window.marginBandClass(r.prodActual);
        if (!bandKeys.includes(cls)) return;
        if (byItem) totals[cls]++;
        else clientsByBand[cls].add(r.companyName || "");
      });

      document.getElementById("band-count-all").textContent = byItem ? allCount : allClients.size;
      bandKeys.forEach((key) => {
        const el = document.getElementById(`band-count-${key.replace("row-margin-", "")}`);
        el.textContent = byItem ? totals[key] : clientsByBand[key].size;
      });
    })();

    const fmtDate = (v) => {
      if (!v) return "";
      const d = new Date(v);
      if (isNaN(d)) return "";
      const dd = String(d.getDate()).padStart(2, "0");
      const mm = String(d.getMonth() + 1).padStart(2, "0");
      const yyyy = d.getFullYear();
      return `${dd}/${mm}/${yyyy}`;
    };

    // Add Indian-style thousands separators while preserving the value's own
    // sign and decimal places, so large amounts are easy to read.
    const fmtNum = (v) => {
      if (v === undefined || v === null || v === "") return "";
      const n = Number(v);
      if (!Number.isFinite(n)) return String(v);
      const str = String(v);
      const dot = str.indexOf(".");
      const decimals = dot === -1 ? 0 : str.length - dot - 1;
      return n.toLocaleString("en-IN", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
    };

    // Same as fmtNum but always shows exactly 5 decimals — used for Prod Rate,
    // which must read to 5 places regardless of how the stored value was rounded.
    const fmtNum5 = (v) => {
      if (v === undefined || v === null || v === "") return "";
      const n = Number(v);
      if (!Number.isFinite(n)) return String(v);
      return n.toLocaleString("en-IN", { minimumFractionDigits: 5, maximumFractionDigits: 5 });
    };

    // Average Margin % per employee (the "User" column): the mean of every
    // binding's Margin % (prodActual) for that user, stamped onto each of their
    // rows so the Average column reads the same for all rows of one employee.
    // Rows with a non-numeric Margin % are left out of the mean. Computed once
    // over the whole page, so it doesn't shift when header filters are applied.
    function attachAverageMargins(rows) {
      const totals = {};
      rows.forEach((r) => {
        if (r.marginStale) return; // frozen/unresolved rows would skew a "live average"
        const user = r.userName || "";
        const pct = parseFloat(r.prodActual);
        if (!Number.isFinite(pct)) return;
        if (!totals[user]) totals[user] = { sum: 0, count: 0 };
        totals[user].sum += pct;
        totals[user].count += 1;
      });
      rows.forEach((r) => {
        const t = totals[r.userName || ""];
        r.avgMargin = t && t.count ? t.sum / t.count : "";
      });
    }

    // An outsourced binding has no paper vendor at all — the field is cleared
    // and disabled on the form (see prodCalc.ejs), because the job is bought in
    // as finished labels and its vendor is bound separately through Purchase ->
    // Outsourced Orders. So rather than leave the Vendor cell blank with no
    // explanation, the column reads "OUTSOURCE" there. Held in its own field
    // rather than done purely in the formatter so the header filter matches it
    // and the PDF/Excel downloads — which export raw field values, not rendered
    // cells — carry it too.
    function attachVendorDisplay(rows) {
      rows.forEach((r) => {
        r.vendorDisplay = r.isOutsource ? "OUTSOURCE" : (r.prodVendorName || "");
      });
    }

    // ================= TABULATOR INIT =================

    let table; // MUST be global for download to work

    const withTextFilter = (column, placeholder = "Search") => ({
      headerFilter: "input",
      headerFilterPlaceholder: placeholder,
      minWidth: 100,
      ...column,
    });

    // Margin band: prodActual (the Margin % field, e.g. "1.42") drives the row
    // colour. Thresholds and colours come from window.marginBandClass in
    // layout/boilerplate.ejs -- the single definition, shared with Pending
    // Label Orders. Don't reimplement them here.
    const marginRowClass = (row) => MARGIN_RESTRICTED ? "row-margin-red" : row.marginStale ? "row-margin-stale" : window.marginBandClass(row.prodActual);

    function initTable() {
      if (!MARGIN_RESTRICTED) attachAverageMargins(tableData);
      attachVendorDisplay(tableData);
      table = new Tabulator("#prodcalc-table", {
        data: tableData,
        height: "100%",
        virtualDom: true,
        responsiveLayout: false,
        movableColumns: true,
        placeholder: MARGIN_RESTRICTED ? "No critical margin bindings" : "No production bindings saved yet",
        rowFormatter: (row) => {
          const rowEl = row.getElement();
          rowEl.classList.remove(...window.MARGIN_BAND_CLASSES, "row-margin-stale");
          const cls = marginRowClass(row.getData());
          if (cls) rowEl.classList.add(cls);
        },
        columns: [
          srNoColumn(),
          // View/Edit/Delete -- none of them are open to the "sales" role (the
          // detail page shows every rate and margin), so no column at all.
          ...(MARGIN_RESTRICTED ? [] : [{
            title: "Actions",
            hozAlign: "center",
            headerSort: false,
            width: 130,
            formatter: (cell) => {
              const id = cell.getRow().getData()._id;
              return `
                <div style="display:flex; gap:6px; justify-content:center; align-items:center; white-space:nowrap;">
                  <button onclick="viewProdBinding('${id}')" title="View Details"
                    style="height:24px; padding:2px 9px; background:#111827; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:11px;"
                    onmouseover="this.style.background='#374151'" onmouseout="this.style.background='#111827'"><i class="fa-solid fa-eye"></i></button>
                  <button onclick="editProdBinding('${id}')" title="Edit"
                    style="height:24px; padding:2px 9px; background:#3b82f6; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:11px;"
                    onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'"><i class="fa-solid fa-pencil"></i></button>
                  <button onclick="deleteProdBinding('${id}')" title="Delete"
                    style="height:24px; padding:2px 9px; background:#ef4444; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:12px;"
                    onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'"><i class="fa-solid fa-trash"></i></button>
                </div>`;
            },
          }]),
          withTextFilter({
            title: "Date",
            field: "createdAt",
            formatter: (cell) => fmtDate(cell.getValue()),
            width: 110,
            headerSort: true,
          }),
          withTextFilter({ title: "Client", field: "companyName", widthGrow: 2, frozen: true }),
          withTextFilter({ title: "User", field: "userName", widthGrow: 2 }),
          withTextFilter({ title: "Location", field: "userLocation", widthGrow: 1 }),
          withTextFilter({ title: "Job Name", field: "jobName", widthGrow: 2 }),
          withTextFilter({
            title: "Width",
            field: "labelWidth",
            width: 100,
            hozAlign: "right",
            sorter: (a, b, aRow, bRow) => {
              const diff = (Number(a) || 0) - (Number(b) || 0);
              if (diff !== 0) return diff;
              return (Number(aRow.getData().labelHeight) || 0) - (Number(bRow.getData().labelHeight) || 0);
            },
          }),
          withTextFilter({
            title: "Height",
            field: "labelHeight",
            width: 100,
            hozAlign: "right",
            sorter: (a, b, aRow, bRow) => {
              const diff = (Number(a) || 0) - (Number(b) || 0);
              if (diff !== 0) return diff;
              return (Number(aRow.getData().labelWidth) || 0) - (Number(bRow.getData().labelWidth) || 0);
            },
          }),
          withTextFilter({ title: "Order Qty", field: "orderQuantity", width: 110, hozAlign: "right", formatter: (cell) => fmtNum(cell.getValue()) }),
          withTextFilter({ title: "Die No", field: "prodDieno", width: 100 }),
          withTextFilter({ title: "Machine No", field: "dieMachineNo", widthGrow: 1 }),
          withTextFilter({
            title: "Vendor",
            field: "vendorDisplay",
            widthGrow: 1,
            formatter: (cell) =>
              cell.getRow().getData().isOutsource
                ? `<span class="outsource-pill">OUTSOURCE</span>`
                : escHtml(cell.getValue() || ""),
          }),
          withTextFilter({ title: "Family", field: "prodPaperFamily", widthGrow: 1 }),
          ...(MARGIN_RESTRICTED ? [] : [
          withTextFilter({ title: "Prod Rate", field: "productionRate", width: 100, hozAlign: "right", formatter: (cell) => fmtNum5(cell.getValue()) }),
          withTextFilter({ title: "Margin", field: "prodMargin", width: 100, hozAlign: "right", formatter: (cell) => fmtNum(cell.getValue()) }),
          withTextFilter({
            title: "Margin %",
            field: "prodActual",
            width: 100,
            hozAlign: "right",
            sorter: "number",
            formatter: (cell) => {
              const d = cell.getRow().getData();
              // Frozen/unresolved -- the stored figure can no longer be trusted
              // (see withLiveLabelRate() in fairdesk_route.js), so warn instead
              // of printing a number that looks live but isn't.
              if (d.marginStale) {
                return `<span class="margin-stale-badge" title="${escHtml(d.marginStaleReason || "")}"><i class="fa-solid fa-triangle-exclamation"></i> Rebind</span>`;
              }
              const v = cell.getValue();
              return v !== undefined && v !== "" ? `${v}%` : "";
            },
          }),
          withTextFilter({
            title: "Average",
            field: "avgMargin",
            width: 100,
            hozAlign: "right",
            sorter: "number",
            formatter: (cell) => {
              const v = cell.getValue();
              return Number.isFinite(Number(v)) && v !== "" ? `${Number(v).toFixed(2)}%` : "";
            },
          }),
          ]),
        ],
      });

      /* ===== MARGIN-BAND BADGE FILTER =====
       * Same "radio button" interaction as the status tabs on
       * /fairtech/client/view: exactly one of All / Critical / Low / Healthy
       * / Optimal is ever "selected", and All is the one that clears the
       * filter back to everything (data-band="" on it). Bands/colours still
       * come from window.marginBandClass alone -- this only decides which
       * rows match, never redefines a threshold. */
      const bandTabs = Array.from(document.querySelectorAll(".margin-band-tab"));
      let activeBandFilter = null;

      function bandMatcher(band) {
        return (data) => !data.marginStale && window.marginBandClass(data.prodActual) === band;
      }

      function selectBandTab(tab) {
        bandTabs.forEach((t) => t.classList.toggle("selected", t === tab));
      }

      bandTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          if (activeBandFilter) {
            table.removeFilter(activeBandFilter);
            activeBandFilter = null;
          }

          const band = tab.dataset.band; // "" = All
          if (band) {
            activeBandFilter = bandMatcher(band);
            table.addFilter(activeBandFilter);
          }

          selectBandTab(tab);
        });
      });
    }

    window.addEventListener("load", initTable);

    // ================= ACTIONS: VIEW / EDIT / DELETE =================

    const escHtml = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
    const findRow = (id) => tableData.find((r) => String(r._id) === String(id));
    window.editProdBinding = function (id) {
      window.location.href = `/fairtech/form/prodcalc?editId=${encodeURIComponent(id)}`;
    };

    // Open the full detail page for this binding.
    window.viewProdBinding = function (id) {
      window.location.href = `/fairtech/prodcalc/details/${encodeURIComponent(id)}`;
    };

    let pendingDeleteId = null;
    window.deleteProdBinding = function (id) {
      pendingDeleteId = id;
      const d = findRow(id);
      const msg = document.getElementById("pc-confirm-msg");
      if (msg) msg.textContent = `Delete the production binding for "${d?.companyName || "this client"}"? This cannot be undone.`;
      document.getElementById("pc-confirm-dialog").style.display = "flex";
    };

    function closeProdConfirm() {
      pendingDeleteId = null;
      document.getElementById("pc-confirm-dialog").style.display = "none";
    }

    async function confirmDeleteYes() {
      if (!pendingDeleteId) return;
      const id = pendingDeleteId;
      const btn = document.getElementById("pc-confirm-yes");
      btn.disabled = true;
      try {
        const res = await fetch(`/fairtech/prodcalc/${encodeURIComponent(id)}`, { method: "DELETE" });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.success) {
          window.location.reload();
        } else {
          alert(out.message || "Failed to delete production binding.");
          btn.disabled = false;
        }
      } catch (err) {
        alert("Failed to delete production binding.");
        btn.disabled = false;
      }
    }

    window.addEventListener("load", () => {
      document.getElementById("pc-confirm-no").addEventListener("click", closeProdConfirm);
      document.getElementById("pc-confirm-yes").addEventListener("click", confirmDeleteYes);
      ["pc-confirm-dialog"].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.addEventListener("click", (e) => { if (e.target === el) el.style.display = "none"; });
      });
    });

    // ================= DOWNLOAD ACTIONS =================

    document.getElementById("download-pdf").addEventListener("click", () => {
      if (!table) return;
      table.download("pdf", "production-bindings.pdf", {
        orientation: "landscape",
        title: "Production Bindings",
      });
      downloadSelector.classList.remove("download-selector--active");
    });

    document.getElementById("download-xlsx").addEventListener("click", () => {
      if (!table) return;
      table.download("xlsx", "production-bindings.xlsx", {
        sheetName: "Production Bindings",
      });
      downloadSelector.classList.remove("download-selector--active");
    });
  </script>

  <!-- Delete confirmation dialog -->
  <div id="pc-confirm-dialog" class="pc-overlay">
    <div class="pc-confirm">
      <p id="pc-confirm-msg">Delete this production binding? This cannot be undone.</p>
      <div class="pc-confirm-actions">
        <button id="pc-confirm-no" class="pc-btn-secondary" type="button">Cancel</button>
        <button id="pc-confirm-yes" class="pc-btn-danger" type="button">Delete</button>
      </div>
    </div>
  </div>

  <style>
    .pc-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,0.5); z-index:10000; justify-content:center; align-items:center; padding:24px; }
    .pc-dialog { width:min(640px,100%); }
    .pc-card { background:#fff; border-radius:14px; overflow:hidden; box-shadow:0 18px 42px rgba(4,74,120,0.18); max-height:calc(100vh - 48px); display:flex; flex-direction:column; }
    .pc-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:20px 24px; background:linear-gradient(135deg,#044a78,#03365a); color:#fff; }
    .pc-head h1 { margin:0; font-size:20px; font-weight:700; }
    .pc-sub { margin-top:4px; font-size:13px; opacity:0.85; }
    .pc-x { background:rgba(255,255,255,0.15); border:none; color:#fff; width:32px; height:32px; border-radius:8px; cursor:pointer; font-size:14px; }
    .pc-body { padding:18px 24px 22px; overflow-y:auto; }
    .pc-h3 { margin:18px 0 8px; color:#044a78; font-size:14px; font-weight:700; }
    .pc-table { width:100%; border-collapse:collapse; font-size:13px; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden; }
    .pc-table th { background:#f4f7ff; color:#044a78; text-align:right; padding:8px 12px; font-weight:700; }
    .pc-table th:first-child { text-align:left; }
    .pc-table td { padding:7px 12px; border-top:1px solid #eef1f6; }
    .pc-table .pk { color:#5a6586; font-weight:600; width:38%; }
    .pc-table .pv { color:#1f2a44; font-weight:700; text-align:right; }
    .pc-table .pk + .pv { text-align:left; }
    .pc-confirm { background:#fff; border-radius:12px; width:min(420px,100%); padding:22px; box-shadow:0 18px 42px rgba(0,0,0,0.2); }
    .pc-confirm p { margin:0 0 18px; color:#333; font-size:15px; line-height:1.5; }
    .pc-confirm-actions { display:flex; justify-content:flex-end; gap:10px; }
    .pc-btn-secondary { padding:8px 16px; border:1px solid #d1d5db; background:#fff; color:#374151; border-radius:6px; cursor:pointer; font-weight:500; }
    .pc-btn-danger { padding:8px 16px; border:none; background:#ef4444; color:#fff; border-radius:6px; cursor:pointer; font-weight:600; }
    .pc-btn-danger:disabled { opacity:0.6; cursor:default; }
  </style>
</body>
