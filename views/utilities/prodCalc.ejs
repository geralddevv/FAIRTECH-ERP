<% layout('/layout/boilerplate') -%>

<style>
  /* Client type tag (DEALER / CLIENT) beside "Client Name", filled in once a
     client is picked. Class name "asterisk" kept -- the script selects it by
     that name regardless of how it's painted. */
  .client-type-badge {
    display: none;
    flex: none;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .client-type-badge.badge-dealer { display: inline-flex; color: var(--so-danger); background: #fff1f2; }
  .client-type-badge.badge-client { display: inline-flex; color: #059669; background: #f0fdf4; }

  /* Widen only the open dropdown list for Client Name -- names run long and
     get clipped at the select box's own width. The closed box stays as-is. */
  #client-name-div .choices__list--dropdown {
    width: max-content;
    min-width: 100%;
    max-width: 520px;
  }

  /* Label / die / block spec read-outs: the same table as Calculated Values
     below, one header row and one value row. Hidden until JS shows the card
     (style.display = "block"). A column that doesn't apply (a Plain label has
     no Job Name / colours) is hidden by the script on its <th> -- show() hides
     the <td> beneath it too. */
  .so-page .specs-card {
    grid-column: 1 / -1;
    display: none;
  }
  .so-page .specs-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--so-line-soft);
    border-radius: 12px;
  }
  .so-page .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .so-page .specs-table th,
  .so-page .specs-table td {
    padding: 10px 14px;
    text-align: right;
    border-right: 1px solid var(--so-line-soft);
    white-space: nowrap;
  }
  .so-page .specs-table th:last-child,
  .so-page .specs-table td:last-child { border-right: none; }
  .so-page .specs-table thead th {
    background: var(--so-brand);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .so-page .specs-table tbody td { color: var(--so-ink); font-weight: 650; }
  /* A column held to a fixed width (Die Make): a longer value ends in "…" and
     the full text shows as a hover title (see the TRUNCATING list below). */
  .so-page .specs-table .col-fixed {
    width: 160px;
    min-width: 160px;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Calculated Values (645 / 625 basis). */
  .so-page .calc-values-wrap {
    grid-column: 1 / -1;
    overflow-x: auto;
    border: 1px solid var(--so-line-soft);
    border-radius: 12px;
  }
  .so-page .calc-values-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .so-page .calc-values-table th,
  .so-page .calc-values-table td {
    padding: 10px 14px;
    text-align: right;
    border-bottom: 1px solid var(--so-line-soft);
    border-right: 1px solid var(--so-line-soft);
    white-space: nowrap;
  }
  .so-page .calc-values-table th:last-child,
  .so-page .calc-values-table td:last-child { border-right: none; }
  .so-page .calc-values-table tbody tr:last-child th,
  .so-page .calc-values-table tbody tr:last-child td { border-bottom: none; }
  .so-page .calc-values-table thead th {
    background: var(--so-brand);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .so-page .calc-values-table tbody th {
    text-align: center;
    background: var(--so-brand-soft);
    color: var(--so-brand);
    font-weight: 700;
  }
  .so-page .calc-values-table tbody td { color: var(--so-ink); font-weight: 650; }
</style>

<div class="main-content so-page">
  <form action="/fairtech/form/prodcalc" class="needs-validation so-form" method="post" novalidate>
    <% const isEdit = (typeof editBinding !== "undefined" && editBinding); %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% if (isEdit) { %><input type="hidden" name="editId" value="<%= editBinding._id %>" /><% } %>

    <div class="so-sheet">
      <header class="so-hero">
        <div class="so-hero__text"><h1><%= isEdit ? "Edit Production Binding" : "Production Binding" %></h1></div>
      </header>

      <!-- ================= SALES VALUES =================
           Row: 7 + 7 + 6 + 4 + 8 = 32. Location holds short names
           (SHOLAPUR, BHIWANDI) so it gives two of its columns to Select
           Label, whose options carry size, family, ups and core. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-user"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Sales Values</h2></div>
        </div>
        <div class="so-grid">
          <div id="client-name-div" class="span-seven">
            <label for="company-name"><span class="so-label-text">Client Name</span> <span class="asterisk client-type-badge"></span></label>
            <select name="companyName" id="company-name" class="form-control select-tag" required>
              <option value="" selected disabled hidden>Search</option>
              <% for (let client of clients) { %>
                <option value="<%= client %>"><%= client %></option>
              <% } %>
            </select>
          </div>

          <div class="span-seven">
            <label for="user-name"><span class="so-label-text">User Name</span></label>
            <select id="user-name" class="form-control select-tag" required>
              <option value="" selected disabled hidden>Search</option>
            </select>
            <input type="hidden" name="userId" id="user-id-hidden" />
          </div>

          <div class="span-six">
            <label for="user-contact"><span class="so-label-text">Contact</span></label>
            <input type="text" id="user-contact" class="form-control" placeholder="—" readonly />
          </div>

          <div class="span-four">
            <label for="user-location"><span class="so-label-text">Location</span></label>
            <select name="userLocation" id="user-location" class="form-control select-tag" required>
              <option value="" selected disabled hidden>—</option>
            </select>
          </div>

          <%# Plain only by default -- that's the overwhelming majority of the
              work. prefillFromEdit ticks Color when the binding it's
              restoring needs it, so an existing colour binding still finds
              its label in the list. %>
          <div class="span-eight so-has-aside">
            <label for="label-select"><span class="so-label-text">Select Label</span></label>
            <span class="so-label-aside">
              <label class="so-check"><input type="checkbox" id="label-type-plain" checked /> Plain</label>
              <label class="so-check"><input type="checkbox" id="label-type-color" /> Color</label>
            </span>
            <select id="label-select" name="labelProductId" class="form-control select-tag" required>
              <option value="" selected disabled hidden>Select a client first</option>
            </select>
            <input type="hidden" name="labelMasterId" id="label-master-id-hidden" />
          </div>

          <!-- Specs card – shown after a label is selected -->
          <div id="specs-card" class="specs-card">
            <div class="specs-table-wrap">
              <table class="specs-table">
                <thead><tr><th>Family</th><th id="d-instructions-wrap">Instructions</th><th>Width</th><th>Height</th><th>Job Type</th><th id="d-job-name-wrap">Job Name</th><th id="d-front-color-wrap">Front Color</th><th id="d-back-color-wrap">Back Color</th><th id="d-varnish-wrap">Varnish</th><th id="d-foil-no-wrap">No of Foil</th><th>Gap</th><th>Ups</th><th>Core</th><th>Per Roll QTY</th><th id="d-first-out-wrap">First Out</th><th>Rate / 1K</th><th>Rate / Label</th><th>Rate / Roll</th></tr></thead>
                <tbody><tr><td id="d-family">—</td><td id="d-instructions">—</td><td id="d-width">—</td><td id="d-height">—</td><td id="d-job-type">—</td><td id="d-job-name">—</td><td id="d-front-color">—</td><td id="d-back-color">—</td><td id="d-varnish">—</td><td id="d-foil-no">—</td><td id="d-gap">—</td><td id="d-ups">—</td><td id="d-core">—</td><td id="d-per-roll-qty">—</td><td id="d-first-out">—</td><td id="d-rate-per-k">—</td><td id="d-rate-per-label">—</td><td id="d-per-roll">—</td></tr></tbody>
              </table>
            </div>
          </div>

          <!-- Hidden fields populated from the selected label binding -->
          <input type="hidden" id="paper-type"          name="paperType" />
          <input type="hidden" id="label-family"        name="labelFamily" />
          <input type="hidden" id="label-width"         name="labelWidth" />
          <input type="hidden" id="label-height"        name="labelHeight" />
          <input type="hidden" id="job-ups"             name="jobUps" />
          <input type="hidden" id="rate-per-1k"         name="perOneK" />
          <input type="hidden" id="rate-per-label"      name="ratePerLabel" />
          <input type="hidden" id="printed"             name="printed" />
          <input type="hidden" id="job-name"            name="jobName" />
          <input type="hidden" id="order-quantity"      name="orderQuantity" />
          <input type="hidden" id="prod-cost-percentage" name="cost" />
          <input type="hidden" id="prod-die-across"     name="prodDieAcross" />
          <input type="hidden" id="prod-die-no"         name="prodDieno" />
        </div>
      </section>

      <!-- ================= DIE =================
           Row: 8 + 24 = 32. Machine No is the multi-select -- see the
           .choices[data-type*="select-multiple"] rules in salesOrderForm.css.
           It's .so-wide so it keeps a full row once the grid collapses to
           4 columns (a 1-column chip field can't hold a chip). -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-scissors"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Die</h2></div>
          <div class="so-card__aside">
            <button type="button" id="die-reset-btn" class="so-toggle"><i class="fa-solid fa-rotate-left"></i> Reset</button>
          </div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="die-select"><span class="so-label-text">Select Die</span></label>
            <select id="die-select" class="form-control select-tag">
              <option value="" selected disabled hidden>Select a label first</option>
            </select>
          </div>
          <div id="die-machine-wrap" class="span-eight so-wide" style="grid-column: span 24;">
            <label for="die-machine-no"><span class="so-label-text">Machine No</span></label>
            <input type="text" id="die-machine-no" class="form-control" placeholder="Select a die first" disabled />
            <select id="die-machine-no-select" name="dieMachineNo" multiple style="display:none;"></select>
          </div>
          <div id="die-specs-card" class="specs-card">
            <div class="specs-table-wrap">
              <table class="specs-table">
                <thead><tr><th class="col-fixed">Die Make</th><th>Blade Type</th><th>Width</th><th>Height</th><th>Mag Teeth</th><th>Across Gap</th><th>Repeat Gap</th><th>Across Ups</th><th>Down Ups</th><th>Total Ups</th><th>Status</th><th>Owned By</th><th>Remark</th></tr></thead>
                <tbody><tr><td id="ds-die-make" class="col-fixed">—</td><td id="ds-blad-type">—</td><td id="ds-width">—</td><td id="ds-height">—</td><td id="ds-teeth">—</td><td id="ds-across-gap">—</td><td id="ds-rep-gap">—</td><td id="ds-flat-across">—</td><td id="ds-flat-down">—</td><td id="ds-total-ups">—</td><td id="ds-status">—</td><td id="ds-owned-by">—</td><td id="ds-remark">—</td></tr></tbody>
              </table>
            </div>
          </div>
          <input type="hidden" name="dieId" id="die-id-hidden" />
        </div>
      </section>

      <!-- ================= BLOCK =================
           Row: 8 + 24 = 32. Hidden outright for a Plain label (JS sets
           display none / "" on this section). -->
      <section id="block-section" class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-shapes"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Block</h2></div>
          <div class="so-card__aside">
            <button type="button" id="block-reset-btn" class="so-toggle"><i class="fa-solid fa-rotate-left"></i> Reset</button>
          </div>
        </div>
        <div class="so-grid">
          <div class="span-eight">
            <label for="block-select"><span class="so-label-text">Select Block</span></label>
            <select id="block-select" class="form-control select-tag">
              <option value="" disabled selected hidden>Select a label first</option>
            </select>
          </div>
          <div id="block-machine-wrap" class="span-eight so-wide" style="grid-column: span 24;">
            <label for="block-machine-no-input"><span class="so-label-text">Machine No</span></label>
            <input type="text" id="block-machine-no-input" class="form-control" placeholder="Select a block first" disabled />
            <select id="block-machine-no-select" multiple style="display:none;"></select>
          </div>
          <div id="block-specs-card" class="specs-card">
            <div class="specs-table-wrap">
              <table class="specs-table">
                <thead><tr><th>Block No</th><th>Family</th><th>Block Make</th><th>Artwork No</th><th>Version</th><th>Width</th><th>Height</th><th>Gap</th><th>RePass</th><th>Status</th><th>Owned By</th><th>Remark</th><th>Front / Back Color</th><th>Varnish</th><th>Foil No</th><th>Lamination / Plate</th></tr></thead>
                <tbody><tr><td id="bs-block-no">—</td><td id="bs-family">—</td><td id="bs-make">—</td><td id="bs-artwork-no">—</td><td id="bs-version">—</td><td id="bs-width">—</td><td id="bs-height">—</td><td id="bs-gap">—</td><td id="bs-repass">—</td><td id="bs-status">—</td><td id="bs-owned-by">—</td><td id="bs-remark">—</td><td id="bs-colors">—</td><td id="bs-varnish">—</td><td id="bs-foil-no">—</td><td id="bs-lamination-plate">—</td></tr></tbody>
              </table>
            </div>
          </div>
          <input type="hidden" name="blockId" id="block-id-hidden" />
        </div>
      </section>

      <!-- ================= PRODUCTION VALUES =================
           Row 1: 9 + 7 + 8 + 8 = 32. Row 2 (Color jobs only): 10 + 22 = 32.
           Vendor / Family / Paper Code / Paper size are cleared and disabled
           by the Out Source tick; Anilox / Print Cylinder show for Color. -->
      <section class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-industry"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Production Values</h2></div>
        </div>
        <div class="so-grid">
          <div class="span-eight so-has-aside" style="grid-column: span 9;">
            <label for="prod-vendor-name"><span class="so-label-text">Vendor Name</span></label>
            <span class="so-label-aside">
              <label class="so-check"><input type="checkbox" id="out-source-checkbox" name="isOutsource" <%= (isEdit && editBinding.isOutsource) || (typeof prefillBinding !== "undefined" && prefillBinding && prefillBinding.isOutsource) ? "checked" : "" %> /> Out Source</label>
            </span>
            <select id="prod-vendor-name" name="prodVendorName" class="form-control select-tag">
              <option value="" selected disabled hidden>Select vendor</option>
              <% for (let vendor of vendors) { %>
                <option value="<%= vendor %>"><%= vendor %></option>
              <% } %>
            </select>
          </div>

          <div class="span-seven">
            <label for="prod-paper-family"><span class="so-label-text">Family</span></label>
            <select id="prod-paper-family" class="form-control select-tag" name="prodPaperFamily">
              <option value="" selected disabled hidden>Select family</option>
              <% families?.forEach(f => { %><option value="<%= f %>"><%= f %></option><% }) %>
            </select>
          </div>

          <div class="span-eight">
            <label for="prod-paper-code"><span class="so-label-text">Paper Code</span></label>
            <select id="prod-paper-code" class="form-control select-tag auto-calc" name="prodPaperCode" required>
              <option value="" selected disabled hidden>Select paper code</option>
              <% prodCodes?.forEach(pc => { %><option value="<%= pc %>"><%= pc %></option><% }) %>
            </select>
          </div>

          <div class="span-eight">
            <label for="prod-paper-size"><span class="so-label-text">Paper size</span></label>
            <input type="number" step="any" id="prod-paper-size" class="form-control auto-calc" name="prodPaperSize" placeholder="Enter paper size" required />
          </div>

          <div class="span-six" style="display:none;">
            <label for="prod-paper-rate"><span class="so-label-text">Rate</span></label>
            <input type="text" inputmode="decimal" id="prod-paper-rate" class="form-control" name="prodPaperRate" placeholder="From Paper Master" autocomplete="off" />
          </div>
          <!-- Reference to the Paper Master doc the rate/family above were resolved
               from (see resolvePaperMaster()) -- lets the rate shown on the
               Production Binding view stay live with Paper Master edits instead of
               freezing at whatever it was when this binding was saved. -->
          <input type="hidden" id="prod-paper-id" name="paperId" />

          <div id="prod-anilox-wrap" class="span-penta">
            <label for="prod-anilox-number"><span class="so-label-text">Anilox Number</span></label>
            <input type="text" id="prod-anilox-number" class="form-control" name="aniloxNumber" placeholder="Enter anilox number" />
          </div>
          <div id="prod-print-cylinder-wrap" class="span-penta" style="grid-column: span 22;">
            <label for="prod-print-cylinder"><span class="so-label-text">Print Cylinder</span></label>
            <select id="prod-print-cylinder" class="form-control select-tag" name="printCylinderId">
              <option value="" selected disabled hidden>Select print cylinder</option>
              <% (printCylinders || []).forEach((pc) => { %>
                <option value="<%= pc._id %>"><%= pc.label %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </section>

      <!-- ================= CALCULATED VALUES =================
           Hidden outright for an Out Source binding (nothing in it means
           anything without a paper size and rate). -->
      <section id="calc-values-card" class="so-card">
        <div class="so-card__head">
          <span class="so-card__icon"><i class="fa-solid fa-calculator"></i></span>
          <div class="so-card__titles"><h2 class="so-card__title">Calculated Values</h2></div>
        </div>
        <div class="so-grid">
          <div class="calc-values-wrap">
            <table class="calc-values-table">
              <thead>
                <tr>
                  <th>Divisor</th>
                  <th>Production Area</th>
                  <th>Production sq inchs Rate</th>
                  <th>Sq Mtrs Rate</th>
                  <th>Per Label Prod Cost</th>
                  <th>Margin</th>
                  <th>Margin/1000</th>
                  <th>Actual (%)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">645</th>
                  <td id="c645-area">—</td>
                  <td id="c645-rate">—</td>
                  <td id="c645-sqm">—</td>
                  <td id="c645-plc">—</td>
                  <td id="c645-margin">—</td>
                  <td id="c645-margin1k">—</td>
                  <td id="c645-actual">—</td>
                </tr>
                <tr>
                  <th scope="row">625</th>
                  <td id="c625-area">—</td>
                  <td id="c625-rate">—</td>
                  <td id="c625-sqm">—</td>
                  <td id="c625-plc">—</td>
                  <td id="c625-margin">—</td>
                  <td id="c625-margin1k">—</td>
                  <td id="c625-actual">—</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Saved calc values. Existing field names carry the 645 basis; the 625
               basis is stored alongside under *625 names. -->
          <input type="hidden" name="prodArea"       id="prod-area" />
          <input type="hidden" name="productionRate" id="prod-rate" />
          <input type="hidden" name="prodSqMeter"    id="prod-tot-sqr-m" />
          <input type="hidden" name="prodPerLabelCost" id="prod-plc" />
          <input type="hidden" name="prodMargin"     id="prod-margin" />
          <input type="hidden" name="prodMargin1k"   id="prod-margin1k" />
          <input type="hidden" name="prodActual"     id="prod-actual-percentage" />
          <input type="hidden" name="prodArea625"       id="prod-area-625" />
          <input type="hidden" name="productionRate625" id="prod-rate-625" />
          <input type="hidden" name="prodSqMeter625"    id="prod-tot-sqr-m-625" />
          <input type="hidden" name="prodPerLabelCost625" id="prod-plc-625" />
          <input type="hidden" name="prodMargin625"     id="prod-margin-625" />
          <input type="hidden" name="prodMargin1k625"   id="prod-margin1k-625" />
          <input type="hidden" name="prodActual625"     id="prod-actual-percentage-625" />
        </div>
      </section>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="so-actions">
      <span class="so-actions__hint">
        <i class="fa-regular fa-circle-check"></i>
        <span class="so-actions__hint-text">Pick the label, then its die and block; Calculated Values fill in from the paper size and rate.</span>
      </span>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> <%= isEdit ? "Update Production Binding" : "Submit Order Details" %></button>
    </div>
  </form>
</div>

  <script>
    // Full text on hover for anything this page cuts short with an ellipsis --
    // see formStyle.md's "Long text" section. Delegated from document, so it
    // also covers what Choices builds later (dropdown options, machine chips).
    (function () {
      const TRUNCATING = [
        ".so-page .so-label-text",
        ".so-page .form-control",
        ".so-page .specs-table td.col-fixed",
        ".so-page .choices__list--single .choices__item",
        ".so-page .choices__list--dropdown .choices__item",
        ".so-page .choices__list[aria-expanded] .choices__item",
        ".so-page .so-actions__hint-text",
      ].join(",");

      document.addEventListener("mouseover", (e) => {
        const el = e.target instanceof Element ? e.target.closest(TRUNCATING) : null;
        if (!el) return;
        const full = (el.matches("input, textarea") ? el.value : el.textContent).replace(/\s+/g, " ").trim();
        const isCut = el.scrollWidth > el.clientWidth + 1;
        if (isCut && full) {
          el.title = full;
          el.dataset.soTip = "1";
        } else if (el.dataset.soTip) {
          el.removeAttribute("title");
          delete el.dataset.soTip;
        }
      });
    })();
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {

      /* ══════════════════════════════════════
         CLIENT → USER → CONTACT → LOCATION
      ══════════════════════════════════════ */
      const clientSelect   = document.getElementById("company-name");
      const userSelect     = document.getElementById("user-name");
      const userIdInput    = document.getElementById("user-id-hidden");
      const contactInput   = document.getElementById("user-contact");
      const locationSelect = document.getElementById("user-location");
      const asterisk       = document.querySelector(".asterisk");
      const labelSelect    = document.getElementById("label-select");
      const specsCard      = document.getElementById("specs-card");
      const labelTypePlain = document.getElementById("label-type-plain");
      const labelTypeColor = document.getElementById("label-type-color");

      const clientChoices   = new Choices(clientSelect,   { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      const userChoices     = new Choices(userSelect,     { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      const locationChoices = new Choices(locationSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      const labelChoices    = new Choices(labelSelect,    { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      const vendorChoices   = new Choices(document.getElementById("prod-vendor-name"), { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      const printCylinderChoices = new Choices(document.getElementById("prod-print-cylinder"), { searchEnabled: true, shouldSort: false, itemSelectText: "" });

      /* ══════════════════════════════════════
         PAPER MASTER — smart cascading Choices.js selects
         Vendor Name / Paper Code / Family are strict selects sourced from
         the Paper Master, cascade-filtered against each other via the same
         /fairtech/paperstock/filter-specs endpoint the Paper Stock page
         uses -- picking any one of the three narrows the other two's
         options (and auto-selects one that's been narrowed to a single
         choice), so e.g. choosing Family also surfaces which Vendor/Paper
         Code combinations actually carry that family. Once Vendor + Paper
         Code match an existing Paper Master spec, /fairtech/paperstock/resolve
         auto-fills Rate (still a free value -- never clobbered once the
         operator edits it) and Family. Paper size has no Paper Master
         equivalent and stays a plain field.
      ══════════════════════════════════════ */
      const prodVendorSelect = document.getElementById("prod-vendor-name");
      const prodPaperCodeSelect = document.getElementById("prod-paper-code");
      const prodPaperRateInput = document.getElementById("prod-paper-rate");
      const prodPaperFamilySelect = document.getElementById("prod-paper-family");
      const prodPaperIdInput = document.getElementById("prod-paper-id");

      const paperCodeChoices = new Choices(prodPaperCodeSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
      const paperFamilyChoices = new Choices(prodPaperFamilySelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

      /* ══════════════════════════════════════
         OUT SOURCE — where an outsourced job starts
         Ticking this marks the whole production binding as bought in as
         finished labels rather than printed in-house, which is what routes
         its sales orders past Pending Production and onto the Outsourced
         Orders page (see models/utilities/productionBinding.js,
         utils/pendingProduction.js and routes/inventory/reorder.js).

         There is no in-house paper behind such a job, so the entire paper
         side of the form goes away with it: Vendor Name (the outsourcing
         vendor is bound separately, through the Purchase -> Outsourced
         Orders flow), Family, Paper Code, Paper size and the resolved
         rate/paperId are all cleared, disabled and no longer required. The
         Calculated Values table is hidden outright rather than left showing
         two rows of em-dashes -- every figure in it (production area, sq
         inch rate, per-label prod cost, margin) is derived from the paper
         size and rate, so none of it can mean anything here.

         POST /form/prodcalc blanks the same fields server-side, since a
         disabled control isn't posted at all and findByIdAndUpdate would
         otherwise leave an in-house binding's old paper details behind when
         it's switched to outsourced.

         Die and Block are deliberately left alone: the die may well be
         FAIRTECH's own, sent out to the vendor, so an outsourced binding can
         still usefully record which tooling the job runs on. Neither has ever
         been a required field, so nothing forces a pick either -- the only
         required fields on this form are Client, User, Location, Label and
         (in-house only) Paper Code + Paper size.
      ══════════════════════════════════════ */
      const outSourceCheckbox = document.getElementById("out-source-checkbox");
      const prodPaperSizeInput = document.getElementById("prod-paper-size");
      const calcValuesEls = [
        document.getElementById("calc-values-card"),
      ];
      const isOutsourced = () => !!(outSourceCheckbox && outSourceCheckbox.checked);

      // Choices rebuilds the placeholder element on every render, so this must
      // run LAST (after enable/disable) and be re-applied on each toggle.
      const setChoicesPlaceholderText = (choices, el, text) => {
        const wrap = choices.containerOuter?.element || el.closest(".choices");
        const ph = wrap && wrap.querySelector(".choices__placeholder");
        if (ph) ph.textContent = text;
      };

      function syncOutsourceFields() {
        const off = isOutsourced();

        [
          [vendorChoices, prodVendorSelect, "Select vendor"],
          [paperFamilyChoices, prodPaperFamilySelect, "Select family"],
          [paperCodeChoices, prodPaperCodeSelect, "Select paper code"],
        ].forEach(([choices, el, prompt]) => {
          if (off) {
            choices.removeActiveItems();   // clear whatever was picked
            choices.disable();
          } else {
            choices.enable();
          }
          // No "Select ..." prompt on a field that can't be selected from.
          setChoicesPlaceholderText(choices, el, off ? "Disabled" : prompt);
        });

        prodPaperCodeSelect.required = !off;
        if (prodPaperSizeInput) {
          prodPaperSizeInput.required = !off;
          prodPaperSizeInput.disabled = off;
          if (off) prodPaperSizeInput.value = "";
        }
        if (off) {
          // The rate and its Paper Master reference were resolved from a paper
          // that no longer applies -- drop both, and the userEdited flag with
          // them so a later un-tick can resolve a fresh rate.
          if (prodPaperRateInput) {
            prodPaperRateInput.value = "";
            delete prodPaperRateInput.dataset.userEdited;
          }
          if (prodPaperIdInput) prodPaperIdInput.value = "";
        }

        calcValuesEls.forEach((el) => { if (el) el.style.display = off ? "none" : ""; });

        // Paper size is now empty, so this blanks the persisted calc fields
        // (prodArea, prodMargin, ...) rather than leaving a stale set behind.
        recalcProduction();
      }

      if (outSourceCheckbox) {
        outSourceCheckbox.addEventListener("change", syncOutsourceFields);
        syncOutsourceFields();   // honour the checkbox's initial state on load
      }

      const paperFieldMeta = {
        "prod-vendor-name":  { el: prodVendorSelect,      choices: vendorChoices,      apiKey: "vendors",    param: "vendorName", placeholder: "Select vendor" },
        "prod-paper-code":   { el: prodPaperCodeSelect,   choices: paperCodeChoices,   apiKey: "prodCodes", param: "prodCode", placeholder: "Select paper code" },
        "prod-paper-family": { el: prodPaperFamilySelect, choices: paperFamilyChoices, apiKey: "families",  param: "family",   placeholder: "Select family" },
      };

      async function filterPaperFields(changedFieldId) {
        // Nothing to cascade on an outsourced binding -- all three fields are
        // empty and disabled, and re-rendering them here would rebuild their
        // placeholders back to "Select ...".
        if (isOutsourced()) return;

        const params = new URLSearchParams();
        Object.values(paperFieldMeta).forEach(({ el, param }) => { if (el.value) params.set(param, el.value); });

        try {
          const res = await fetch(`/fairtech/paperstock/filter-specs?${params}`);
          const data = await res.json();
          if (!data) return;

          let autoFilled = false;

          Object.entries(paperFieldMeta).forEach(([fieldId, meta]) => {
            if (fieldId === changedFieldId) return;
            const values = (data[meta.apiKey] || []).map(String);
            const currentValue = meta.el.value;
            const newChoices = values.map((v) => ({ value: v, label: v, selected: v === currentValue }));
            meta.choices.clearStore();
            meta.choices.setChoices(
              [{ value: "", label: meta.placeholder, disabled: true, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
              "value", "label", true,
            );

            // Narrowed down to a single option and the operator hasn't picked
            // one yet — select it for them instead of leaving it blank.
            if (!currentValue && values.length === 1) {
              meta.choices.setChoiceByValue(values[0]);
              autoFilled = true;
            }
          });

          // A field just got auto-picked -- re-run the cascade so it can
          // narrow its sibling field too, and pull the rate/family it unlocks.
          if (autoFilled) {
            filterPaperFields();
            resolvePaperMaster();
          }
        } catch (err) {
          console.error("Filter paper fields error:", err);
        }
      }

      let paperResolveTimer = null;
      function schedulePaperResolve() {
        if (paperResolveTimer) clearTimeout(paperResolveTimer);
        paperResolveTimer = setTimeout(resolvePaperMaster, 300);
      }

      async function resolvePaperMaster() {
        const vendorName = prodVendorSelect.value.trim();
        const prodCode = prodPaperCodeSelect.value.trim();
        const family = prodPaperFamilySelect.value.trim();
        if (!vendorName || !prodCode) return;

        try {
          const res = await fetch("/fairtech/paperstock/resolve", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ vendorName, prodCode, family }),
          });
          const data = await res.json();
          if (!data.found) return;
          if (!prodPaperRateInput.dataset.userEdited && data.rate != null) prodPaperRateInput.value = data.rate;
          if (data.family) paperFamilyChoices.setChoiceByValue(data.family);
          if (data.paperId) prodPaperIdInput.value = data.paperId;
          recalcProduction();   // Actual % depends on this rate
        } catch (err) {
          console.error("Paper Master resolve error:", err);
        }
      }

      prodPaperRateInput.addEventListener("input", () => { prodPaperRateInput.dataset.userEdited = "true"; recalcProduction(); });
      prodVendorSelect.addEventListener("change", () => { filterPaperFields("prod-vendor-name"); resolvePaperMaster(); });
      prodPaperCodeSelect.addEventListener("change", () => { filterPaperFields("prod-paper-code"); resolvePaperMaster(); });
      prodPaperFamilySelect.addEventListener("change", () => { filterPaperFields("prod-paper-family"); resolvePaperMaster(); });

      let fetchedClientData = null;
      let clientLabels = [];
      let prefilling = false;   // true while edit-mode prefill runs, to mute auto-cascade

      // Fetch a client's users + label bindings and populate their dropdowns.
      // Returns the user list (or null on failure) so callers can await it.
      async function loadClientData(name) {
        /* reset downstream */
        userChoices.removeActiveItems();    userChoices.clearStore();
        locationChoices.removeActiveItems(); locationChoices.clearStore();
        labelChoices.removeActiveItems();   labelChoices.clearStore();
        contactInput.value = "";
        userIdInput.value = "";
        specsCard.style.display = "none";
        clearSpecsCard();
        clearFormFields();
        fetchedClientData = null;
        clientLabels = [];

        if (!name) return null;

        try {
          /* user data */
          const uRes = await fetch(`/fairtech/form/labels/${encodeURIComponent(name)}`);
          if (!uRes.ok) throw new Error("user fetch failed");
          fetchedClientData = await uRes.json();

          if (asterisk) {
            asterisk.textContent = `(${fetchedClientData.clientType})`;
            asterisk.classList.remove("badge-dealer", "badge-client");
            if (fetchedClientData.clientType === "DEALER") asterisk.classList.add("badge-dealer");
            else if (fetchedClientData.clientType === "CLIENT") asterisk.classList.add("badge-client");
          }

          const users = fetchedClientData.users || [];
          userChoices.setChoices(users.map(u => ({ value: u._id, label: u.userName })), "value", "label", true);

          /* label bindings — fetched once, then filtered by the chosen location on render */
          const lRes = await fetch(`/fairtech/form/prodcalc/client-labels/${encodeURIComponent(name)}`);
          if (!lRes.ok) throw new Error("label fetch failed");
          clientLabels = await lRes.json();

          return users;
        } catch (err) {
          console.error("Client fetch error:", err);
          return null;
        }
      }

      clientSelect.addEventListener("change", async function () {
        if (prefilling) return;
        const name = this.value;
        const users = await loadClientData(name);
        if (!name || !users) return;
        if (users.length === 1) {
          userChoices.setChoiceByValue(users[0]._id);
          fillUserDetails(users[0]._id);   // selects the sole location and renders its labels
        } else {
          renderLabelChoices();            // no location chosen yet → prompts to pick one
        }
      });

      userSelect.addEventListener("change", function () { if (prefilling) return; fillUserDetails(this.value); });

      // Labels are location-specific, so re-filter the dropdown on location change.
      locationSelect.addEventListener("change", renderLabelChoices);

      // Same for the Plain / Color tick boxes. renderLabelChoices clears the
      // current pick and the specs card, which is what we want -- the label
      // that was selected may not survive the new filter. Muted during edit
      // prefill so it can't wipe the binding being restored.
      [labelTypePlain, labelTypeColor].forEach((cb) => {
        if (cb) cb.addEventListener("change", () => { if (!prefilling) renderLabelChoices(); toggleAniloxPrintCylinder(); });
      });

      // Anilox Number / Print Cylinder only mean anything for a Color job --
      // a Plain label has neither. Unlike renderLabelChoices() above, this is
      // pure visibility and carries no data loss, so it runs even while
      // prefilling (edit prefill flips labelTypeColor.checked directly,
      // without firing "change").
      function toggleAniloxPrintCylinder() {
        const wantColor = !!(labelTypeColor && labelTypeColor.checked);
        show("prod-anilox-wrap", wantColor);
        show("prod-print-cylinder-wrap", wantColor);
      }
      toggleAniloxPrintCylinder();

      function fillUserDetails(selectedId) {
        locationChoices.removeActiveItems();
        locationChoices.clearStore();
        contactInput.value = "";
        userIdInput.value = "";
        if (!selectedId || !fetchedClientData) { renderLabelChoices(); return; }

        const matched = (fetchedClientData.users || []).filter(u => String(u._id) === String(selectedId));
        if (!matched.length) { renderLabelChoices(); return; }

        userIdInput.value = selectedId;
        contactInput.value = matched[0].userContact || "";

        const seen = new Set();
        const locs = [];
        for (const u of matched) {
          const p = (u.userLocation || "").trim();
          if (p && !seen.has(p)) { seen.add(p); locs.push(p); }
          for (const ld of (u.locationDetails || [])) {
            const l = (ld.userLocation || "").trim();
            if (l && !seen.has(l)) { seen.add(l); locs.push(l); }
          }
        }
        locationChoices.setChoices(locs.map(l => ({ value: l, label: l })), "value", "label", true);
        if (locs.length === 1) locationChoices.setChoiceByValue(locs[0]);
        // Labels depend on the chosen location; (re)render for the current one.
        renderLabelChoices();
      }

      /* Fill the label dropdown with only the bindings for the selected location.
         Showing every client label regardless of location was the bug. */
      function renderLabelChoices() {
        labelChoices.removeActiveItems();
        labelChoices.clearStore();
        // Any previously selected label is invalid once the option list changes.
        specsCard.style.display = "none";
        clearSpecsCard();
        clearFormFields();

        const placeholder = (label) =>
          labelChoices.setChoices([{ value: "", label, disabled: true, selected: true }], "value", "label", true);

        if (!clientLabels.length) return placeholder("No labels found for this client");

        const loc = (locationSelect.value || "").trim();
        if (!loc) return placeholder("Select a location first");

        const normalizeLocationName = (value) =>
          String(value || "").trim().toUpperCase().replace(/\s+/g, " ").replace(/^[.,]+|[.,]+$/g, "");
        const sameLoc = (a, b) => normalizeLocationName(a) === normalizeLocationName(b);
        const forLoc = clientLabels.filter((b) => sameLoc(b.location, loc));
        if (!forLoc.length) return placeholder("No labels for this location");

        // Plain / Color tick boxes beside the field's label. Anything that
        // isn't explicitly COLOR counts as plain, so a binding with a blank or
        // unexpected jobType still appears somewhere rather than vanishing.
        const wantPlain = !labelTypePlain || labelTypePlain.checked;
        const wantColor = !labelTypeColor || labelTypeColor.checked;
        if (!wantPlain && !wantColor) return placeholder("Tick Plain or Color to list labels");

        const isColorLabel = (b) => String(b.jobType || "").trim().toUpperCase() === "COLOR";
        const forType = forLoc.filter((b) => (isColorLabel(b) ? wantColor : wantPlain));
        if (!forType.length) {
          return placeholder(
            wantPlain && wantColor
              ? "No labels for this location"
              : `No ${wantPlain ? "plain" : "colour"} labels for this location`,
          );
        }

        // Ups and core are part of the option text on purpose. One client user
        // at one location routinely holds several bindings off the *same* label
        // master -- same size and shape, but a different paper family, ups or
        // core, so a genuinely different product (e.g. 50x25 as 1-up PP and as
        // 2-up CHROMO). Size and family alone don't say which one you're
        // binding, and picking the wrong one is silent: the production binding
        // lands on a label with no live orders while the orders sit on its
        // sibling. Ups and core are also what the run itself depends on, so
        // they're the useful pair to see while choosing.
        labelChoices.setChoices(
          forType.map((b) => ({
            value: b._id,
            label: [
              `${b.labelWidth} x ${b.labelHeight}`,
              b.labelFamily || b.paperType || "—",
              b.labelUps ? `${b.labelUps} UPS` : null,
              b.labelCore ? `${b.labelCore} CORE` : null,
            ].filter(Boolean).join(" - "),
          })),
          "value", "label", true
        );
      }

      /* ══════════════════════════════════════
         LABEL SELECTION → SPECS CARD + FORM
      ══════════════════════════════════════ */
      labelSelect.addEventListener("change", function () {
        if (prefilling) return;
        const binding = clientLabels.find(b => String(b._id) === this.value);
        if (!binding) { specsCard.style.display = "none"; clearSpecsCard(); clearFormFields(); return; }
        populateSpecsCard(binding);
        applyBindingToForm(binding);
        specsCard.style.display = "block";
      });

      function txt(id, val) {
        const el = document.getElementById(id);
        if (el) el.textContent = val || "—";
      }

      function show(id, visible) {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.display = visible ? "" : "none";
        // A spec-table column is a <th> plus the <td> beneath it.
        if (el.tagName === "TH") {
          const cell = el.closest("table")?.tBodies[0]?.rows[0]?.cells[el.cellIndex];
          if (cell) cell.style.display = visible ? "" : "none";
        }
      }

      // "Rate Per 1000" is sourced from the label binding's Our Amount Per
      // 1000 (net of commission), not the raw/gross ratePerK -- ratePerLabel
      // is already (ratePerK - commissionPerK) / 1000 (see models/inventory/
      // labels.js), so multiplying it back by 1000 reconstructs Our Amount
      // Per 1000 without needing commissionPerK to be present on every b.
      function ourAmountPerK(b) {
        const perLabel = Number(b && b.ratePerLabel);
        return Number.isFinite(perLabel) ? Math.round(perLabel * 1000 * 100) / 100 : "";
      }

      function populateSpecsCard(b) {
        const isColor = b.jobType === "COLOR";
        const isPlain = b.jobType === "PLAIN";

        txt("d-job-type",    b.jobType);
        txt("d-job-name",    b.jobName);
        txt("d-front-color", b.frontColor);
        txt("d-back-color",  b.backColor);
        txt("d-instructions",b.instructions);
        txt("d-varnish",     b.varnish);
        txt("d-foil-no",     b.foilNo);
        txt("d-family",      b.labelFamily);
        txt("d-width",       b.labelWidth);
        txt("d-height",      b.labelHeight);
        txt("d-gap",         b.labelGap);
        txt("d-ups",         b.labelUps);
        txt("d-core",        b.labelCore);
        txt("d-per-roll-qty",b.perRollQty);
        txt("d-first-out",   b.firstOut);
        txt("d-rate-per-k",  ourAmountPerK(b));
        txt("d-rate-per-label", b.ratePerLabel);
        txt("d-per-roll",    b.perRoll);

        show("d-job-name-wrap",    isColor);
        show("d-front-color-wrap", isColor);
        show("d-back-color-wrap",  isColor);
        show("d-varnish-wrap",     isColor);
        show("d-foil-no-wrap",     isColor);
        show("d-instructions-wrap",isPlain);
        show("d-first-out-wrap",   !isPlain);
      }

      async function applyBindingToForm(b) {
        document.getElementById("label-width").value  = b.labelWidth  || "";
        document.getElementById("label-height").value = b.labelHeight || "";
        document.getElementById("paper-type").value   = b.paperType   || "";
        document.getElementById("label-family").value = b.labelFamily  || "";
        // Default the Production Values "Family" select from the bound
        // label's own family -- resolvePaperMaster() (once vendor + paper
        // code match a Paper Master spec) and, on edit, the binding's own
        // saved prodPaperFamily still take priority and overwrite this.
        // Family is a strict Paper Master list, so add the value first if
        // it isn't already an option (same as the vendor/prodCode/family
        // push-if-missing done server-side for edit/prefill bindings).
        // Skipped on an outsourced binding, along with the Vendor Name carry-over
        // below -- the whole paper side of the form is cleared and disabled there.
        if (!isOutsourced() && b.labelFamily) {
          if (![...prodPaperFamilySelect.options].some((o) => o.value === b.labelFamily)) {
            paperFamilyChoices.setChoices([{ value: b.labelFamily, label: b.labelFamily }], "value", "label", false);
          }
          paperFamilyChoices.setChoiceByValue(b.labelFamily);
          // setChoiceByValue doesn't reliably fire the underlying select's
          // native change event, so the Vendor/Paper Code narrowing cascade
          // (normally triggered by prodPaperFamilySelect's change listener)
          // has to be kicked off explicitly here -- otherwise Vendor Name
          // stays showing every vendor instead of just the ones carrying
          // this family.
          await filterPaperFields("prod-paper-family");
          await resolvePaperMaster();
        }
        // Carry the Vendor Name entered on the client label binding over to
        // Production Values -- but only when it's actually one of the SL
        // (PAPER) vendors this select is scoped to. Unlike Family above,
        // Label.vendorName isn't restricted to paper suppliers (it's a plain
        // Vendor Master pick on the label binding form), so it can name a
        // vendor -- e.g. an IT supplier -- that has no business appearing in
        // the Production paper-vendor field. Leave the field for the user to
        // pick by hand when it doesn't match a real paper vendor, rather than
        // push-if-missing it in like Family does.
        // Awaited *after* the family cascade above settles -- both hit the
        // same /filter-specs endpoint, and firing them concurrently let
        // whichever response landed last silently clobber the other's
        // selection (the vendor would appear to get set, then vanish).
        if (!isOutsourced() && b.vendorName && [...prodVendorSelect.options].some((o) => o.value === b.vendorName)) {
          vendorChoices.setChoiceByValue(b.vendorName);
          await filterPaperFields("prod-vendor-name");
          await resolvePaperMaster();
        }
        document.getElementById("job-name").value     = b.jobName     || "";
        document.getElementById("job-ups").value      = b.labelUps    || "";
        document.getElementById("rate-per-1k").value  = ourAmountPerK(b);
        document.getElementById("rate-per-label").value = b.ratePerLabel || "";
        document.getElementById("label-master-id-hidden").value = b.labelMasterId || "";
        const printedEl = document.getElementById("printed");
        if (printedEl) printedEl.value = b.jobType === "PLAIN" ? "Plain" : "Printed";
        const costEl = document.getElementById("prod-cost-percentage");
        if (costEl) costEl.value = b.jobType === "PLAIN" ? "1.35" : "1.55";
        const oqEl = document.getElementById("order-quantity");
        if (oqEl) oqEl.value = b.OrderQty || b.minOrderQty || "";
        document.getElementById("block-section").style.display = b.jobType === "PLAIN" ? "none" : "";
        getValues();
        // Dies are stored in mm. The label's own width/height can be rounded to
        // a standard size (customer asks for 102x102mm, the resolved master is
        // 100x100) or given in inches (carries a " ) -- either way, a die can
        // only be matched correctly against the real size. labelWidthMm /
        // labelHeightMm is that manually-entered precise mm equivalent, used
        // whenever it's been recorded regardless of how the label's own
        // width/height is expressed; fall back to the raw label dims only when
        // no mm override was given.
        const dieWidth  = b.labelWidthMm  || b.labelWidth;
        const dieHeight = b.labelHeightMm || b.labelHeight;
        loadDieOptions(dieWidth || "", dieHeight || "");
        loadBlockOptions(dieWidth || "", dieHeight || "");
      }

      function clearSpecsCard() {
        ["d-job-type","d-job-name","d-front-color","d-back-color","d-instructions",
         "d-varnish","d-foil-no","d-family","d-width","d-height","d-gap","d-ups",
         "d-core","d-per-roll-qty","d-first-out","d-rate-per-k","d-rate-per-label","d-per-roll"
        ].forEach(id => txt(id, ""));
        ["d-job-name-wrap","d-front-color-wrap","d-back-color-wrap",
         "d-varnish-wrap","d-foil-no-wrap","d-instructions-wrap","d-first-out-wrap"
        ].forEach(id => show(id, true));
      }

      function clearFormFields() {
        ["label-width","label-height","paper-type","label-family","job-name","job-ups","rate-per-1k","rate-per-label"]
          .forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
        document.getElementById("label-master-id-hidden").value = "";
        const p = document.getElementById("printed"); if (p) p.value = "";
        document.getElementById("block-section").style.display = "";
        resetDieSelect();
        resetBlockSelect();
      }

      /* ══════════════════════════════════════
         WIDTH / HEIGHT → CALC DATA FETCH
      ══════════════════════════════════════ */
      async function getValues() {
        if (prefilling) return;   // edit prefill keeps the stored sales values
        const w = document.getElementById("label-width").value;
        const h = document.getElementById("label-height").value;
        if (!w || !h) return;
        try {
          const res = await fetch(
            `/fairtech/form/prodcalc/data?w=${w}&h=${h}&client=${encodeURIComponent(clientSelect.value)}`
          );
          if (!res.ok) throw new Error("fetch failed");
          const data = await res.json();
          if (data) feedValues(data);
        } catch (err) {
          console.error("Calc data fetch error:", err);
        }
      }

      function feedValues(v) {
        const sv = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ""; };
        sv("rate-per-1k",           v.perOneK);
        sv("job-ups",               v.jobUps);
        sv("paper-type",            v.paperType);
        sv("printed",               v.printed);
        sv("job-name",              v.jobName);
        sv("order-quantity",        v.orderQuantity);
        sv("prod-cost-percentage",  v.costPercent);
        recalcProduction();
      }

