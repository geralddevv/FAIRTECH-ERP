<% layout('/layout/boilerplate') -%>
<% const ttrSummary = (stockData || []).reduce((summary, row) => ({ total: summary.total + Number(row.total || 0), booked: summary.booked + Number(row.booked || 0), available: summary.available + Number(row.available || 0) }), { total: 0, booked: 0, available: 0 }); %>
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<main class="contain ttr-stock-page" style="flex-direction:column; padding:10px; gap:10px;">
  <header class="indi-head"><h1>TTR Stock <span class="order-highlight active">Total: <%= ttrSummary.total %></span><span class="order-highlight active">Booked: <%= ttrSummary.booked %></span><span class="order-highlight active">Available: <%= ttrSummary.available %></span></h1><button type="button" class="inward-button" id="openInwardDialog"><i class="fa-solid fa-plus"></i> Inward Stock</button></header>
  <div id="ttr-stock-table"></div>
</main>

<div class="logout-modal inward-modal" id="inwardDialog" aria-hidden="true">
  <div class="logout-dialog inward-dialog" role="dialog" aria-modal="true" aria-labelledby="inwardDialogTitle">
  <form class="rottary-content inward-form" method="post" action="/fairtech/ttrstock/create" id="inwardForm">

    <!-- ================= HEADER ================= -->
    <header class="dialog-header">
      <!-- ================= TITLE ================= -->
      <div><h2 id="inwardDialogTitle">Inward TTR Stock</h2></div>
      <button type="button" class="dialog-close" id="closeInwardDialog" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </header>

    <input type="hidden" name="location" id="locationInput" />
    <div id="stock-display" class="stock-display"></div>

    <!-- ================= TTR SPECS ================= -->
    <div class="form-subheading"><div><h3>TTR Specifications</h3><span class="resolved-tape-label">TTR ID: <strong id="resolvedTtrDisplay">—</strong></span></div><button type="button" id="resetBtn" class="reset-button">Reset</button></div>
    <input type="hidden" name="ttrId" id="resolvedTtrId" />
    <div class="inward-fields">
    <input type="hidden" id="resolvedTtr" />

    <div class="span-seven">
      <label for="ttr-material-code">FS Code</label>
      <select name="ttrMaterialCode" id="ttr-material-code" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% materialCodes?.forEach(mc => { %>
          <option value="<%= mc %>"><%= mc %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-five">
      <label for="ttr-type">FS Type</label>
      <select name="ttrType" id="ttr-type" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% types?.forEach(t => { %>
          <option value="<%= t %>"><%= t %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-five">
      <label for="ttr-color">Color</label>
      <select name="ttrColor" id="ttr-color" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% colors?.forEach(c => { %>
          <option value="<%= c %>"><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-five">
      <label for="ttr-width">Width</label>
      <select name="ttrWidth" id="ttr-width" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% widths?.forEach(w => { %>
          <option value="<%= w %>"><%= w %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-five">
      <label for="ttr-mtrs">MTRS</label>
      <select name="ttrMtrs" id="ttr-mtrs" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% mtrsList?.forEach(m => { %>
          <option value="<%= m %>"><%= m %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-seven">
      <label for="ttr-ink-face">Ink Face</label>
      <select name="ttrInkFace" id="ttr-ink-face" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% inkFaces?.forEach(i => { %>
          <option value="<%= i %>"><%= i %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-six">
      <label for="ttr-core-id">Core ID</label>
      <select name="ttrCoreId" id="ttr-core-id" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% coreIds?.forEach(c => { %>
          <option value="<%= c %>"><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-six">
      <label for="ttr-core-length">Core Length</label>
      <select name="ttrCoreLength" id="ttr-core-length" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% coreLengths?.forEach(cl => { %>
          <option value="<%= cl %>"><%= cl %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-six">
      <label for="ttr-notch">Notch</label>
      <select name="ttrNotch" id="ttr-notch" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% notches?.forEach(n => { %>
          <option value="<%= n %>"><%= n %></option>
        <% }) %>
      </select>
    </div>
    <div class="span-seven">
      <label for="ttr-winding">Winding</label>
      <select name="ttrWinding" id="ttr-winding" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% windings?.forEach(w => { %>
          <option value="<%= w %>"><%= w %></option>
        <% }) %>
      </select>
    </div>

    <!-- ================= RESOLVED TTR ================= -->
    <!-- ================= QUANTITY ================= -->
    <div class="span-seven">
      <label>Quantity</label>
      <input type="number" name="quantity" class="form-control input-tag" min="1" placeholder="Enter Quantity" required />
    </div>

    <div class="span-four">
      <label>Date</label>
      <input type="date" id="stock-date" name="date" class="form-control input-tag" required />
    </div>

    <div class="span-half" style="grid-column: span 21;">
      <label>Remarks</label>
      <input type="text" name="remarks" class="form-control input-tag" placeholder="Enter Remarks" />
    </div>

    </div>
    <div class="span-full btn-grp">
      <button type="submit" id="submitBtn" disabled>Save Stock</button>
    </div>

  </form>
  </div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const stockRows = <%- safeJson(stockData || []) %>;
  const esc = value => String(value ?? "-").replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#039;" }[c]));
  new Tabulator("#ttr-stock-table", {
    data: stockRows, height:"100%", initialSort:[{column:"ttrProductId",dir:"asc"},{column:"location",dir:"asc"}], placeholder:"No TTR stock has been recorded yet",
    columns:[
      srNoColumn(),
      {title:"",width:62,headerSort:false,hozAlign:"center",formatter:cell => `<button class="stock-action-btn" onclick="window.location.href='${esc(cell.getRow().getData().profileUrl)}'" title="View profile"><i class="fa-solid fa-eye"></i></button>`},
      {title:"TTR ID",field:"ttrProductId",minWidth:160,headerFilter:"input",headerFilterPlaceholder:"Search",formatter:cell => `<a class="product-link" href="${esc(cell.getRow().getData().profileUrl)}">${esc(cell.getValue())}</a>`},
      {title:"FS Code",field:"ttrMaterialCode",minWidth:130,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"FS Type",field:"ttrType",minWidth:120,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Color",field:"ttrColor",width:110,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Width",field:"ttrWidth",width:95,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Mtrs",field:"ttrMtrs",width:95,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Ink Face",field:"ttrInkFace",width:110,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Core ID",field:"ttrCoreId",width:100,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Core Length",field:"ttrCoreLength",width:120,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Notch",field:"ttrNotch",width:95,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Winding",field:"ttrWinding",width:110,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Location",field:"location",minWidth:130,headerFilter:"input",headerFilterPlaceholder:"Search"},
      {title:"Total",field:"total",width:95,hozAlign:"center",sorter:"number"},
      {title:"Booked",field:"booked",width:95,hozAlign:"center",sorter:"number"},
      {title:"Available",field:"available",width:100,hozAlign:"center",sorter:"number"},
    ],
  });
  const dialog = document.getElementById("inwardDialog");
  const closeDialog = () => { dialog.classList.remove("show"); dialog.setAttribute("aria-hidden", "true"); };
  document.getElementById("openInwardDialog").addEventListener("click", () => { dialog.classList.add("show"); dialog.setAttribute("aria-hidden", "false"); });
  document.getElementById("closeInwardDialog").addEventListener("click", closeDialog);
  dialog.addEventListener("click", event => { if (event.target === dialog) closeDialog(); });
  const locationInput = document.getElementById("locationInput");
  const stockDisplay = document.getElementById("stock-display");
  const allLocations = <%- safeJson(locations || []) %>;
  const stockDateInput = document.getElementById("stock-date");

  if (stockDateInput) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");
    stockDateInput.value = `${yyyy}-${mm}-${dd}`;
  }

  const resolvedTtr = document.getElementById("resolvedTtr");
  const resolvedTtrDisplay = document.getElementById("resolvedTtrDisplay");
  const setResolvedTtr = (value) => { resolvedTtr.value = value || ""; if (resolvedTtrDisplay) resolvedTtrDisplay.textContent = value || "—"; };
  const resolvedTtrId = document.getElementById("resolvedTtrId");
  const submitBtn = document.getElementById("submitBtn");

  const ttrFields = [
    "ttr-type",
    "ttr-color",
    "ttr-material-code",
    "ttr-width",
    "ttr-mtrs",
    "ttr-ink-face",
    "ttr-core-id",
    "ttr-core-length",
    "ttr-notch",
    "ttr-winding",
  ];

  /* ================= CONFIG ================= */
  const fieldToApiKey = {
    "ttr-type": "types",
    "ttr-color": "colors",
    "ttr-material-code": "materialCodes",
    "ttr-width": "widths",
    "ttr-mtrs": "mtrsList",
    "ttr-ink-face": "inkFaces",
    "ttr-core-id": "coreIds",
    "ttr-core-length": "coreLengths",
    "ttr-notch": "notches",
    "ttr-winding": "windings",
  };

  const fieldToParam = {
    "ttr-type": "ttrType",
    "ttr-color": "ttrColor",
    "ttr-material-code": "ttrMaterialCode",
    "ttr-width": "ttrWidth",
    "ttr-mtrs": "ttrMtrs",
    "ttr-ink-face": "ttrInkFace",
    "ttr-core-id": "ttrCoreId",
    "ttr-core-length": "ttrCoreLength",
    "ttr-notch": "ttrNotch",
    "ttr-winding": "ttrWinding",
  };

  /* ================= CHOICES INIT ================= */
  const specChoices = {};
  ttrFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      specChoices[id] = new Choices(el, {
        searchEnabled: true,
        shouldSort: false,
        itemSelectText: "",
      });
    }
  });

  const initialOptions = {
    "ttr-type": <%- safeJson(types || []) %>,
    "ttr-color": <%- safeJson(colors || []) %>,
    "ttr-material-code": <%- safeJson(materialCodes || []) %>,
    "ttr-width": <%- safeJson(widths || []) %>,
    "ttr-mtrs": <%- safeJson(mtrsList || []) %>,
    "ttr-ink-face": <%- safeJson(inkFaces || []) %>,
    "ttr-core-id": <%- safeJson(coreIds || []) %>,
    "ttr-core-length": <%- safeJson(coreLengths || []) %>,
    "ttr-notch": <%- safeJson(notches || []) %>,
    "ttr-winding": <%- safeJson(windings || []) %>,
  };

  /* ================= SMART FILTER ================= */
  async function filterSpecs(changedFieldId) {
    const params = new URLSearchParams();
    ttrFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.value) {
        params.set(fieldToParam[id], el.value);
      }
    });

    try {
      const res = await fetch(`/fairtech/ttrstock/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      ttrFields.forEach(id => {
        if (id === changedFieldId) return; // skip the field that triggered the filter
        const choicesInstance = specChoices[id];
        if (!choicesInstance) return;

        const apiKey = fieldToApiKey[id];
        const filteredValues = data[apiKey] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const values = filteredValues.slice();
        const hasCurrent = currentValue && values.some(v => String(v) === String(currentValue));
        if (currentValue && !hasCurrent) values.unshift(currentValue);

        const newChoices = values.map(v => ({
          value: String(v),
          label: String(v),
          selected: String(v) === currentValue,
        }));

        // Auto-select if exactly one option and nothing currently selected
        if (filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some(c => c.selected) }, ...newChoices],
          "value",
          "label",
          true
        );
      });

      // If any fields were auto-selected, re-run filter to cascade
      if (autoSelected.length > 0) {
        await filterSpecs(autoSelected[0]);
        resolveTtr();
      }
    } catch (err) {
      console.error("Filter specs error:", err);
    }
  }

  /* ================= RESOLVE ================= */
  async function resolveTtr() {
    const values = {};
    for (let id of ttrFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) return;
      values[id] = el.value;
    }

    const res = await fetch("/fairtech/ttrstock/resolve", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        type: values["ttr-type"],
        color: values["ttr-color"],
        materialCode: values["ttr-material-code"],
        width: values["ttr-width"],
        mtrs: values["ttr-mtrs"],
        inkFace: values["ttr-ink-face"],
        coreId: values["ttr-core-id"],
        coreLength: values["ttr-core-length"],
        notch: values["ttr-notch"],
        winding: values["ttr-winding"],
      })
    });

    const data = await res.json();

    if (!data.found) {
      setResolvedTtr("No matching TTR found");
      resolvedTtrId.value = "";
      locationInput.value = "";
      renderStockDisplay({}, normalizeLocationName(locationInput.value || ""));
      submitBtn.disabled = true;
      return;
    }

    setResolvedTtr(data.TtrProductId || "");
    resolvedTtrId.value = data.ttrId;
    submitBtn.disabled = false;

    await updateStockDisplay();
  }

  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function selectStockLocation(locationName) {
    const normalizedLocation = normalizeLocationName(locationName);
    const radio = stockDisplay?.querySelector(`input[name="locationRadio"][value="${normalizedLocation}"]`);

    stockDisplay?.querySelectorAll(".location-option").forEach((option) => {
      option.classList.remove("selected");
    });

    if (!normalizedLocation) {
      locationInput.value = "";
      return false;
    }

    if (!radio) {
      locationInput.value = "";
      return false;
    }

    radio.checked = true;
    const row = radio.closest(".location-option");
    if (row) row.classList.add("selected");
    locationInput.value = normalizedLocation;
    return true;
  }

  function renderStockDisplay({ totalStock = "-", booked = "-", balance = "-", locations = [] } = {}, selectedLocation = "") {
    const locationRows = (locations.length ? locations : allLocations.map((loc) => ({ location: loc }))).map((loc) => {
      const locationName = normalizeLocationName(loc.location);
      const qty = loc.qty ?? loc.balance ?? "-";
      const isSelected = selectedLocation && locationName === selectedLocation;

      return `<label class="location-option${isSelected ? " selected" : ""}" data-location="${locationName}" data-qty="${qty}" data-booked="${loc.booked ?? "-"}" data-balance="${loc.balance ?? qty}">
        <input type="radio" name="locationRadio" class="location-radio" value="${locationName}" data-qty="${qty}" data-booked="${loc.booked ?? "-"}" data-balance="${loc.balance ?? qty}" ${isSelected ? "checked" : ""} />
        <span class="location-label">${locationName}:</span>
        <span class="location-qty">${loc.balance ?? qty}</span>
      </label>`;
    }).join("");

    stockDisplay.innerHTML = `<div class="location-list">${locationRows || '<span>No locations configured</span>'}</div><div class="stock-totals"><span>On hand <strong>${totalStock}</strong></span><span>Booked <strong>${booked}</strong></span><span>Available <strong>${balance}</strong></span></div>`;
    stockDisplay.style.display = "flex";

    stockDisplay.querySelectorAll('input[name="locationRadio"]').forEach((radio) => {
      radio.addEventListener("change", () => {
        selectStockLocation(radio.value);
      });
    });
  }

  async function updateStockDisplay() {
    if (!resolvedTtrId.value) {
      renderStockDisplay({}, normalizeLocationName(locationInput.value || ""));
      return;
    }

    try {
      const res = await fetch(`/fairtech/ttrstock/stock-info/${resolvedTtrId.value}`);
      const data = await res.json();
      const locations = Array.isArray(data?.locations) ? data.locations : [];
      const preferredLocation = normalizeLocationName(locationInput.value || "");
      const hasPreferred = preferredLocation && locations.some((loc) => normalizeLocationName(loc.location) === preferredLocation);
      const selectedLocation = hasPreferred ? preferredLocation : "";
      renderStockDisplay(data, selectedLocation);
      if (selectedLocation) {
        selectStockLocation(selectedLocation);
      } else {
        locationInput.value = "";
      }
    } catch (err) {
      console.error("Failed to load stock display", err);
      renderStockDisplay({}, normalizeLocationName(locationInput.value || ""));
    }
  }

  /* ================= HANDLERS ================= */
  const resetBtn = document.getElementById("resetBtn");
  if (resetBtn) {
    resetBtn.addEventListener("click", () => {
      ttrFields.forEach(id => {
        const choicesInstance = specChoices[id];
        if (!choicesInstance) return;
        const values = initialOptions[id] || [];
        const newChoices = values.map(v => ({
          value: String(v),
          label: String(v),
        }));
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: true }, ...newChoices],
          "value",
          "label",
          true
        );
      });

      setResolvedTtr("");
      resolvedTtrId.value = "";
      locationInput.value = "";
      renderStockDisplay({}, "");
      submitBtn.disabled = true;
    });
  }

  ttrFields.forEach(id => {
    document.getElementById(id)?.addEventListener("change", async () => {
      await filterSpecs(id);
      resolveTtr();
    });
  });

  stockDisplay.addEventListener("change", (event) => {
    const radio = event.target.closest?.('input[name="locationRadio"]');
    if (!radio) return;
    selectStockLocation(radio.value);
  });

  document.querySelector("form")?.addEventListener("submit", (event) => {
    if (!locationInput.value) {
      event.preventDefault();
      alert("Please select a location.");
    }
  });

  renderStockDisplay({}, "");
});
</script>

<style>
  .ttr-stock-page { flex: 1 1 auto; min-height: 0; }
  .order-highlight { display:inline-block; margin-left:8px; padding:.3rem .85rem; border:1px solid rgba(255,255,255,.5); border-radius:.35rem; background:rgba(255,255,255,.18); color:#fff; font-size:1.05rem; font-weight:600; }
  #ttr-stock-table { width:100%; flex:1 1 auto; min-height:0; border:1px solid rgba(4,74,120,.14); border-radius:8px; overflow:hidden; background:#f8f9fa; }
  #ttr-stock-table.tabulator { border-radius:inherit; overflow:hidden; }
  .inward-button { background:#f0f0f0; color:#044a78; padding:5px 14px; font-size:14px; font-weight:600; border:0; cursor:pointer; border-radius:.5rem; box-shadow:0 4px 6px -1px rgba(0,0,0,.1); }
  .inward-button:hover { background:#e4e4e4; }
  .stock-action-btn { border:0; border-radius:4px; color:#fff; cursor:pointer; padding:2px 10px; font-size:12px; background:#044a78; }
  .product-link { color:#044a78; font-weight:700; text-decoration:underline; }
  .inward-modal { z-index:10000; padding:24px; background:rgba(15,23,42,.55); backdrop-filter:blur(4px); overflow:auto; }
  .inward-dialog { width:min(1200px,96vw); max-height:90vh; margin:auto; padding:0; border:0; border-radius:14px; overflow:hidden; background:#fff; box-shadow:0 25px 60px -12px rgba(0,0,0,.4); }
  #inwardForm { display:grid !important; width:100%; max-height:90vh; margin:0; padding:18px 22px 22px; overflow-y:auto; border:0; border-radius:0; box-sizing:border-box; scrollbar-width:thin; scrollbar-color:#044a78 #f0f2f5; }
  #inwardForm::-webkit-scrollbar { width:10px; } #inwardForm::-webkit-scrollbar-track { background:#f0f2f5; } #inwardForm::-webkit-scrollbar-thumb { background:#044a78; border:2px solid #fff; border-radius:6px; }
  #inwardForm .dialog-heading { grid-column:span 32; align-items:center; padding:14px 18px; border:0; border-radius:8px; background:linear-gradient(135deg,#044a78,#03365a); color:#fff; }
  #inwardForm .dialog-heading h1 { margin:0; color:#fff; font-size:21px; }
  .dialog-close { width:34px; height:34px; padding:0; border:0; border-radius:8px; background:transparent; color:#fff; font-size:16px; cursor:pointer; } .dialog-close:hover { background:rgba(255,255,255,.18); }
  #inwardForm #stock-display { grid-column:span 32; padding:12px 14px !important; border-color:#cbdce7 !important; background:#f5f9fc !important; overflow-x:auto !important; }
  #inwardForm .form-subheading { grid-column:span 32; padding:10px 14px; }
  #inwardForm .form-subheading h1 { font-size:16px; }
  #inwardForm .btn-grp { grid-column:span 32; border:0; padding:0; }
  #inwardForm .btn-grp button { border:0; border-radius:6px; background:#044a78; color:#fff; padding:10px 16px; font-weight:700; cursor:pointer; }
  @media(max-width:700px) { .inward-modal { padding:12px; } .inward-dialog { width:100%; } }
  .location-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 5px;
    cursor: pointer;
    padding: 5px 8px;
    border-radius: 0.4rem;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    user-select: none;
  }

  .location-option:hover {
    background: #f0f0ff;
  }

  .location-option.selected {
    border-color: #044A78;
    background: #eef0ff;
  }

  .location-radio {
    accent-color: #044A78;
    width: 16px;
    height: 16px;
    cursor: pointer;
    border-radius: 999px;
  }

  .location-label {
    color: #044A78;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .location-qty {
    font-weight: 700;
    color: #044A78;
    font-size: 15px;
