<% layout('/layout/boilerplate') -%>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
  <form id="paper-stock-form" class="rottary-content" method="post" action="/fairtech/paperstock/create">

    <!-- ================= HEADER ================= -->
    <div class="span-full form-heading" style="display:flex; justify-content:space-between; flex-direction:row;">
      <h1>Paper Stock Entry</h1>
    </div>

    <!-- ================= STOCK LOCATION ================= -->
    <div class="span-full form-subheading" style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Stock Location</h1>
    </div>

    <input type="hidden" name="location" id="locationInput" />
    <div id="stock-display" class="span-full" style="display:flex; padding: 10px 15px; background: #fff; border: 1px solid #044A78; border-radius: 0.5rem; transition: all 0.3s ease; align-items: center; gap: 16px; overflow-x: auto; white-space: nowrap;"></div>

    <div class="span-full form-subheading"></div>

    <!-- ================= ROW 1: Date / Vendor / Invoice ================= -->
    <div class="span-eight">
      <label>Date</label>
      <input type="date" id="stock-date" name="date" class="form-control input-tag" required />
    </div>

    <div class="span-hexa">
      <label for="paper-vendor">Vendor Name</label>
      <select name="vendorName" id="paper-vendor" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select vendor</option>
        <% vendors?.forEach(v => { %>
          <option value="<%= v %>"><%= v %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-hexa">
      <label for="invoice-no">Invoice No</label>
      <input type="text" name="invoiceNo" id="invoice-no" class="form-control input-tag" placeholder="Enter Invoice No" required />
    </div>

    <!-- ================= ENDED PAPERS -- clicking "Add List" below locks
         whatever's currently filled in Paper Details into a row here (as a
         plain table, not a dialog) and clears Paper Details for the next
         paper. Numbering carries on across Add List clicks, so the next
         fresh block picks up as "Paper #2", "Paper #3", etc. rather than
         restarting at 1. Hidden until at least one paper has been ended.
         "End List" (submitBtn, below Paper Details) is the separate submit
         action -- it only inwards whatever's listed here; anything still
         open in Paper Details and never added is left out, filled in or not. ================= -->
    <div id="ended-papers-section" class="span-full" style="display:none;">
      <div class="form-subheading">
        <h1>Ended Papers</h1>
      </div>
      <div id="ended-papers-body" style="display:flex; flex-direction:column; gap:14px;"></div>
    </div>

    <!-- ================= PAPER DETAILS -- one paper at a time; "Add List"
         below locks it in above and opens the next one (numbering carries
         on), so there's no manual +/- for multiple simultaneous blocks. ================= -->
    <div class="span-full form-subheading" style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Paper Details</h1>
    </div>

    <div id="paper-blocks" class="span-full ps-blocks-container"></div>

    <!-- Element ids are unchanged from before this rename (endListBtn/submitBtn) --
         only the visible labels swapped. endListBtn ("Add List") locks the
         currently-open paper into the list below; submitBtn ("End List") is the
         one that actually submits and inwards whatever's in that list. -->
    <div class="span-full btn-grp" style="flex-direction: row;">
      <button type="button" id="endListBtn" class="ps-action-disabled">Add List</button>
      <button type="submit" id="submitBtn" class="ps-action-disabled">End List</button>
    </div>

  </form>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const locationInput = document.getElementById("locationInput");
  const stockDisplay = document.getElementById("stock-display");
  const allLocations = <%- safeJson(locations || []) %>;
  const stockDateInput = document.getElementById("stock-date");

  if (stockDateInput) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");
    stockDateInput.value = `${yyyy}-${mm}-${dd}`;
  }

  const submitBtn = document.getElementById("submitBtn");
  const endListBtn = document.getElementById("endListBtn");
  const vendorSelect = document.getElementById("paper-vendor");
  const invoiceNoInput = document.getElementById("invoice-no");

  // Vendor Name is the one shared field across every paper on this invoice --
  // no free-typing a spec that doesn't already exist.
  const vendorChoices = new Choices(vendorSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

  const initialOptions = {
    vendorName: <%- safeJson(vendors || []) %>,
    prodCode: <%- safeJson(prodCodes || []) %>,
    family: <%- safeJson(families || []) %>,
  };

  // Rebuilds a Choices select's option list (e.g. after a smart-filter
  // narrows it), keeping/clearing the current selection as appropriate.
  function setSelectChoices(choicesInstance, values, currentValue, placeholder) {
    const list = Array.from(new Set((values || []).map(String)));
    const options = [
      { value: "", label: placeholder, disabled: true, selected: !currentValue },
      ...list.map((v) => ({ value: v, label: v, selected: v === currentValue })),
    ];
    choicesInstance.clearStore();
    choicesInstance.setChoices(options, "value", "label", true);
  }

  function applyFilteredChoices(select, choicesInstance, rawValues, placeholder) {
    const values = Array.from(new Set((rawValues || []).map(String)));
    const currentValue = select.value || "";
    let selectedValue = currentValue;
    let autoSelected = false;

    if (!currentValue && values.length === 1) {
      selectedValue = values[0];
      autoSelected = true;
    }

    setSelectChoices(choicesInstance, values, selectedValue, placeholder);
    return autoSelected;
  }

  /* ================= LOCATION / STOCK DISPLAY (shared for the whole
     invoice -- driven off the first paper block) ================= */
  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function selectStockLocation(locationName) {
    const normalizedLocation = normalizeLocationName(locationName);
    const radio = stockDisplay?.querySelector(`input[name="locationRadio"][value="${normalizedLocation}"]`);

    stockDisplay?.querySelectorAll(".location-option").forEach((option) => {
      option.classList.remove("selected");
    });

    if (!normalizedLocation || !radio) {
      locationInput.value = "";
      updateSubmitState();
      return false;
    }

    radio.checked = true;
    const row = radio.closest(".location-option");
    if (row) row.classList.add("selected");
    locationInput.value = normalizedLocation;
    updateSubmitState();
    return true;
  }

  function renderStockDisplay({ totalStock = "-", balance = "-", locations = [] } = {}, selectedLocation = "") {
    const locationRows = (locations.length ? locations : allLocations.map((loc) => ({ location: loc }))).map((loc) => {
      const locationName = normalizeLocationName(loc.location);
      const qty = loc.qty ?? loc.balance ?? "-";
      const isSelected = selectedLocation && locationName === selectedLocation;

      return `<label class="location-option${isSelected ? " selected" : ""}" data-location="${locationName}" data-qty="${qty}" data-balance="${loc.balance ?? qty}">
        <input type="radio" name="locationRadio" class="location-radio" value="${locationName}" data-qty="${qty}" data-balance="${loc.balance ?? qty}" ${isSelected ? "checked" : ""} />
        <span class="location-label">${locationName}:</span>
        <span class="location-qty">${loc.balance ?? qty}</span>
      </label>`;
    }).join("");

    stockDisplay.innerHTML = `
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 22px; flex-wrap: nowrap; white-space: nowrap; width: 100%;">
        <div style="display: inline-flex; flex-wrap: nowrap; align-items: center; white-space: nowrap;">
          ${locationRows}
        </div>
        <div id="stock-stats" style="display: inline-flex; gap: 14px; align-items: center; flex-wrap: nowrap; white-space: nowrap;">
          <div style="font-weight: 700; color: #044A78; font-size: 16px;">
            <i class="fa-solid fa-box-open"></i> Total: <span id="stat-total">${totalStock}</span>
          </div>
        </div>
      </div>
    `;
    stockDisplay.style.display = "flex";

    stockDisplay.querySelectorAll('input[name="locationRadio"]').forEach((radio) => {
      radio.addEventListener("change", () => {
        selectStockLocation(radio.value);
      });
    });
  }

  async function updateStockDisplay() {
    const firstBlock = blocks[0];
    if (!firstBlock || !firstBlock.resolvedPaperId.value) {
      renderStockDisplay({}, normalizeLocationName(locationInput.value || ""));
      return;
    }

    try {
      const res = await fetch(`/fairtech/paperstock/stock-info/${firstBlock.resolvedPaperId.value}`);
      const data = await res.json();
      const locations = Array.isArray(data?.locations) ? data.locations : [];
      const preferredLocation = normalizeLocationName(locationInput.value || "");
      const hasPreferred = preferredLocation && locations.some((loc) => normalizeLocationName(loc.location) === preferredLocation);
      const selectedLocation = hasPreferred ? preferredLocation : normalizeLocationName(locations[0]?.location || "");
      renderStockDisplay(data, selectedLocation);
      if (selectedLocation) {
        selectStockLocation(selectedLocation);
      } else {
        locationInput.value = "";
        updateSubmitState();
      }
    } catch (err) {
      console.error("Failed to load stock display", err);
      renderStockDisplay({}, normalizeLocationName(locationInput.value || ""));
    }
  }

  /* ================= PAPER BLOCKS (dynamic, one per paper on this invoice) =========
     Each block owns its own Family/Prod Code/Rate/Paper ID/Paper Size/No of
     Rolls + Rolls table. Vendor Name is shared (Row 1), so choosing it
     re-filters every block's Family/Prod Code options. Blocks are only ever
     added/removed at the end, so a block's index never changes while it's
     still on the page -- that's what lets each roll row's hidden
     rollBlockIndex stay valid without renumbering. */
  const paperBlocksContainer = document.getElementById("paper-blocks");
  let blocks = [];
  // Papers already locked in via "End List" -- plain data, no longer live DOM
  // fields. { family, prodCode, rate, paperSize, paperId, paperProductId,
  // rolls: [{ vendorRollId, paperMtrs }] }
  let endedPapers = [];
  // Set while a specific ended paper is loaded back into Paper Details for
  // editing (its original position in endedPapers) -- without this, the
  // live block's label was always computed as "next in queue after however
  // many are still ended", so editing "Paper #1" out of a list of 2 would
  // show "Paper #2" in Paper Details (that paper's data was still correct,
  // just mislabeled) once the other one shifted down to fill its spot.
  // Reset to null once the edit is either ended again (back into its
  // original slot, not appended) or abandoned via the Reset button.
  let editingOriginalIndex = null;

  // The one number Paper Details' single block shows -- pinned to the
  // paper's original spot while editing it, otherwise just "next in queue".
  function currentBlockLabelNumber() {
    return editingOriginalIndex !== null ? editingOriginalIndex + 1 : endedPapers.length + 1;
  }

  // None of these carry the native `required` attribute -- Paper Details is
  // never submitted directly (only Add List's blockComplete()/
  // blockRollsComplete() checks below gate moving it into the list), so a
  // required attribute here would make the browser's own validation block
  // clicking End List over an open paper nobody meant to submit.
  function paperBlockMarkup() {
    const familyOptions = initialOptions.family.map((f) => `<option value="${f}">${f}</option>`).join("");
    const prodCodeOptions = initialOptions.prodCode.map((p) => `<option value="${p}">${p}</option>`).join("");
    return `
      <div class="span-six">
        <label>Family</label>
        <select class="form-control select-tag paper-family">
          <option value="" disabled selected hidden>Select family</option>
          ${familyOptions}
        </select>
      </div>

      <div class="span-six">
        <label>Paper ID</label>
        <input type="text" class="form-control input-tag resolved-paper" placeholder="ID will appear here" readonly />
      </div>

      <div class="span-six">
        <label>Prod Code</label>
        <select class="form-control select-tag paper-prod-code">
          <option value="" disabled selected hidden>Select prod code</option>
          ${prodCodeOptions}
        </select>
      </div>

      <div class="span-four">
        <label>Rate</label>
        <input type="text" class="form-control input-tag paper-rate" inputmode="decimal" placeholder="Enter Rate" autocomplete="off" />
      </div>

      <div class="span-six">
        <label>Paper Size</label>
        <input type="number" step="any" class="form-control input-tag paper-size" min="0" placeholder="Enter Paper Size" />
      </div>

      <div class="span-four">
        <label>No of Rolls</label>
        <input type="number" step="1" min="1" max="200" class="form-control input-tag no-of-rolls" value="1" />
      </div>

      <div class="span-full form-subheading">
        <h1>Rolls</h1>
      </div>

      <div class="span-full">
        <table class="ps-roll-table">
          <thead>
            <tr>
              <th style="width:44px; text-align:center;">#</th>
              <th style="width:260px;">Vendor Roll ID</th>
              <th>Running Mtrs</th>
            </tr>
          </thead>
          <tbody class="rolls-table-body"></tbody>
        </table>
      </div>
    `;
  }

  function createRollRow(blockIndex) {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td style="text-align:center;" data-label="#"></td>
      <td data-label="Vendor Roll ID">
        <input type="text" name="vendorRollId" class="form-control" placeholder="As written on the roll" />
        <input type="hidden" name="rollBlockIndex" value="${blockIndex}" />
      </td>
      <td data-label="Running Mtrs"><input type="number" name="paperMtrs" class="form-control ps-mtrs-input" min="0" step="any" placeholder="Enter Mtrs" /></td>
    `;
    return tr;
  }

  function renumberRolls(rollsBody) {
    Array.from(rollsBody.rows).forEach((row, i) => { row.cells[0].textContent = i + 1; });
  }

  // The trailing block Add List always leaves behind is expected to be
  // empty most of the time, so it's excluded here rather than treated as an
  // incomplete-and-blocking paper -- only a block someone actually started
  // typing into (and hasn't finished) should hold up Add List.
  // Date / Vendor / Invoice No / Stock Location are the shared header fields --
  // nothing below them (Paper Details, Add List, End List) makes sense
  // until all four are filled in.
  function headerFieldsOk() {
    return (
      !!stockDateInput.value &&
      !!vendorSelect.value.trim() &&
      !!invoiceNoInput.value.trim() &&
      !!locationInput.value
    );
  }

  // Shared by the Add List click handler and the submit handler -- toasts a
  // single generic message and returns false if any header field is still
  // missing, or returns true once all four are filled.
  function validateHeaderFields() {
    if (!stockDateInput.value || !vendorSelect.value.trim() || !invoiceNoInput.value.trim() || !locationInput.value) {
      if (window.showToast) window.showToast("Enter all fields", true);
      return false;
    }
    return true;
  }

  // Buttons are styled as disabled via a class rather than the native
  // `disabled` attribute -- a disabled button never receives a click event,
  // which would silently swallow the click instead of telling the operator
  // what's still missing (see the toasts in endCurrentPapers and the submit
  // handler below, which run this same check on click).
  function setActionDisabled(btn, isDisabled) {
    btn.classList.toggle("ps-action-disabled", isDisabled);
    btn.setAttribute("aria-disabled", String(isDisabled));
  }

  function updateSubmitState() {
    const headerOk = headerFieldsOk();

    // "Add List" (element id endListBtn -- kept from before the rename, see
    // the button markup below) locks the currently-open paper into the list,
    // so it only makes sense once that paper (Family/Prod Code/Rate/Paper
    // Size/every roll row) is complete.
    const currentPaperComplete = blocks.some((b) => !blockIsEmpty(b) && blockComplete(b));
    setActionDisabled(endListBtn, !(headerOk && currentPaperComplete));

    // "End List" (element id submitBtn) is the actual submit -- only papers
    // already added to the list are ever inwarded (see the submit handler
    // below), so this only needs the list to be non-empty; whatever's still
    // open and unlisted in Paper Details doesn't factor in.
    setActionDisabled(submitBtn, !(headerOk && endedPapers.length > 0));
  }

  function blockRollsComplete(block) {
    const rows = Array.from(block.rollsBody.rows);
    if (!rows.length) return false;
    return rows.every((row) => {
      const vendorRollId = row.querySelector('input[name="vendorRollId"]')?.value.trim();
      const paperMtrs = row.querySelector('input[name="paperMtrs"]')?.value.trim();
      return !!vendorRollId && !!paperMtrs;
    });
  }

  // Every field on an already-open paper (Family, Prod Code, Rate, Paper
  // Size, No of Rolls) and every roll row it opened (Vendor Roll ID, Running
  // Mtrs) has to be filled in before another paper can be added -- otherwise
  // it's easy to leave a half-filled block behind while starting a new one.
  function blockComplete(block) {
    const noOfRolls = Number(block.noOfRollsInput.value);
    return (
      !!block.familySelect.value.trim() &&
      !!block.prodCodeSelect.value.trim() &&
      !!block.rateInput.value.trim() &&
      !!block.paperSizeInput.value.trim() &&
      Number.isFinite(noOfRolls) && noOfRolls > 0 &&
      blockRollsComplete(block)
    );
  }

  // A block nobody has touched yet (the fresh one End List always leaves
  // behind) -- safe to silently ignore rather than treat as an error.
  function blockIsEmpty(block) {
    const rows = Array.from(block.rollsBody.rows);
    const rowsEmpty = rows.every((row) => {
      const vendorRollId = row.querySelector('input[name="vendorRollId"]')?.value.trim();
      const paperMtrs = row.querySelector('input[name="paperMtrs"]')?.value.trim();
      return !vendorRollId && !paperMtrs;
    });
    return (
      !block.familySelect.value.trim() &&
      !block.prodCodeSelect.value.trim() &&
      !block.rateInput.value.trim() &&
      !block.paperSizeInput.value.trim() &&
      rowsEmpty
    );
  }

  // Renumbers every still-open block's label after endedPapers changes size
  // (End List locks one in, or a locked-in one gets removed) -- keeps the
  // numbering one continuous run instead of resetting to "Paper #1" each time.
  function relabelBlocks() {
    blocks.forEach((b) => {
      if (b.labelTextEl) b.labelTextEl.textContent = `Paper #${currentBlockLabelNumber()}`;
    });
  }

  function addBlock() {
    const index = blocks.length;
    const el = document.createElement("div");
    el.className = "ps-paper-block";
    el.dataset.blockIndex = String(index);
    // The Reset button clears every paper block back to a single blank one
    // (see resetBlocksToOne below), so it only needs to appear once -- on the
    // first block's own label row, same red styling as the app's other reset
    // buttons, rather than in the shared Paper Details bar above. Numbering
    // continues past whatever's already been Ended (or, mid-edit, is pinned
    // to that paper's original spot -- see currentBlockLabelNumber).
    const labelHtml = `
      <div class="ps-block-label ps-block-label-with-reset">
        <span class="ps-block-label-text">Paper #${currentBlockLabelNumber()}</span>
        ${index === 0 ? '<button type="button" class="ps-reset-btn" title="Reset paper fields">Reset</button>' : ""}
      </div>
    `;
    el.innerHTML = `${labelHtml}${paperBlockMarkup()}`;
    paperBlocksContainer.appendChild(el);

    if (index === 0) {
      const resetBtn = el.querySelector(".ps-reset-btn");
      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          // Reset means discard whatever's in this block -- if it was an
          // ended paper pulled out for editing, its reserved slot goes too
          // rather than leaving a stale index around for the next End List.
          editingOriginalIndex = null;
          resetBlocksToOne();
        });
      }
    }

    const labelTextEl = el.querySelector(".ps-block-label-text");
    const familySelect = el.querySelector(".paper-family");
    const prodCodeSelect = el.querySelector(".paper-prod-code");
    const rateInput = el.querySelector(".paper-rate");
    const resolvedPaper = el.querySelector(".resolved-paper");
    const paperSizeInput = el.querySelector(".paper-size");
    const noOfRollsInput = el.querySelector(".no-of-rolls");
    const rollsBody = el.querySelector(".rolls-table-body");

    // paperId/family/prodCode/rate/paperSize are posted as plain repeated
    // field names (same convention as vendorRollId/paperMtrs below) so the
    // server sees one array entry per block, in DOM order.
    familySelect.name = "family";
    prodCodeSelect.name = "prodCode";
    rateInput.name = "rate";
    paperSizeInput.name = "paperSize";
    const resolvedPaperId = document.createElement("input");
    resolvedPaperId.type = "hidden";
    resolvedPaperId.name = "paperId";
    resolvedPaper.insertAdjacentElement("afterend", resolvedPaperId);

    const familyChoices = new Choices(familySelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    const prodCodeChoices = new Choices(prodCodeSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    const block = {
      index, el, labelTextEl, familySelect, prodCodeSelect, rateInput, resolvedPaper, resolvedPaperId,
      paperSizeInput, noOfRollsInput, rollsBody, familyChoices, prodCodeChoices, previewPaperId: "",
    };

    async function loadBlockPreviewId() {
      try {
        const res = await fetch("/fairtech/paperstock/preview-id");
        const data = await res.json();
        block.previewPaperId = data.paperProductId || "";
      } catch (err) {
        console.error("Preview id error:", err);
      }
      if (!resolvedPaperId.value) resolvedPaper.value = block.previewPaperId;
    }
    loadBlockPreviewId();

    function setRollCount(count) {
      const n = Math.max(1, Math.min(200, Math.floor(Number(count) || 1)));

      const existing = Array.from(rollsBody.rows).map((row) => ({
        vendorRollId: row.querySelector('input[name="vendorRollId"]')?.value || "",
        paperMtrs: row.querySelector('input[name="paperMtrs"]')?.value || "",
      }));

      rollsBody.innerHTML = "";
      for (let i = 0; i < n; i++) {
        const row = createRollRow(block.index);
        if (existing[i]) {
          row.querySelector('input[name="vendorRollId"]').value = existing[i].vendorRollId;
          row.querySelector('input[name="paperMtrs"]').value = existing[i].paperMtrs;
        }
        rollsBody.appendChild(row);
      }
      renumberRolls(rollsBody);
      updateSubmitState();
    }
    block.setRollCount = setRollCount;

    // Delegated (rows are rebuilt wholesale by setRollCount) so every roll
    // row's Vendor Roll ID / Running Mtrs keeps End List and Inward Stock's
    // enabled state current as it's typed, not just when a row is added.
    rollsBody.addEventListener("input", () => updateSubmitState());

    setRollCount(1);
    // Selects the existing value on focus/click so typing a new count
    // overwrites it instead of appending to it.
    noOfRollsInput.addEventListener("focus", () => noOfRollsInput.select());
    noOfRollsInput.addEventListener("input", () => setRollCount(noOfRollsInput.value));
    // Rows are rebuilt live on every keystroke, but the input's own displayed
    // value is only clamped/defaulted once the operator leaves the field --
    // otherwise clearing "1" to type "12" would snap back to "1" immediately
    // (Number("") is falsy) and backspace would never work.
    noOfRollsInput.addEventListener("blur", () => {
      noOfRollsInput.value = Math.max(1, Math.min(200, Math.floor(Number(noOfRollsInput.value) || 1)));
    });

    paperSizeInput.addEventListener("input", () => updateSubmitState());

    async function filterBlockSpecs(changedField) {
      const params = new URLSearchParams();
      if (vendorSelect.value) params.set("vendorName", vendorSelect.value);
      if (prodCodeSelect.value) params.set("prodCode", prodCodeSelect.value);
      if (familySelect.value) params.set("family", familySelect.value);

      try {
        const res = await fetch(`/fairtech/paperstock/filter-specs?${params}`);
        const data = await res.json();
        if (!data) return;

        const autoSelected = [];
        if (changedField !== "prodCode" && applyFilteredChoices(prodCodeSelect, prodCodeChoices, data.prodCodes, "Select prod code")) {
          autoSelected.push("prodCode");
        }
        if (changedField !== "family" && applyFilteredChoices(familySelect, familyChoices, data.families, "Select family")) {
          autoSelected.push("family");
        }

        if (autoSelected.length > 0) {
          await filterBlockSpecs(autoSelected[0]);
          resolveBlockPaper();
        }
      } catch (err) {
        console.error("Filter specs error:", err);
      }
    }
    block.filterSpecs = filterBlockSpecs;

    async function resolveBlockPaper() {
      const vendorName = vendorSelect.value.trim();
      const prodCode = prodCodeSelect.value.trim();
      const family = familySelect.value.trim();

      if (!vendorName || !prodCode || !family) {
        resolvedPaper.value = block.previewPaperId;
        resolvedPaperId.value = "";
        updateSubmitState();
        return;
      }

      const res = await fetch("/fairtech/paperstock/resolve", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ vendorName, prodCode, family }),
      });
      const data = await res.json();

      if (!data.found) {
        resolvedPaperId.value = "";
        if (block.index === 0) {
          locationInput.value = "";
          renderStockDisplay({}, "");
        }
        updateSubmitState();

        try {
          const previewRes = await fetch("/fairtech/paperstock/preview-id");
          const previewData = await previewRes.json();
          block.previewPaperId = previewData.paperProductId || block.previewPaperId;
        } catch (err) {
          console.error("Preview id error:", err);
        }
        resolvedPaper.value = block.previewPaperId;
        return;
      }

      resolvedPaper.value = data.paperProductId;
      resolvedPaperId.value = data.paperId;
      updateSubmitState();

      if (!rateInput.dataset.userEdited && data.rate != null) rateInput.value = data.rate;

      if (block.index === 0) await updateStockDisplay();
    }
    block.resolvePaper = resolveBlockPaper;

    familySelect.addEventListener("change", async () => {
      familySelect.dataset.userEdited = "true";
      await filterBlockSpecs("family");
      resolveBlockPaper();
    });
    prodCodeSelect.addEventListener("change", async () => {
      await filterBlockSpecs("prodCode");
      resolveBlockPaper();
    });
    rateInput.addEventListener("input", () => {
      rateInput.dataset.userEdited = "true";
      updateSubmitState();
    });

    blocks.push(block);
    updateSubmitState();
    return block;
  }

  function destroyBlock(block) {
    block.familyChoices.destroy();
    block.prodCodeChoices.destroy();
    block.el.remove();
  }

  // Clears every paper block back to a single blank one -- the quickest way
  // to undo whatever Family/Prod Code/Rate/Paper Size/Rolls got filled in
  // (including the Choices.js selections, which a plain form reset wouldn't
  // touch) without reloading the page and losing Date/Vendor/Invoice/Location.
  function resetBlocksToOne() {
    blocks.forEach((b) => destroyBlock(b));
    blocks = [];
    addBlock();
    updateStockDisplay();
  }

  addBlock();

  vendorSelect.addEventListener("change", async () => {
    for (const block of blocks) {
      await block.filterSpecs("vendorName");
      await block.resolvePaper();
    }
    updateSubmitState();
  });

  stockDateInput.addEventListener("input", updateSubmitState);
  invoiceNoInput.addEventListener("input", updateSubmitState);

  renderStockDisplay({}, "");

  /* ================= ADD LIST (button label "Add List", element id
     endListBtn -- unchanged since before the label was renamed) =================
     Locks whatever's currently filled in Paper Details into a plain table row
     in the "Ended Papers" section above, then clears Paper Details for the
     next one (numbering carries on). Nothing is saved to the server here --
     endedPapers is just held in memory until "End List" (submitBtn) actually
     submits it; whatever's still open in Paper Details at that point is left
     out of the submission entirely, complete or not. */
  const endedPapersSection = document.getElementById("ended-papers-section");
  const endedPapersBody = document.getElementById("ended-papers-body");

  async function fetchRollIdPreviews(prodCode, count) {
    if (!prodCode || !count) return [];
    try {
      const res = await fetch(`/fairtech/paperstock/preview-roll-ids?prodCode=${encodeURIComponent(prodCode)}&count=${count}`);
      const data = await res.json();
      return Array.isArray(data?.rollIds) ? data.rollIds : [];
    } catch (err) {
      console.error("Preview roll ids error:", err);
      return [];
    }
  }

  // Roll ids are previewed (not yet reserved), so two ended papers sharing a
  // Prod Code can't each naively preview "starting from the same next id" --
  // this hands out one continuous, non-overlapping run per Prod Code across
  // the whole ended list, in the same order they'll actually be created in.
  async function computeRollIdPreviewsForPapers(papers) {
    const totalsByProdCode = new Map();
    papers.forEach((p) => totalsByProdCode.set(p.prodCode, (totalsByProdCode.get(p.prodCode) || 0) + p.rolls.length));

    const idsByProdCode = new Map();
    for (const [prodCode, count] of totalsByProdCode) {
      idsByProdCode.set(prodCode, await fetchRollIdPreviews(prodCode, count));
    }

    const cursorByProdCode = new Map();
    return papers.map((p) => {
      const cursor = cursorByProdCode.get(p.prodCode) || 0;
      const ids = idsByProdCode.get(p.prodCode) || [];
      cursorByProdCode.set(p.prodCode, cursor + p.rolls.length);
      return ids.slice(cursor, cursor + p.rolls.length);
    });
  }

  async function renderEndedPapersSection() {
    if (!endedPapers.length) {
      endedPapersSection.style.display = "none";
      endedPapersBody.innerHTML = "";
      return;
    }
    endedPapersSection.style.display = "";

    const previewsByPaper = await computeRollIdPreviewsForPapers(endedPapers);

    endedPapersBody.innerHTML = endedPapers.map((paper, i) => {
      const rollIds = previewsByPaper[i];
      const rowsHtml = paper.rolls.map((roll, ri) => `
        <tr>
          <td style="text-align:center;">${ri + 1}</td>
          <td><strong>${rollIds[ri] || "—"}</strong></td>
          <td>${roll.vendorRollId}</td>
          <td>${paper.paperSize}</td>
          <td>${Number(roll.paperMtrs || 0).toLocaleString("en-IN")}</td>
        </tr>
      `).join("");

      return `
        <div class="psb-card psb-paper-card">
          <div class="psb-paper-head">
            <div class="psb-paper-title">
              <span class="psb-paper-index">Paper #${i + 1}</span>
              <strong class="psb-paper-id">${paper.paperProductId || "—"}</strong>
              <span class="psb-paper-meta">${paper.prodCode}${paper.family ? ` · ${paper.family}` : ""}</span>
            </div>
            <div style="display:flex; gap:8px;">
              <button type="button" class="psb-btn ps-ended-edit" data-index="${i}" title="Edit this paper">
                <i class="fa-solid fa-pen"></i> Edit
              </button>
              <button type="button" class="psb-btn ps-ended-remove" data-index="${i}" title="Remove this paper">
                <i class="fa-solid fa-trash"></i> Remove
              </button>
            </div>
          </div>
          <div class="psb-table-wrap">
            <table class="psb-table">
              <thead>
                <tr>
                  <th style="width:44px; text-align:center;">#</th>
                  <th>Roll ID</th>
                  <th>Vendor Roll ID</th>
                  <th>Size</th>
                  <th>Running Mtrs</th>
                </tr>
              </thead>
              <tbody>${rowsHtml}</tbody>
            </table>
          </div>
        </div>
      `;
    }).join("");

    endedPapersBody.querySelectorAll(".ps-ended-remove").forEach((btn) => {
      btn.addEventListener("click", async () => {
        endedPapers.splice(Number(btn.dataset.index), 1);
        relabelBlocks();
        updateSubmitState();
        await renderEndedPapersSection();
      });
    });

    endedPapersBody.querySelectorAll(".ps-ended-edit").forEach((btn) => {
      btn.addEventListener("click", () => editEndedPaper(Number(btn.dataset.index)));
    });
  }

  // Pulls an ended paper back out of the list and into Paper Details --
  // Paper Details only ever holds one paper at a time, so this replaces
  // whatever's currently open there (rather than adding a second block
  // alongside it) with this one, exactly as it was when it was ended.
  async function editEndedPaper(index) {
    const paper = endedPapers[index];
    if (!paper) return;
    endedPapers.splice(index, 1);
    // Pin the label to this paper's original spot (set before
    // resetBlocksToOne/addBlock so the block is created with the right
    // number right away) -- otherwise Paper Details would show "next in
    // queue after whatever's still ended", which after this splice is a
    // different, smaller number than the one on the card just clicked.
    editingOriginalIndex = index;
    // Update the Ended Papers table right away -- the rest of this function
    // is a chain of awaited network calls to repopulate Paper Details, and
    // the other ended papers (renumbered, with this one gone) shouldn't have
    // to wait for that to finish before showing.
    await renderEndedPapersSection();

    resetBlocksToOne();
    const block = blocks[0];

    block.rateInput.dataset.userEdited = "true";
    block.familySelect.value = paper.family;
    block.familyChoices.setChoiceByValue(paper.family);
    block.prodCodeSelect.value = paper.prodCode;
    block.prodCodeChoices.setChoiceByValue(paper.prodCode);

    await block.filterSpecs("prodCode");
    await block.resolvePaper();

    block.rateInput.value = paper.rate;
    block.paperSizeInput.value = paper.paperSize;
    block.resolvedPaperId.value = paper.paperId || "";
    if (paper.paperProductId) block.resolvedPaper.value = paper.paperProductId;

    block.setRollCount(paper.rolls.length || 1);
    const rows = Array.from(block.rollsBody.rows);
    paper.rolls.forEach((roll, ri) => {
      if (!rows[ri]) return;
      rows[ri].querySelector('input[name="vendorRollId"]').value = roll.vendorRollId;
      rows[ri].querySelector('input[name="paperMtrs"]').value = roll.paperMtrs;
    });

    relabelBlocks();
    updateSubmitState();
  }

  async function endCurrentPapers() {
    if (!validateHeaderFields()) return;

    const toEnd = blocks.filter((b) => !blockIsEmpty(b));

    if (!toEnd.length) {
      if (window.showToast) window.showToast("Enter all fields", true);
      return;
    }
    if (toEnd.some((b) => !blockComplete(b))) {
      if (window.showToast) window.showToast("Enter all fields", true);
      return;
    }

    toEnd.forEach((block) => {
      const data = {
        family: block.familySelect.value.trim(),
        prodCode: block.prodCodeSelect.value.trim(),
        rate: block.rateInput.value.trim(),
        paperSize: block.paperSizeInput.value.trim(),
        paperId: block.resolvedPaperId.value,
        paperProductId: block.resolvedPaper.value,
        rolls: Array.from(block.rollsBody.rows).map((row) => ({
          vendorRollId: row.querySelector('input[name="vendorRollId"]')?.value || "",
          paperMtrs: row.querySelector('input[name="paperMtrs"]')?.value || "",
        })),
      };
      // Ending a paper that was pulled out for editing puts it back in its
      // original spot rather than appending it -- otherwise every edited
      // paper would drift to the end of the list and bump everything after
      // it down a number.
      if (editingOriginalIndex !== null) {
        endedPapers.splice(editingOriginalIndex, 0, data);
      } else {
        endedPapers.push(data);
      }
    });
    editingOriginalIndex = null;

    resetBlocksToOne();
    updateSubmitState();
    await renderEndedPapersSection();
    if (window.showToast) window.showToast("Paper added to list", "success");
  }

  if (endListBtn) endListBtn.addEventListener("click", () => endCurrentPapers());

  /* ================= SUBMIT =================
     Only papers already added to the list (endedPapers) are ever inwarded --
     whatever's still open in Paper Details is left exactly as it is, not
     silently swept in and not discarded, so an operator who forgets to add
     it before submitting doesn't lose it either way. endedPapers no longer
     exist as DOM fields, so the payload is built by hand (not new
     FormData(form)): shared fields first, then every ended paper, each
     getting the next sequential rollBlockIndex, in the same order the server
     will actually create them. */
  const paperStockForm = document.getElementById("paper-stock-form");
  let paperStockSubmitting = false;

  paperStockForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (paperStockSubmitting) return;

    if (!validateHeaderFields()) return;

    if (!endedPapers.length) {
      if (window.showToast) window.showToast("Enter all fields", true);
      return;
    }

    const params = new URLSearchParams();
    params.set("date", stockDateInput.value);
    params.set("vendorName", vendorSelect.value.trim());
    params.set("invoiceNo", invoiceNoInput.value.trim());
    params.set("location", locationInput.value);

    let paperIndex = 0;
    function appendPaper(family, prodCode, rate, paperSize, paperId, rolls) {
      params.append("family", family);
      params.append("prodCode", prodCode);
      params.append("rate", rate);
      params.append("paperSize", paperSize);
      params.append("paperId", paperId || "");
      rolls.forEach((roll) => {
        params.append("vendorRollId", roll.vendorRollId);
        params.append("paperMtrs", roll.paperMtrs);
        params.append("rollBlockIndex", String(paperIndex));
      });
      paperIndex += 1;
    }

    endedPapers.forEach((p) => appendPaper(p.family, p.prodCode, p.rate, p.paperSize, p.paperId, p.rolls));

    paperStockSubmitting = true;
    submitBtn.disabled = true;

    try {
      const res = await fetch(paperStockForm.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: params,
      });
      const data = await res.json();
      if (!res.ok || !data?.success) {
        if (window.showToast) window.showToast(data?.message || "Failed to add paper stock", true);
        paperStockSubmitting = false;
        submitBtn.disabled = false;
        return;
      }
      window.location.href = data.redirect || "/fairtech/paperstock";
    } catch (err) {
      console.error(err);
      if (window.showToast) window.showToast("Failed to add paper stock", true);
      paperStockSubmitting = false;
      submitBtn.disabled = false;
    }
  });
});
</script>

