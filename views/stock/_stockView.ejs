ric-fields{grid-template-columns:1fr;padding:0 14px 18px}.generic-field.remarks{grid-column:span 1}.stock-display,.spec-bar{margin-left:14px;margin-right:14px}.stock-display{align-items:flex-start;flex-direction:column}.stock-totals{flex-wrap:wrap}}
 .generic-form .choices{width:100%;margin:0}.generic-form .choices__inner{min-height:42px;padding:7px 34px 7px 11px;border:1px solid #b9cad6;border-radius:7px;background:#fff;color:#244761;line-height:25px;transition:border-color .15s ease,box-shadow .15s ease}.generic-form .choices.is-focused .choices__inner,.generic-form .choices.is-open .choices__inner{border-color:#044a78;box-shadow:0 0 0 3px rgba(4,74,120,.12)}.generic-form .choices__list--dropdown{z-index:10002;width:100%;max-width:100%;max-height:260px;overflow:hidden;border:1px solid #b9cad6;border-radius:8px;box-shadow:0 10px 24px rgba(15,48,75,.16)}.generic-form .choices__list--dropdown .choices__list{max-height:205px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:#044a78 #f0f2f5}.generic-form .choices__list--dropdown .choices__item--choice{padding:9px 11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.generic-form .choices__list--dropdown .choices__item--choice.is-highlighted{background:#e8f2f8;color:#044a78}.generic-form .generic-field label{letter-spacing:.01em}.generic-form .generic-field input::placeholder{color:#9aa9b5}.generic-form footer button{transition:background .15s ease,transform .15s ease,box-shadow .15s ease}.generic-form footer button:hover{transform:translateY(-1px)}.generic-form footer button[type=submit]:hover{background:#03365a;box-shadow:0 4px 10px rgba(4,74,120,.18)}.generic-form footer button[type=button]:hover{background:#e8eef2}.generic-form footer button:focus-visible{outline:2px solid #044a78;outline-offset:2px}@media(min-width:861px){.generic-modal{overflow:visible}.generic-dialog{max-height:none;overflow:visible}.generic-form{max-height:none;overflow:visible}}
/* final alignment and surface polish */
.generic-stock-page .tabulator-header-filter input::placeholder { color: #8293a3; opacity: 1; }
.generic-dialog { background: transparent !important; border: 0 !important; border-radius: 16px !important; }
.generic-form { border-radius: 16px !important; overflow-x: hidden !important; }
.generic-dialog-header { border-radius: 16px 16px 0 0; }
.generic-form footer { border-radius: 0 0 16px 16px; }
.generic-form { color: #244761; }
