<% layout('/layout/boilerplate') -%>
<% const summary = (stockData || []).reduce((s, r) => ({ total:s.total+Number(r.total||0), booked:s.booked+Number(r.booked||0), available:s.available+Number(r.available||0) }), {total:0,booked:0,available:0}); %>
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<main class="contain generic-stock-page" style="flex-direction:column;padding:10px;gap:10px"><header class="indi-head"><h1><%= stockConfig.title %> <span class="order-highlight active">Total: <%= summary.total %></span><span class="order-highlight active">Booked: <%= summary.booked %></span><span class="order-highlight active">Available: <%= summary.available %></span></h1><button class="inward-button" id="openInwardDialog" type="button"><i class="fa-solid fa-plus"></i> Inward Stock</button></header><div id="generic-stock-table"></div></main>
<div class="logout-modal generic-modal" id="inwardDialog" aria-hidden="true"><div class="logout-dialog generic-dialog" role="dialog" aria-modal="true"><form class="generic-form" method="post" action="<%= stockConfig.createUrl %>" id="inwardForm"><header class="generic-dialog-header"><h2>Inward <%= stockConfig.shortTitle %> Stock</h2><button type="button" id="closeInwardDialog" class="dialog-close"><i class="fa-solid fa-xmark"></i></button></header><input type="hidden" name="location" id="locationInput" /><div id="stock-display" class="stock-display"></div><div class="spec-bar"><div><h3><%= stockConfig.shortTitle %> Specifications</h3><span><%= stockConfig.idLabel %>: <strong id="resolvedDisplay">—</strong></span></div><button type="button" id="resetBtn">Reset</button></div><input type="hidden" name="<%= stockConfig.idName %>" id="resolvedId" /><div class="generic-fields"><% stockConfig.fields.forEach(field => { %><div class="generic-field"><label for="<%= field.id %>"><%= field.label %></label><select name="<%= field.name %>" id="<%= field.id %>" required><option value="" selected disabled>Search</option><% (stockConfig.options[field.key] || []).forEach(v => { %><option value="<%= v %>"><%= v %></option><% }) %></select></div><% }) %><div class="generic-field"><label>Quantity</label><input type="number" name="quantity" min="1" required /></div><div class="generic-field"><label>Date</label><input type="date" name="date" id="stock-date" required /></div><div class="generic-field remarks"><label>Remarks</label><input type="text" name="remarks" placeholder="Add a note" /></div></div><footer><button type="button" id="cancelInwardDialog">Cancel</button><button type="submit" id="submitBtn" disabled>Save Inward</button></footer></form></div></div>
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded',()=>{const cfg=<%- safeJson(stockConfig) %>, rows=<%- safeJson(stockData||[]) %>, esc=v=>String(v??'-').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));new Tabulator('#generic-stock-table',{data:rows,height:'100%',initialSort:[{column:cfg.productField,dir:'asc'},{column:'location',dir:'asc'}],placeholder:'No stock has been recorded yet',columns:[srNoColumn(),{title:'',width:62,headerSort:false,formatter:c=>`<button class="stock-action-btn" onclick="window.location.href='${esc(c.getRow().getData().profileUrl)}'"><i class="fa-solid fa-eye"></i></button>`},{title:cfg.idLabel,field:cfg.productField,minWidth:160,headerFilter:'input',formatter:c=>`<a class="product-link" href="${esc(c.getRow().getData().profileUrl)}">${esc(c.getValue())}</a>`},...(()=>{const widthField=cfg.tableFields.find(f=>f.label==='Width')?.field,mtrsField=cfg.tableFields.find(f=>f.label==='MTRS')?.field;return cfg.tableFields.map(f=>{const col={title:f.label,field:f.field,minWidth:100,headerFilter:'input'};if(widthField&&mtrsField&&(f.field===widthField||f.field===mtrsField)){const other=f.field===widthField?mtrsField:widthField;col.sorter=(a,b,aRow,bRow)=>{const diff=(Number(a)||0)-(Number(b)||0);if(diff!==0)return diff;return (Number(aRow.getData()[other])||0)-(Number(bRow.getData()[other])||0)}}return col})})(),{title:'Location',field:'location',minWidth:130,headerFilter:'input'},{title:'Total',field:'total',width:95,hozAlign:'center',sorter:'number'},{title:'Booked',field:'booked',width:95,hozAlign:'center',sorter:'number'},{title:'Available',field:'available',width:100,hozAlign:'center',sorter:'number'}]});const modal=document.getElementById('inwardDialog'),close=()=>{modal.classList.remove('show');modal.setAttribute('aria-hidden','true')};openInwardDialog.onclick=()=>{modal.classList.add('show');modal.setAttribute('aria-hidden','false')};closeInwardDialog.onclick=cancelInwardDialog.onclick=close;modal.onclick=e=>{if(e.target===modal)close()};document.getElementById('stock-date').value=new Date().toISOString().slice(0,10);const loc=document.getElementById('locationInput'),display=document.getElementById('stock-display'),rid=document.getElementById('resolvedId'),rdisplay=document.getElementById('resolvedDisplay'),submit=document.getElementById('submitBtn'),fields=cfg.fields, choices={};const normal=v=>String(v||'').trim().toUpperCase();function render(data={},selected=''){const locationRows=(data.locations?.length?data.locations:cfg.locations.map(location=>({location}))).map(x=>`<label class="location-option ${normal(x.location)===selected?'selected':''}"><input type="radio" name="locationRadio" value="${normal(x.location)}" ${normal(x.location)===selected?'checked':''}><span>${normal(x.location)}</span><strong>${x.balance??x.qty??'-'}</strong></label>`).join('');display.innerHTML=`<div class="location-list">${locationRows||'No locations configured'}</div><div class="stock-totals"><span>On hand <strong>${data.totalStock??'-'}</strong></span><span>Booked <strong>${data.booked??'-'}</strong></span><span>Available <strong>${data.balance??'-'}</strong></span></div>`;display.querySelectorAll('input').forEach(r=>r.onchange=()=>{loc.value=r.value;display.querySelectorAll('.location-option').forEach(x=>x.classList.toggle('selected',x.contains(r)))})}cfg.fields.forEach(f=>{const el=document.getElementById(f.id);choices[f.id]=new Choices(el,{searchEnabled:true,shouldSort:false,itemSelectText:''});el.onchange=async()=>{const q=new URLSearchParams();fields.forEach(x=>{const v=document.getElementById(x.id).value;if(v)q.set(x.param,v)});const data=await fetch(`${cfg.filterUrl}?${q}`).then(r=>r.json());fields.forEach(x=>{if(x.id===f.id)return;const current=document.getElementById(x.id).value;choices[x.id].clearStore();choices[x.id].setChoices([{value:'',label:'Search',disabled:true,selected:!current},...(data[x.key]||[]).map(v=>({value:String(v),label:String(v),selected:String(v)===current}))],'value','label',true)});if(fields.some(x=>!document.getElementById(x.id).value))return;const payload={};fields.forEach(x=>payload[x.resolve]=document.getElementById(x.id).value);const resolved=await fetch(cfg.resolveUrl,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(r=>r.json());if(!resolved.found){rdisplay.textContent='No match';rid.value='';submit.disabled=true;return}rdisplay.textContent=resolved.productId;rid.value=resolved.id;submit.disabled=false;const stock=await fetch(`${cfg.infoUrl}/${resolved.id}`).then(r=>r.json());render(stock,normal(loc.value))}});document.getElementById('resetBtn').onclick=()=>{fields.forEach(f=>{choices[f.id].clearStore();choices[f.id].setChoices([{value:'',label:'Search',disabled:true,selected:true},...(cfg.options[f.key]||[]).map(v=>({value:String(v),label:String(v)}))],'value','label',true)});rdisplay.textContent='—';rid.value='';loc.value='';submit.disabled=true;render()};document.getElementById('inwardForm').onsubmit=e=>{if(!loc.value){e.preventDefault();alert('Select a location before saving stock.')}};render()});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const applyFilterPlaceholders = () => {
    document.querySelectorAll('#generic-stock-table .tabulator-header-filter, #generic-stock-table .tabulator-header-filter input').forEach((input) => {
      if (input.tagName === 'INPUT') {
        input.placeholder = 'Search';
        input.setAttribute('aria-label', 'Search column');
      }
    });
  };
  applyFilterPlaceholders();
  new MutationObserver(applyFilterPlaceholders).observe(document.getElementById('generic-stock-table'), { childList: true, subtree: true });
  window.setTimeout(() => {
    const table = window.Tabulator?.findTable?.('#generic-stock-table')?.[0];
    if (!table || table.__allColumnFiltersAdded) return;
    // No search box on the Sr. No. column or the field-less view-button column.
    const noFilter = (column) => !column.field || column.field === '_srNo';
    const definitions = table.getColumnDefinitions().map((column) => ({
      ...column,
      headerFilter: noFilter(column) ? false : 'input',
      headerFilterParams: noFilter(column) ? undefined : { placeholder: 'Search' },
    }));
    table.__allColumnFiltersAdded = true;
    table.setColumns(definitions);
    window.setTimeout(applyFilterPlaceholders, 0);
  }, 0);
});
</script>
<style>
