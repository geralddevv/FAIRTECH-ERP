<% layout('/layout/boilerplate') -%>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<body>
  <style>
    #master-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell {
      color: #dc2626 !important;
    }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell * {
      color: #dc2626 !important;
      text-decoration-color: #dc2626 !important;
    }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-active,
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-active * { color: #1a7f4b !important; }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-pending,
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-pending * { color: #b9770e !important; }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-inactive,
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-inactive * { color: #c0392b !important; }

    #inactive-log-btn:hover { background-color: #e4e4e4; }

    .dialog-header {
      background: #044a78; padding: 18px 22px;
      display: flex; align-items: center; justify-content: space-between;
      border-radius: 14px 14px 0 0;
    }
    .dialog-header h2 { margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff; }
    .dialog-close-btn {
      background: none; border: none; color: #fff; font-size: 20px;
      cursor: pointer; line-height: 1; padding: 0 2px; opacity: 0.8; transition: opacity 0.15s;
    }
    .dialog-close-btn:hover { opacity: 1; }
    .dialog-body {
      padding: 24px; background: #fff; border-radius: 0 0 14px 14px;
      max-height: 75vh; overflow-y: auto;
      scrollbar-width: thin; scrollbar-color: #044a78 #f1f5f9;
    }
    .dialog-body::-webkit-scrollbar { width: 6px; height: 6px; }
    .dialog-body::-webkit-scrollbar-track { background: #f1f5f9; }
    .dialog-body::-webkit-scrollbar-thumb { background: #044a78; border-radius: 10px; }
    .view-row {
      display: flex; justify-content: space-between; gap: 14px;
      padding: 7px 0; border-bottom: 1px dashed #e2e8f0; font-size: 13px;
    }
    .view-row:last-child { border-bottom: none; }
    .view-row span:first-child { color: #64748b; font-weight: 600; }
    .view-row span:last-child { color: #0f172a; font-weight: 600; text-align: right; word-break: break-word; }
    .inactive-log-card {
      border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;
    }
    .inactive-log-card:last-child { margin-bottom: 0; }
    .inactive-log-card-head {
      display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 6px;
    }
    .inactive-log-card-head h3 { margin: 0; font-size: 14px; font-weight: 700; color: #0f172a; }
    .inactive-log-empty {
      text-align: center; color: #64748b; font-size: 14px; padding: 30px 0;
    }
  </style>
  <div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
    <div class="indi-head">
      <h1>Employees</h1>
      <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
        <a
          href="/fairtech/employee/create"
          class="header-action-btn"
          style="
            height: 30px;
            padding: 0 14px;
            background: #f0f0f0;
            color: #044a78;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
          "
        >
          <i class="fa-solid fa-plus"></i>
          <span>Add Employee</span>
        </a>

        <button
          type="button"
          id="inactive-log-btn"
          class="header-action-btn"
          style="
            height: 30px;
            padding: 0 14px;
            background: #f0f0f0;
            color: #044a78;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
          "
        >
          <i class="fa-solid fa-clock-rotate-left"></i>
          <span>Inactive Log</span>
          <span
            id="inactive-log-count"
            style="
              background: #044a78;
              color: #fff;
              font-size: 11px;
              font-weight: 700;
              line-height: 1;
              padding: 3px 6px;
              border-radius: 999px;
              min-width: 16px;
              text-align: center;
            "
          >0</span>
        </button>

        <div class="download-selector" id="downloadSelector">
          <button class="download-selector__trigger" style="height: 30px; display: flex; align-items: center; padding: 0 12px; border: 1.5px solid #e2e8f0; border-radius: 6px; background: #fff; font-size: 14px; font-weight: 500; cursor: pointer;">
            <span>
              <i class="fa-solid fa-file-arrow-down"></i>
              <span class="download-typo">Download</span>
            </span>
            <i class="fas fa-chevron-down download-selector__trigger-icon" style="font-size: 12px; margin-left: 6px;"></i>
          </button>
          <div class="download-selector__menu" id="downloads">
            <span class="download-selector__option" id="download-pdf">
              <i class="fas fa-file-pdf download-selector__option-icon"></i>
              <span>PDF</span>
            </span>
            <span class="download-selector__option" id="download-xlsx">
              <i class="fas fa-file-excel download-selector__option-icon"></i>
              <span>Excel</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="table-spinner"><div class="spinner-circle"></div></div>
    <div id="master-table" class="tabulator tabulator-modern"></div>
  </div>

  <!-- ============ INACTIVE EMPLOYEE LOG ============ -->
  <div class="logout-modal" id="inactiveLogDialog" aria-hidden="true">
    <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="inactiveLogTitle"
      style="width: min(560px, 95vw); padding: 0; border-radius: 14px; border: none;">
      <div class="dialog-header">
        <h2 id="inactiveLogTitle">Inactive Employees</h2>
        <button class="dialog-close-btn" type="button" onclick="closeInactiveLogDialog()" aria-label="Close">&times;</button>
      </div>
      <div class="dialog-body" id="inactiveLogBody"></div>
    </div>
  </div>

  <!-- Tabulator JS -->
  <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

  <script>
      // ================= DOWNLOAD DROPDOWN =================

      const downloadSelector = document.getElementById("downloadSelector");
      const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");

      triggerBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        downloadSelector.classList.toggle("download-selector--active");

        const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
        icon.style.transform = downloadSelector.classList.contains("download-selector--active")
          ? "rotate(180deg)"
          : "rotate(0deg)";
      });

      document.addEventListener("click", () => {
        downloadSelector.classList.remove("download-selector--active");
        const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
        icon.style.transform = "rotate(0deg)";
      });

      downloadSelector
        .querySelector(".download-selector__menu")
        .addEventListener("click", (e) => e.stopPropagation());

      // ================= DATA =================

      const tableData = <%- safeJson(jsonData) %>;
      // Main table only ever shows active employees; inactive ones (with
      // whatever's still pending against them) live in the Inactive Log
      // dialog instead of a toggleable status filter here.
      const activeTableData = tableData.filter((e) => e.isActive !== false);
      const inactiveEmployees = tableData.filter((e) => e.isActive === false);

      function isMissingValue(value) {
        return value === null || value === undefined || String(value).trim() === "";
      }

      function formatEmployeeField(value, defaultColor = "#044A78", fontWeight = 500) {
        const missing = isMissingValue(value);
        const displayValue = missing ? "-" : value;
        const color = missing ? "#dc2626" : defaultColor;

        return `
          <span style="font-weight:${fontWeight};color:${color}">
            ${displayValue}
          </span>
        `;
      }

      // ================= TABULATOR =================

      let table;
      const requiredEmployeeFields = [
        "empId",
        "empName",
        "empDateOfJoining",
        "empType",
        "empLoc",
        "empDept",
        "empReportingManager",
        "empProfile",
        "empDob",
        "empGender",
        "empMobile1",
        "empEmergencyNo1",
        "empMartialStatus",
        "empPresentAddress",
        "empPermanentAddress",
        "empAadhaar",
        "empPan",
        "empBankName",
        "empAccountHolderName",
        "empAccNo",
        "empIfscCode",
      ];

      function hasMissingEmployeeDetails(row) {
        return requiredEmployeeFields.some((field) => isMissingValue(row?.[field]));
      }

      function initTable() {
      table = new Tabulator("#master-table", {
        data: activeTableData,
        height: "100%",
        // layout: "fitColumns",
        columnMinWidth: 120,
        resizableColumns: true,
        movableColumns: true,
        initialSort: [
          { column: "empName", dir: "asc" }
        ],
        rowFormatter: function (row) {
          const rowEl = row.getElement();
          if (hasMissingEmployeeDetails(row.getData())) {
            rowEl.classList.add("row-missing-employee-details");
          } else {
            rowEl.classList.remove("row-missing-employee-details");
          }
        },

        columns: [
          {
            // Table data is pre-filtered to active employees only (see
            // activeTableData above), so this column is always "Active" --
            // kept for visual consistency with other tables rather than a
            // togglable filter, since there's nothing left to filter by here.
            title: "Status",
            field: "isActive",
            width: 110,
            hozAlign: "center",
            formatter: function() {
              return `<span class="status-badge-active" style="background:#e7f7ee;color:#1a7f4b;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;">Active</span>`;
            }
          },
          {
            title: "Name",
            field: "empName",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              const value = cell.getValue();
              const missing = isMissingValue(value);
              return `
                <span style="font-weight:600;color:${missing ? "#dc2626" : "#044A78"};text-decoration:underline;text-decoration-color:${missing ? "#dc2626" : "#044A78"}">
                  ${missing ? "-" : value}
                </span>
              `;
            },
            cellClick: function (e, cell) {
              const data = cell.getRow().getData();
              window.location.href = `/fairtech/employee/profile/${data._id}`;
            },
          },

          {
            title: "Employee Id",
            field: "empId",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            width: 150,
            formatter: function (cell) {
              return `
                <span style="font-weight:600;font-size:14px;color:${isMissingValue(cell.getValue()) ? "#dc2626" : "#044A78"}">
                  ${isMissingValue(cell.getValue()) ? "-" : cell.getValue()}
                </span>
              `;
            }
          },
          {
            title: "Image",
            field: "empPhoto",
            width: 80,
            hozAlign: "center",
            formatter: function (cell) {
              const data = cell.getRow().getData();
              const hasPhoto = !isMissingValue(data.empPhoto);
              return `
                <i class="fa-solid fa-image"
                   style="font-size:16px;color:${hasPhoto ? '#044A78' : '#94a3b8'}">
                </i>
              `;
            },
            cellClick: function (e, cell) {
              const data = cell.getRow().getData();

              const imgSrc = data.empPhoto
                ? `/images/empimg/${data.empPhoto}`
                : `/images/empimg/${data.empGender === "FEMALE" ? "female.jpg" : "male.jpg"}`;

              openImgModal(imgSrc);
            }
          },
          {
            title: "Reporting Manager",
            field: "empReportingManager",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Office Mobile",
            field: "empOfficeMob",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Personal Mobile",
            field: "empMobile1",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Office Email",
            field: "empOfficeEmailId",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Employee Type",
            field: "empType",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Department",
            field: "empDept",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Profile",
            field: "empProfile",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Location",
            field: "empLoc",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
        ],
      });
    }

      window.addEventListener("load", initTable);

      // ================= DOWNLOAD =================

      document.getElementById("download-pdf").addEventListener("click", () => {
        if (!table) return;

        table.download("pdf", "employee-data.pdf", {
          orientation: "landscape",
          title: "Employee Data",
        });

        downloadSelector.classList.remove("download-selector--active");
      });

      document.getElementById("download-xlsx").addEventListener("click", () => {
        if (!table) return;

        table.download("xlsx", "employee-data.xlsx", {
          sheetName: "Employees",
        });

        downloadSelector.classList.remove("download-selector--active");
      });

      // ================= INACTIVE LOG =================

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

      document.getElementById("inactive-log-count").textContent = inactiveEmployees.length;

      function renderInactiveLog() {
        const body = document.getElementById("inactiveLogBody");

        if (!inactiveEmployees.length) {
          body.innerHTML = `<div class="inactive-log-empty"><i class="fa-solid fa-circle-check" style="font-size:20px;color:#1a7f4b;margin-bottom:8px;display:block;"></i>No inactive employees.</div>`;
          return;
        }

        body.innerHTML = inactiveEmployees
          .slice()
          .sort((a, b) => String(a.empName || "").localeCompare(String(b.empName || "")))
          .map((emp) => {
            const givenAssets = [emp.empAssets1, emp.empAssets2, emp.empAssets3, emp.empAssets4]
              .map((a) => (a || "").trim())
              .filter(Boolean);
            const surrendered = new Set((emp.empAssetsSurrendered || []).map((a) => (a || "").trim()).filter(Boolean));
            const pendingAssets = givenAssets.filter((a) => !surrendered.has(a));
            const hasPendingBalance = (emp.loanBalance > 0) || (emp.advanceBalance > 0);
            const isPending = pendingAssets.length > 0 || hasPendingBalance;

            const statusBadge = isPending
              ? `<span class="status-badge-pending" style="background:#fff3e0;color:#b9770e;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;">Pending Clearance</span>`
              : `<span class="status-badge-inactive" style="background:#fdecec;color:#c0392b;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;">Inactive</span>`;

            const rows = [
              ["Employee ID", escapeHtml(emp.empId)],
              ["Profile", escapeHtml(emp.empProfile)],
              ["Location", escapeHtml(emp.empLoc)],
              ["Reason", escapeHtml(emp.empInactiveReason) || "—"],
            ];
            if (pendingAssets.length) rows.push(["Assets Not Surrendered", escapeHtml(pendingAssets.join(", "))]);
            if (emp.loanBalance > 0) rows.push(["Loan Balance", `₹${Number(emp.loanBalance).toLocaleString("en-IN")}`]);
            if (emp.advanceBalance > 0) rows.push(["Advance Balance", `₹${Number(emp.advanceBalance).toLocaleString("en-IN")}`]);

            return `
              <div class="inactive-log-card">
                <div class="inactive-log-card-head">
                  <h3>${escapeHtml(emp.empName) || "—"}</h3>
                  ${statusBadge}
                </div>
                ${rows.map(([label, value]) => `<div class="view-row"><span>${label}</span><span>${value}</span></div>`).join("")}
              </div>
            `;
          })
          .join("");
      }

      function openInactiveLogDialog() {
        renderInactiveLog();
        const d = document.getElementById("inactiveLogDialog");
        d.classList.add("show");
        d.setAttribute("aria-hidden", "false");
      }
      function closeInactiveLogDialog() {
        const d = document.getElementById("inactiveLogDialog");
        d.classList.remove("show");
        d.setAttribute("aria-hidden", "true");
      }
      document.getElementById("inactive-log-btn").addEventListener("click", openInactiveLogDialog);
      document.getElementById("inactiveLogDialog").addEventListener("click", function (e) {
        if (e.target === this) closeInactiveLogDialog();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && document.getElementById("inactiveLogDialog").classList.contains("show")) {
          closeInactiveLogDialog();
        }
      });
  </script>
  <!-- IMAGE PREVIEW MODAL -->
  <div
    id="imgModal"
    style="
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      justify-content: center;
      align-items: center;
      z-index: 9999;
    "
    onclick="closeImgModal()"
  >
    <img
      id="imgModalSrc"
      style="
        max-width: 90%;
        max-height: 90%;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        background: #fff;
      "
    />
  </div>

  <script>
    function openImgModal(src) {
      document.getElementById("imgModalSrc").src = src;
      document.getElementById("imgModal").style.display = "flex";
    }

    function closeImgModal() {
      document.getElementById("imgModal").style.display = "none";
    }
  </script>
</body>
